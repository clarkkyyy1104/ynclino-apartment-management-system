{
  "_comment": "Copy this file to 'appsettings.Local.json' (same folder) and put YOUR OWN local MySQL password below. appsettings.Local.json is git-ignored, so your password is never committed. The database name comes from appsettings.json (which differs per branch), so this one file works on every branch.",
  "MySqlPassword": "YOUR_MYSQL_PASSWORD"
}
