@model YnclinoApartmentManagementSystem.Models.tblUser?
@{
    ViewData["Title"] = "My Profile";
}

@if (Model == null)
{
    <div>
        <div>Your account could not be loaded.</div>
    </div>
    return;
}

@{
    var initial = Model.Username.Length > 0 ? Model.Username[0].ToString().ToUpper() : "A";
    var roleLabel = Model.IsMainAdmin ? "Main Administrator" : "Administrator";
}

<!-- Identity header -->
<div>
    <div></div>
    <div>
        <div>
            <div>
                @initial
            </div>
            <div>
                <h4>@Model.Username</h4>
                <span>@roleLabel</span>
            </div>
            <div>
                <a asp-controller="Account" asp-action="ChangePassword">Change Password</a>
            </div>
        </div>
    </div>
</div>

<div>
    <!-- Account details -->
    <div>
        <div>
            <div>
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/>
                </svg>
                <span>Account Information</span>
            </div>
            <div>
                <dl>
                    <dt>Username</dt><dd>@Model.Username</dd>
                    <dt>Role</dt><dd>@roleLabel</dd>
                    <dt>Status</dt>
                    <dd><span>@(Model.IsActive ? "Active" : "Inactive")</span></dd>
                    <dt>Member Since</dt><dd>@Model.DateCreated.ToString("MMMM dd, yyyy")</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Quick overview -->
    <div>
        <div>
            <div>
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M0 0h1v15h15v1H0zm14.817 3.113a.5.5 0 0 1 .07.704l-4.5 5.5a.5.5 0 0 1-.74.037L7.06 6.767l-3.656 5.027a.5.5 0 0 1-.808-.588l4-5.5a.5.5 0 0 1 .758-.06l2.609 2.61 4.15-5.073a.5.5 0 0 1 .704-.07"/>
                </svg>
                <span>At a Glance</span>
            </div>
            <div>
                <div>
                    <div>
                        <a asp-controller="Units" asp-action="Index">
                            <div>@ViewBag.TotalUnits</div>
                            <div>Units</div>
                        </a>
                    </div>
                    <div>
                        <a asp-controller="Tenants" asp-action="Index">
                            <div>@ViewBag.ActiveTenants</div>
                            <div>Active Tenants</div>
                        </a>
                    </div>
                    <div>
                        <a asp-controller="Transfers" asp-action="Index">
                            <div>@ViewBag.PendingTransfers</div>
                            <div>Pending Requests</div>
                        </a>
                    </div>
                    <div>
                        <div>
                            <div>@ViewBag.AdminCount</div>
                            <div>Admins</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
