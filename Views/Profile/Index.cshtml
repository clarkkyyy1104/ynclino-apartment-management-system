@model YnclinoApartmentManagementSystem.Models.tblTenant?
@using YnclinoApartmentManagementSystem.Models
@{
    ViewData["Title"] = "My Profile";
    var bills = ViewBag.Bills as IEnumerable<tblBilling> ?? Enumerable.Empty<tblBilling>();
    var maintenance = ViewBag.Maintenance as IEnumerable<tblMaintenanceRequest> ?? Enumerable.Empty<tblMaintenanceRequest>();
    var transfers = ViewBag.Transfers as IEnumerable<tblUnitTransferRequest> ?? Enumerable.Empty<tblUnitTransferRequest>();
}

<style>
        .profile-avatar {
            position: relative;
            display: inline-block;
            cursor: pointer;
            line-height: 0;
        }
        .profile-avatar .avatar-overlay {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(0, 0, 0, 0.45);
            opacity: 0;
            transition: opacity 0.15s ease-in-out;
        }
        .profile-avatar:hover .avatar-overlay,
        .profile-avatar:focus-within .avatar-overlay {
            opacity: 1;
        }
        .avatar-overlay-text {
            font-size: 1.6rem;
            line-height: 1;
        }
</style>

@if (Model == null)
{
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            No tenant profile is linked to your account. Please contact the administrator.
        </div>
    </div>
    return;
}

@{
    var initials = $"{(Model.FirstName.Length > 0 ? Model.FirstName[0] : ' ')}{(Model.LastName.Length > 0 ? Model.LastName[0] : ' ')}".Trim();
}

@* Unread unit-request alerts (e.g. "approved") — clicking one marks it read and clears the red badge *@
@await Component.InvokeAsync("ModuleNotifications", new { module = "Transfer" })

<!-- Cover + identity header (Facebook-style) -->
<div class="card mb-3 overflow-hidden">
    <div class="bg-dark" style="height:120px;"></div>
    <div class="card-body">
        <div class="d-flex align-items-end flex-wrap" style="margin-top:-64px;">
            <form asp-action="UploadPhoto" method="post" enctype="multipart/form-data" id="photoForm">
                @Html.AntiForgeryToken()
                <input type="file" name="photo" accept="image/*" id="photoInput" class="d-none"
                       onchange="document.getElementById('photoForm').submit();" />
                <label for="photoInput" class="profile-avatar" role="button"
                       title="@(string.IsNullOrEmpty(Model.PhotoPath) ? "Add a profile photo" : "Change your profile photo")">
                    @if (!string.IsNullOrEmpty(Model.PhotoPath))
                    {
                        <img src="@Model.PhotoPath" alt="Profile photo"
                             class="rounded-circle border border-3 border-white"
                             style="width:96px;height:96px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center border border-3 border-white"
                             style="width:96px;height:96px;font-size:2rem;font-weight:600;">
                            @initials.ToUpper()
                        </div>
                    }
                    <span class="avatar-overlay rounded-circle">
                        <span class="avatar-overlay-text">📷</span>
                    </span>
                </label>
            </form>
            <div class="ms-3 pb-1">
                <h4 class="fw-bold mb-0">@Model.FullName</h4>
                <div class="text-muted small">
                    Unit @(Model.Unit?.UnitNumber ?? "—")
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.PhotoPath))
            {
                <div class="ms-auto pb-1">
                    <form asp-action="RemovePhoto" method="post" onsubmit="return confirm('Remove your profile photo?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove Photo</button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Left column: About -->
    <div class="col-lg-5">
        <div class="card mb-3">
            <div class="card-header fw-semibold">Personal Information</div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-5">Full Name</dt><dd class="col-7">@Model.FullName</dd>
                    <dt class="col-5">Contact No.</dt><dd class="col-7">@(string.IsNullOrEmpty(Model.ContactNumber) ? "—" : Model.ContactNumber)</dd>
                    <dt class="col-5">Emergency Contact</dt>
                    <dd class="col-7">
                        @if (string.IsNullOrEmpty(Model.EmergencyContactName)) { <text>—</text> }
                        else
                        {
                            @Model.EmergencyContactName
                            @if (!string.IsNullOrEmpty(Model.EmergencyContactRelationship)) { <text> (@Model.EmergencyContactRelationship)</text> }
                            @if (!string.IsNullOrEmpty(Model.EmergencyContactNumber)) { <text> — @Model.EmergencyContactNumber</text> }
                        }
                    </dd>
                    <dt class="col-5">Login</dt><dd class="col-7">@(Model.User?.Username ?? "—")</dd>
                </dl>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header fw-semibold">Unit Information</div>
            <div class="card-body">
                @if (Model.Unit != null)
                {
                    <dl class="row mb-0 small">
                        <dt class="col-5">Unit Number</dt><dd class="col-7 fw-semibold">@Model.Unit.UnitNumber</dd>
                        <dt class="col-5">Unit Type</dt><dd class="col-7">@Model.Unit.UnitType</dd>
                        <dt class="col-5">Monthly Rent</dt><dd class="col-7">₱@Model.Unit.RentPrice.ToString("N0")</dd>
                        <dt class="col-5">Capacity</dt><dd class="col-7">@Model.Unit.Capacity person(s)</dd>
                    </dl>
                    <div class="mt-3 d-flex gap-2 flex-wrap">
                        <a asp-controller="Transfers" asp-action="Create" class="btn btn-sm btn-outline-primary">Request Transfer</a>
                        <a asp-controller="Transfers" asp-action="Index" class="btn btn-sm btn-outline-secondary">My Transfer Requests @await Component.InvokeAsync("NavAlert", new { module = "Transfer" })</a>
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-2">You don't have a unit yet.</p>
                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-controller="Transfers" asp-action="Create" class="btn btn-sm btn-primary">Apply for a Unit</a>
                        <a asp-controller="Transfers" asp-action="Index" class="btn btn-sm btn-outline-secondary">My Requests @await Component.InvokeAsync("NavAlert", new { module = "Transfer" })</a>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header fw-semibold">Tenancy</div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-5">Move-In Date</dt><dd class="col-7">@(Model.MoveInDate?.ToString("MMM dd, yyyy") ?? "—")</dd>
                    <dt class="col-5">Date Recorded</dt><dd class="col-7">@Model.DateRecorded.ToString("MMM dd, yyyy")</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Right column: Activity feed -->
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header fw-semibold">Recent Activity</div>
            <div class="list-group list-group-flush">
                @if (!bills.Any() && !maintenance.Any() && !transfers.Any())
                {
                    <div class="list-group-item text-center text-muted py-4">No recent activity.</div>
                }
                @foreach (var b in bills)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge bg-secondary me-2">Billing</span>
                            Bill for @b.BillingPeriod.ToString("MMMM yyyy") — ₱@b.AmountDue.ToString("N0")
                        </div>
                        <span class="badge @(b.Status == "Paid" ? "bg-success" : b.Status == "Partial" ? "bg-info text-dark" : b.Status == "Overdue" ? "bg-danger" : "bg-warning text-dark")">@b.Status</span>
                    </div>
                }
                @foreach (var m in maintenance)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge bg-secondary me-2">Maintenance</span>
                            @m.Category — @m.DateSubmitted.ToString("MMM dd, yyyy")
                        </div>
                        <span class="badge bg-light text-dark border">@m.Status</span>
                    </div>
                }
                @foreach (var r in transfers)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge bg-secondary me-2">Transfer</span>
                            Requested Unit @(r.RequestedUnit?.UnitNumber ?? "—") — @r.DateRequested.ToString("MMM dd, yyyy")
                        </div>
                        <span class="badge @(r.Status == "Approved" ? "bg-success" : r.Status == "Rejected" ? "bg-danger" : r.Status == "Cancelled" ? "bg-secondary" : "bg-warning text-dark")">@r.Status</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
