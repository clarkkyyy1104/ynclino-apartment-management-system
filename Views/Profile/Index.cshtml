@model YnclinoApartmentManagementSystem.Models.tblTenant?
@using YnclinoApartmentManagementSystem.Models
@{
    ViewData["Title"] = "My Profile";
    var bills = ViewBag.Bills as IEnumerable<tblBilling> ?? Enumerable.Empty<tblBilling>();
    var maintenance = ViewBag.Maintenance as IEnumerable<tblMaintenanceRequest> ?? Enumerable.Empty<tblMaintenanceRequest>();
    var transfers = ViewBag.Transfers as IEnumerable<tblUnitTransferRequest> ?? Enumerable.Empty<tblUnitTransferRequest>();
}

@if (Model == null)
{
    <div>
        <div>
            No tenant profile is linked to your account. Please contact the administrator.
        </div>
    </div>
    return;
}

@{
    var initials = $"{(Model.FirstName.Length > 0 ? Model.FirstName[0] : ' ')}{(Model.LastName.Length > 0 ? Model.LastName[0] : ' ')}".Trim();
}

@* Unread unit-request alerts (e.g. "approved") — clicking one marks it read and clears the red badge *@
@await Component.InvokeAsync("ModuleNotifications", new { module = "Transfer" })

<!-- Cover + identity header (Facebook-style) -->
<div>
    <div></div>
    <div>
        <div>
            <form asp-action="UploadPhoto" method="post" enctype="multipart/form-data" id="photoForm">
                @Html.AntiForgeryToken()
                <input type="file" name="photo" accept="image/*" id="photoInput"
                       onchange="document.getElementById('photoForm').submit();" />
                <label for="photoInput" role="button"
                       title="@(string.IsNullOrEmpty(Model.PhotoPath) ? "Add a profile photo" : "Change your profile photo")">
                    @if (!string.IsNullOrEmpty(Model.PhotoPath))
                    {
                        <img src="@Model.PhotoPath" alt="Profile photo" />
                    }
                    else
                    {
                        <div>
                            @initials.ToUpper()
                        </div>
                    }
                    <span>
                        <span>📷</span>
                    </span>
                </label>
            </form>
            <div>
                <h4>@Model.FullName</h4>
                <div>
                    Unit @(Model.Unit?.UnitNumber ?? "—")
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.PhotoPath))
            {
                <div>
                    <form asp-action="RemovePhoto" method="post" onsubmit="return confirm('Remove your profile photo?');">
                        @Html.AntiForgeryToken()
                        <button type="submit">Remove Photo</button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>

<div>
    <!-- Left column: About -->
    <div>
        <div>
            <div>Personal Information</div>
            <div>
                <dl>
                    <dt>Full Name</dt><dd>@Model.FullName</dd>
                    <dt>Contact No.</dt><dd>@(string.IsNullOrEmpty(Model.ContactNumber) ? "—" : Model.ContactNumber)</dd>
                    <dt>Emergency Contact</dt>
                    <dd>
                        @if (string.IsNullOrEmpty(Model.EmergencyContactName)) { <text>—</text> }
                        else
                        {
                            @Model.EmergencyContactName
                            @if (!string.IsNullOrEmpty(Model.EmergencyContactRelationship)) { <text> (@Model.EmergencyContactRelationship)</text> }
                            @if (!string.IsNullOrEmpty(Model.EmergencyContactNumber)) { <text> — @Model.EmergencyContactNumber</text> }
                        }
                    </dd>
                    <dt>Login</dt><dd>@(Model.User?.Username ?? "—")</dd>
                </dl>
            </div>
        </div>

        <div>
            <div>Unit Information</div>
            <div>
                @if (Model.Unit != null)
                {
                    <dl>
                        <dt>Unit Number</dt><dd>@Model.Unit.UnitNumber</dd>
                        <dt>Unit Type</dt><dd>@Model.Unit.UnitType</dd>
                        <dt>Monthly Rent</dt><dd>₱@Model.Unit.RentPrice.ToString("N0")</dd>
                        <dt>Capacity</dt><dd>@Model.Unit.Capacity person(s)</dd>
                    </dl>
                    <div>
                        <a asp-controller="Transfers" asp-action="Create">Request Transfer</a>
                        <a asp-controller="Transfers" asp-action="Index">My Transfer Requests @await Component.InvokeAsync("NavAlert", new { module = "Transfer" })</a>
                    </div>
                }
                else
                {
                    <p>You don't have a unit yet.</p>
                    <div>
                        <a asp-controller="Transfers" asp-action="Create">Apply for a Unit</a>
                        <a asp-controller="Transfers" asp-action="Index">My Requests @await Component.InvokeAsync("NavAlert", new { module = "Transfer" })</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right column: Activity feed -->
    <div>
        <div>
            <div>Recent Activity</div>
            <div>
                @if (!bills.Any() && !maintenance.Any() && !transfers.Any())
                {
                    <div>No recent activity.</div>
                }
                @foreach (var b in bills)
                {
                    <div>
                        <div>
                            <span>Billing</span>
                            Bill for @b.BillingPeriod.ToString("MMMM yyyy") — ₱@b.AmountDue.ToString("N0")
                        </div>
                        <span>@b.Status</span>
                    </div>
                }
                @foreach (var m in maintenance)
                {
                    <div>
                        <div>
                            <span>Maintenance</span>
                            @m.Category — @m.DateSubmitted.ToString("MMM dd, yyyy")
                        </div>
                        <span>@m.Status</span>
                    </div>
                }
                @foreach (var r in transfers)
                {
                    <div>
                        <div>
                            <span>Transfer</span>
                            Requested Unit @(r.RequestedUnit?.UnitNumber ?? "—") — @r.DateRequested.ToString("MMM dd, yyyy")
                        </div>
                        <span>@r.Status</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
