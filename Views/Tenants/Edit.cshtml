@model YnclinoApartmentManagementSystem.Models.ViewModels.TenantViewModel
@{
    ViewData["Title"] = "Edit Tenant";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-secondary text-white fw-semibold">Edit Tenant — @Model.FullName</div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="TenantID" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label fw-semibold small"></label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label fw-semibold small"></label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="ContactNumber" class="form-label fw-semibold small"></label>
                            <input asp-for="ContactNumber" class="form-control" inputmode="numeric" placeholder="e.g. 09171234567" oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                            <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MoveInDate" class="form-label fw-semibold small"></label>
                            <input asp-for="MoveInDate" type="date" class="form-control" />
                            <span asp-validation-for="MoveInDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <label class="form-label fw-semibold small">Emergency Contact</label>
                    <div class="row mb-3">
                        <div class="col-md-5">
                            <input asp-for="EmergencyContactName" class="form-control" placeholder="Full name" />
                            <span asp-validation-for="EmergencyContactName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <select asp-for="EmergencyContactRelationship" class="form-select">
                                <option value="">Relationship…</option>
                                <option>Parent</option>
                                <option>Spouse</option>
                                <option>Sibling</option>
                                <option>Child</option>
                                <option>Relative</option>
                                <option>Friend</option>
                                <option>Guardian</option>
                                <option>Other</option>
                            </select>
                            <span asp-validation-for="EmergencyContactRelationship" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <input asp-for="EmergencyContactNumber" class="form-control" inputmode="numeric" placeholder="e.g. 09181234567" oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                            <span asp-validation-for="EmergencyContactNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Status" class="form-label fw-semibold small"></label>
                        <select asp-for="Status" class="form-select">
                            <option>Active</option>
                            <option>Inactive</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm">Save Changes</button>
                        <a asp-action="Index" class="btn btn-secondary btn-sm">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
