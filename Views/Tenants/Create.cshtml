@model YnclinoApartmentManagementSystem.Models.ViewModels.TenantViewModel
@{
    ViewData["Title"] = "Register Tenant";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white fw-semibold">Register New Tenant</div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="row mb-3">
                        <div class="col-md-7">
                            <label asp-for="Name" class="form-label fw-semibold small"></label>
                            <input asp-for="Name" class="form-control" placeholder="Tenant name" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="MonthlyRent" class="form-label fw-semibold small"></label>
                            <div class="input-group">
                                <span class="input-group-text">₱</span>
                                <input asp-for="MonthlyRent" type="number" min="0" step="0.01" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="MonthlyRent" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="ContactNumber" class="form-label fw-semibold small"></label>
                            <input asp-for="ContactNumber" class="form-control" inputmode="numeric" minlength="11" maxlength="11" placeholder="e.g. 09123456789" oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                            <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MoveInDate" class="form-label fw-semibold small"></label>
                            <input asp-for="MoveInDate" type="date" class="form-control" />
                            <span asp-validation-for="MoveInDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="contact-box mb-4">
                        <label class="form-label fw-semibold small">Emergency Contact</label>
                        <div class="row g-2">
                            <div class="col-md-5">
                                <input asp-for="EmergencyContactName" class="form-control" placeholder="Full name" />
                                <span asp-validation-for="EmergencyContactName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <select asp-for="EmergencyContactRelationship" class="form-select">
                                    <option value="">Relationship…</option>
                                    <option>Parent</option>
                                    <option>Spouse</option>
                                    <option>Sibling</option>
                                    <option>Child</option>
                                    <option>Relative</option>
                                    <option>Friend</option>
                                    <option>Guardian</option>
                                    <option>Other</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <input asp-for="EmergencyContactNumber" class="form-control" inputmode="numeric" minlength="11" maxlength="11" placeholder="e.g. 09181234567" oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                                <span asp-validation-for="EmergencyContactNumber" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm">Register Tenant</button>
                        <a asp-action="Index" class="btn btn-secondary btn-sm">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
