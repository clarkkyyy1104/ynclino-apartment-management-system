@model YnclinoApartmentManagementSystem.Models.ViewModels.TenantViewModel
@{
    ViewData["Title"] = "Register Tenant";
}

<div>
    <div>
        <div data-form-panel>
            <div data-form-head>Register New Tenant</div>
            <div data-form-body>
                <form asp-action="Create" method="post" id="tenantForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly"></div>

                    <h6>Tenant Profile</h6>

                    <div>
                        <div>
                            <label asp-for="FirstName"></label>
                            <input asp-for="FirstName" id="firstNameInput" placeholder="First name" />
                            <span asp-validation-for="FirstName"></span>
                        </div>
                        <div>
                            <label asp-for="LastName"></label>
                            <input asp-for="LastName" id="lastNameInput" placeholder="Last name" />
                            <span asp-validation-for="LastName"></span>
                        </div>
                    </div>

                    <div>
                        <label asp-for="UnitID"></label>
                        <select asp-for="UnitID" asp-items="Model.AvailableUnits">
                            <option value="">— Select Unit —</option>
                        </select>
                        <span asp-validation-for="UnitID"></span>
                    </div>

                    <div>
                        <div>
                            <div>
                                <label asp-for="ContactNumber"></label>
                                <input asp-for="ContactNumber" id="contactInput" inputmode="numeric" minlength="11" maxlength="11" placeholder="e.g. 09123456789" oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                                <span asp-validation-for="ContactNumber"></span>
                            </div>
                        </div>
                        <div>
                            <div>
                                <label>Emergency Contact</label>
                                <div>
                                    <input asp-for="EmergencyContactName" placeholder="Full name" />
                                    <span asp-validation-for="EmergencyContactName"></span>
                                </div>
                                <div>
                                    <select asp-for="EmergencyContactRelationship">
                                        <option value="">Relationship…</option>
                                        <option>Parent</option>
                                        <option>Spouse</option>
                                        <option>Sibling</option>
                                        <option>Child</option>
                                        <option>Relative</option>
                                        <option>Friend</option>
                                        <option>Guardian</option>
                                        <option>Other</option>
                                    </select>
                                </div>
                                <div>
                                    <input asp-for="EmergencyContactNumber" inputmode="numeric" minlength="11" maxlength="11" placeholder="e.g. 09181234567" oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                                    <span asp-validation-for="EmergencyContactNumber"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <h6>Login Account</h6>

                    <div>
                        <label>Username <span>(auto-generated)</span></label>
                        <input type="text" id="usernameDisplay" readonly
                               value="@($"{DateTime.Now:yy}-{DateTime.Now:MM}")" />
                        <input asp-for="Username" type="hidden" id="usernameHidden" />
                        <div>Assigned as year-month + name initials &nbsp;(e.g. <em>26-07AC</em>).</div>
                        <span asp-validation-for="Username"></span>
                    </div>

                    <div>
                        <label asp-for="Password"></label>
                        <div>
                            <input asp-for="Password" id="pw" autocomplete="new-password" oninput="checkStrength(this.value)" />
                            <button type="button" onclick="togglePw('pw')" tabindex="-1">
                                @Html.Raw(EyeIcon("pw"))
                            </button>
                        </div>
                        <div>Auto-filled from Contact Number + name initials. You can change it.</div>
                        <span asp-validation-for="Password"></span>
                    </div>

                    <ul id="pwRules">
                        <li id="r-len"><span></span> At least 8 characters</li>
                        <li id="r-upper"><span></span> At least one uppercase letter</li>
                        <li id="r-lower"><span></span> At least one lowercase letter</li>
                        <li id="r-digit"><span></span> At least one number</li>
                        <li id="r-special"><span></span> At least one special character (!&#64;#$%^&amp;*)</li>
                    </ul>

                    <div>
                        <label asp-for="ConfirmPassword"></label>
                        <div>
                            <input asp-for="ConfirmPassword" id="cpw" autocomplete="new-password" />
                            <button type="button" onclick="togglePw('cpw')" tabindex="-1">
                                @Html.Raw(EyeIcon("cpw"))
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword"></span>
                    </div>

                    <div>
                        <button type="submit">Register Tenant</button>
                        <a asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/password.js" asp-append-version="true"></script>
    <script>
        // preview the username: year-month + the name initials
        var usernameBase = '@($"{DateTime.Now:yy}-{DateTime.Now:MM}")';
        function updateUsername() {
            var fn = document.getElementById('firstNameInput').value.trim();
            var ln = document.getElementById('lastNameInput').value.trim();
            var initials = (fn ? fn[0].toUpperCase() : '') + (ln ? ln[0].toUpperCase() : '');
            document.getElementById('usernameDisplay').value = usernameBase + initials;
            document.getElementById('usernameHidden').value = usernameBase + initials;
        }
        document.getElementById('firstNameInput').addEventListener('input', updateUsername);
        document.getElementById('lastNameInput').addEventListener('input', updateUsername);

        // auto-generate a password from the name + contact
        var pwAutoGenerated = '';
        function generatePassword() {
            var fn = document.getElementById('firstNameInput').value.trim();
            var ln = document.getElementById('lastNameInput').value.trim();
            var contact = document.getElementById('contactInput').value.trim();
            if (fn && ln && contact) {
                return contact + '@@' + fn[0].toUpperCase() + ln[0].toLowerCase();
            }
            return '';
        }
        function updatePassword() {
            var pwField = document.getElementById('pw');
            var cpwField = document.getElementById('cpw');
            var gen = generatePassword();
            if (!gen) return;
            // only overwrite if it's empty or still the value we generated
            if (pwField.value === '' || pwField.value === pwAutoGenerated) {
                pwAutoGenerated = gen;
                pwField.value = gen;
                cpwField.value = gen;
                checkStrength(gen);
            }
        }
        document.getElementById('firstNameInput').addEventListener('input', updatePassword);
        document.getElementById('lastNameInput').addEventListener('input', updatePassword);
        document.getElementById('contactInput').addEventListener('input', updatePassword);

        document.getElementById('tenantForm').addEventListener('submit', function (e) {
            var pw = document.getElementById('pw').value;
            if (!meetsAllRules(pw)) {
                e.preventDefault();
                document.getElementById('pwRules').classList.add('shake');
                setTimeout(() => document.getElementById('pwRules').classList.remove('shake'), 600);
            }
        });
    </script>
}

@functions {
    string EyeIcon(string id) => $@"
        <svg id=""{id}-eye"" xmlns=""http://www.w3.org/2000/svg"" width=""18"" height=""18"" fill=""currentColor"" viewBox=""0 0 16 16"">
            <path d=""M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z""/>
            <path d=""M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0""/>
        </svg>
        <svg id=""{id}-eye-slash"" xmlns=""http://www.w3.org/2000/svg"" width=""18"" height=""18"" fill=""currentColor"" viewBox=""0 0 16 16"" style=""display:none"">
            <path d=""M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7 7 0 0 0-2.79.588l.77.771A6 6 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755q-.247.248-.517.486z""/>
            <path d=""M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829z""/>
            <path d=""M3.35 5.47q-.27.24-.518.487A13 13 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7 7 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12z""/>
        </svg>";
}
