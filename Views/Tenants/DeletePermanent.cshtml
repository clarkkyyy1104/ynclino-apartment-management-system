@model YnclinoApartmentManagementSystem.Models.tblTenant
@{
    ViewData["Title"] = "Delete Tenant Permanently";
    int lostFound = (int)(ViewBag.LostFoundCount ?? 0);
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white fw-semibold">
                Delete @Model.FullName permanently
            </div>
            <div class="card-body">

                <p class="mb-3">
                    This removes the tenant, their login, and every record listed below
                    from the database. <strong>It cannot be undone.</strong> If you only
                    want them out of the active list, go back and archive them instead —
                    an archived tenant keeps their history.
                </p>

                <dl class="row info-list small mb-3">
                    <dt class="col-sm-4">Tenant</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.FullName</dd>

                    <dt class="col-sm-4">Login Account</dt>
                    <dd class="col-sm-8">@(Model.User?.Username ?? "No account")</dd>

                    <dt class="col-sm-4">Unit</dt>
                    <dd class="col-sm-8">@(Model.Unit?.UnitNumber ?? "—")</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-secondary">@Model.Status</span>
                    </dd>
                </dl>

                <div class="border rounded p-3 mb-3 bg-light">
                    <div class="fw-semibold small mb-2">What will be deleted with them</div>
                    <ul class="small mb-0">
                        <li>@ViewBag.BillCount bill(s)</li>
                        <li>@ViewBag.PaymentCount payment record(s)</li>
                        <li>@ViewBag.MaintenanceCount maintenance request(s)</li>
                        <li>@ViewBag.TransferCount unit request(s)</li>
                        <li>@ViewBag.NotificationCount notification(s)</li>
                    </ul>
                </div>

                @if (lostFound > 0)
                {
                    @* Lost & Found belongs to the shared board, not to this tenant, so
                       it is never silently destroyed — the admin clears it deliberately. *@
                    <div class="alert alert-warning py-2 small">
                        <strong>Blocked.</strong> This tenant has @lostFound Lost &amp; Found
                        record(s). Those belong to the shared board and are not deleted here.
                        Remove the items in the
                        <a asp-controller="LostFound" asp-action="Index">Lost &amp; Found</a>
                        module first, or leave this tenant archived.
                    </div>
                }

                <div class="d-flex gap-2">
                    @if (lostFound == 0)
                    {
                        <form asp-action="DeletePermanent" asp-route-id="@Model.TenantID" method="post" class="d-inline"
                              onsubmit="return confirm('Permanently delete @Model.FullName and every record listed? This cannot be undone.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm">Delete permanently</button>
                        </form>
                    }
                    <a asp-action="Details" asp-route-id="@Model.TenantID" class="btn btn-secondary btn-sm">Cancel</a>
                </div>
            </div>
        </div>
    </div>
</div>
