@model IEnumerable<YnclinoApartmentManagementSystem.Models.tblTenant>
@{
    ViewData["Title"] = "Tenants";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold mb-0">Tenants</h3>
    <a asp-action="Create" class="btn btn-primary">+ Register Tenant</a>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-auto">
        <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" style="width:229px"
               placeholder="Search by name…" />
    </div>
    <div class="col-auto">
        <select name="statusFilter" class="form-select" style="width:229px" onchange="this.form.submit()">
            <option value="Active" selected="@(ViewBag.StatusFilter == "Active")">Active</option>
            <option value="Inactive" selected="@(ViewBag.StatusFilter == "Inactive")">Inactive</option>
            <option value="All" selected="@(ViewBag.StatusFilter == "All")">All</option>
        </select>
    </div>
    <div class="col-auto">
        <a asp-action="Index" class="btn btn-link">Clear</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-primary">
            <tr>
                <th>Name</th>
                <th>Monthly Rent</th>
                <th>Contact</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tenant in Model)
            {
                <tr>
                    <td class="fw-semibold">@tenant.Name</td>
                    <td>₱@tenant.MonthlyRent.ToString("N2")</td>
                    <td>@(tenant.ContactNumber ?? "—")</td>
                    <td>
                        <span class="badge @(tenant.Status == "Active" ? "bg-success" : "bg-secondary")">
                            @tenant.Status
                        </span>
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@tenant.TenantID" class="btn btn-sm btn-outline-info">Details</a>
                        <a asp-action="Edit" asp-route-id="@tenant.TenantID" class="btn btn-sm btn-outline-primary">Edit</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">No tenants found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
