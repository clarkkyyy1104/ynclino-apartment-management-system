@model YnclinoApartmentManagementSystem.Models.tblTenant
@{
    ViewData["Title"] = "Archive Tenant";
}

<div data-modal-source data-confirm>
    <div data-panel>
        <div data-panel-head>Confirm Archive</div>
        <div data-panel-body>
            <p>Are you sure you want to archive <strong>@Model.FullName</strong>?</p>
            <p data-footnote>
                Archiving keeps their billing and maintenance history, sets them to Inactive
                and switches their login off. To remove them from the database entirely,
                archive them first, then use Delete Permanently.
            </p>
            <form asp-action="Delete" method="post">
                <input type="hidden" name="id" value="@Model.TenantID" />
                <div data-actions-row>
                    <button type="submit" data-danger>Yes, Archive</button>
                    <a asp-action="Index">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
