@model YnclinoApartmentManagementSystem.Models.tblTenant
@{
    ViewData["Title"] = Model.FullName;
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white fw-semibold">Tenant Details — @Model.FullName</div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.PhotoPath))
                {
                    <div class="text-center mb-3">
                        <a href="@Model.PhotoPath" target="_blank">
                            <img src="@Model.PhotoPath" alt="Tenant photo"
                                 class="rounded-circle border" style="width:110px;height:110px;object-fit:cover;" />
                        </a>
                    </div>
                }
                <dl class="row">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4">Monthly Rent</dt>
                    <dd class="col-sm-8">₱@Model.MonthlyRent.ToString("N2")</dd>

                    <dt class="col-sm-4">Contact Number</dt>
                    <dd class="col-sm-8">@(Model.ContactNumber ?? "—")</dd>

                    <dt class="col-sm-4">Emergency Contact</dt>
                    <dd class="col-sm-8">
                        @if (string.IsNullOrEmpty(Model.EmergencyContactName))
                        {
                            <text>—</text>
                        }
                        else
                        {
                            @Model.EmergencyContactName
                            @if (!string.IsNullOrEmpty(Model.EmergencyContactRelationship))
                            {
                                <text> (@Model.EmergencyContactRelationship)</text>
                            }
                            @if (!string.IsNullOrEmpty(Model.EmergencyContactNumber))
                            {
                                <text> — @Model.EmergencyContactNumber</text>
                            }
                        }
                    </dd>

                    @if (Model.MoveOutDate.HasValue)
                    {
                        <dt class="col-sm-4">Move-Out Date</dt>
                        <dd class="col-sm-8">@Model.MoveOutDate.Value.ToString("MMMM dd, yyyy")</dd>
                    }

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        <span class="badge @(Model.Status == "Active" ? "bg-success" : "bg-secondary")">
                            @Model.Status
                        </span>
                    </dd>

                    @if (Model.MoveInDate.HasValue)
                    {
                        <dt class="col-sm-4">Move-In Date</dt>
                        <dd class="col-sm-8">@Model.MoveInDate.Value.ToString("MMMM dd, yyyy")</dd>
                    }

                    <dt class="col-sm-4">Date Recorded</dt>
                    <dd class="col-sm-8">@Model.DateRecorded.ToString("MMMM dd, yyyy")</dd>
                </dl>
            </div>
            @if (User.IsInRole("Admin"))
            {
                <div class="card-footer d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.TenantID" class="btn btn-primary btn-sm">Edit</a>
                    @if (Model.Status == "Active")
                    {
                        <form asp-action="Delete" asp-route-id="@Model.TenantID" method="post" class="d-inline"
                              onsubmit="return confirm('Deactivate this tenant?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">Deactivate</button>
                        </form>
                    }
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to List</a>
                </div>
            }
        </div>
    </div>
</div>
