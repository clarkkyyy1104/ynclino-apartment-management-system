@model YnclinoApartmentManagementSystem.Models.tblTenant
@{
    ViewData["Title"] = Model.FullName;
}

<div>
    <div>
        <div data-panel>
            <div data-panel-head>Tenant Details — @Model.FullName</div>
            <div data-panel-body>
                @if (!string.IsNullOrEmpty(Model.PhotoPath))
                {
                    <div>
                        <a href="@Model.PhotoPath" target="_blank">
                            <img src="@Model.PhotoPath" alt="Tenant photo" />
                        </a>
                    </div>
                }
                <dl>
                    <dt>Full Name</dt>
                    <dd>@Model.LastName, @Model.FirstName</dd>

                    <dt>Unit</dt>
                    <dd>@(Model.Unit?.UnitNumber ?? "—") (@(Model.Unit?.UnitType ?? "—"))</dd>

                    <dt>Rent Price</dt>
                    <dd>₱@(Model.Unit?.RentPrice.ToString("N0") ?? "—")</dd>

                    <dt>Contact Number</dt>
                    <dd>@(Model.ContactNumber ?? "—")</dd>

                    <dt>Emergency Contact</dt>
                    <dd>
                        @if (string.IsNullOrEmpty(Model.EmergencyContactName))
                        {
                            <text>—</text>
                        }
                        else
                        {
                            @Model.EmergencyContactName
                            @if (!string.IsNullOrEmpty(Model.EmergencyContactRelationship))
                            {
                                <text> (@Model.EmergencyContactRelationship)</text>
                            }
                            @if (!string.IsNullOrEmpty(Model.EmergencyContactNumber))
                            {
                                <text> — @Model.EmergencyContactNumber</text>
                            }
                        }
                    </dd>

                    @if (Model.MoveOutDate.HasValue)
                    {
                        <dt>Move-Out Date</dt>
                        <dd>@Model.MoveOutDate.Value.ToString("MMMM dd, yyyy")</dd>
                    }

                    <dt>Status</dt>
                    <dd>
                        <span>
                            @Model.Status
                        </span>
                    </dd>

                    <dt>Login Account</dt>
                    <dd>
                        @if (Model.User != null)
                        {
                            @Model.User.Username
                        }
                        else
                        {
                            <span>No account</span>
                        }
                    </dd>

                    <dt>Date Recorded</dt>
                    <dd>@Model.DateRecorded.ToString("MMMM dd, yyyy")</dd>
                </dl>
            </div>
            @if (User.IsInRole("Admin"))
            {
                <div data-actions-row>
                    <a asp-action="Edit" asp-route-id="@Model.TenantID">Update</a>

                    @* Archive first, delete second. Archiving keeps the history and is
                       the normal move-out; permanent deletion is for records that
                       should never have existed. *@
                    @if (Model.Status == "Active")
                    {
                        <a asp-action="Delete" asp-route-id="@Model.TenantID">Archive</a>
                    }
                    else
                    {
                        <a asp-action="DeletePermanent" asp-route-id="@Model.TenantID">Delete permanently</a>
                    }

                    <a asp-action="Index">Back to List</a>
                </div>
            }
        </div>
    </div>
</div>
