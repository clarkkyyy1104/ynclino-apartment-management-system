@model YnclinoApartmentManagementSystem.Models.tblMaintenanceRequest
@{
    ViewData["Title"] = "Request Details";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white fw-semibold">
                Maintenance Request #@Model.RequestID
            </div>
            <div class="card-body">
                <dl class="row info-list">
                    <dt class="col-sm-4">Tenant</dt>
                    <dd class="col-sm-8">@Model.Tenant?.FullName</dd>

                    <dt class="col-sm-4">Unit</dt>
                    <dd class="col-sm-8">@(Model.Tenant?.Unit?.UnitNumber ?? "—")</dd>

                    <dt class="col-sm-4">Category</dt>
                    <dd class="col-sm-8">@Model.Category</dd>

                    <dt class="col-sm-4">Description</dt>
                    <dd class="col-sm-8">@Model.Description</dd>

                    <dt class="col-sm-4">Priority</dt>
                    <dd class="col-sm-8">
                        @{
                            var pbadge = Model.Priority switch {
                                "High"   => "bg-danger",
                                "Medium" => "bg-warning text-dark",
                                _        => "bg-secondary"
                            };
                        }
                        <span class="badge @pbadge">@Model.Priority</span>
                    </dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @{
                            var sbadge = Model.Status switch {
                                "Resolved"    => "bg-success",
                                "In Progress" => "bg-primary",
                                "Cancelled"   => "bg-secondary",
                                _             => "bg-warning text-dark"
                            };
                        }
                        <span class="badge @sbadge">@Model.Status</span>
                    </dd>

                    <dt class="col-sm-4">Date Submitted</dt>
                    <dd class="col-sm-8">@Model.DateSubmitted.ToString("MMM dd, yyyy hh:mm tt")</dd>

                    <dt class="col-sm-4">Date Resolved</dt>
                    <dd class="col-sm-8">@(Model.DateResolved?.ToString("MMM dd, yyyy") ?? "—")</dd>

                    @if (User.IsInRole("Admin"))
                    {
                        <dt class="col-sm-4">Admin Notes</dt>
                        <dd class="col-sm-8">@(Model.AdminNotes ?? "—")</dd>
                    }
                </dl>

                <div class="d-flex gap-2 mt-3">
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.RequestID" class="btn btn-primary btn-sm">Edit</a>
                    }
                    else if (Model.Status == "Pending")
                    {
                        <form asp-action="Cancel" asp-route-id="@Model.RequestID" method="post" class="d-inline"
                              onsubmit="return confirm('Cancel this request?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">Cancel Request</button>
                        </form>
                    }
                    <a asp-action="Index" class="btn btn-secondary btn-sm">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
