@model YnclinoApartmentManagementSystem.Models.tblMaintenanceRequest
@{
    ViewData["Title"] = "Request Details";
}

<div>
    <div>
        <div>
            <div>
                Maintenance Request #@Model.RequestID
            </div>
            <div>
                <dl>
                    <dt>Tenant</dt>
                    <dd>@Model.Tenant?.FullName</dd>

                    @* the unit stamped on the request itself, so the history stays with
                       the apartment even after the tenant transfers or moves out *@
                    <dt>Unit</dt>
                    <dd>@(Model.Unit?.UnitNumber ?? Model.Tenant?.Unit?.UnitNumber ?? "—")</dd>

                    <dt>Issue Type</dt>
                    <dd>@Model.Category</dd>

                    <dt>Description</dt>
                    <dd>@Model.Description</dd>

                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <dt>Photo</dt>
                        <dd>
                            <a href="@Model.ImagePath" target="_blank">
                                <img src="@Model.ImagePath" alt="Maintenance photo" />
                            </a>
                        </dd>
                    }

                    <dt>Priority</dt>
                    <dd>
                        <span>@Model.Priority</span>
                    </dd>

                    <dt>Status</dt>
                    <dd>
                        <span>@Model.Status</span>
                    </dd>

                    <dt>Date Submitted</dt>
                    <dd>@Model.DateSubmitted.ToString("MMM dd, yyyy hh:mm tt")</dd>

                    <dt>Date Resolved</dt>
                    <dd>@(Model.DateResolved?.ToString("MMM dd, yyyy") ?? "—")</dd>

                    @* The tenant sees this too: knowing who was sent and what they did
                       is the whole point of following up a repair. (Repair cost, the one
                       thing that was private, no longer exists in the system.) *@
                    <dt>Assigned Staff</dt>
                    <dd>
                        @if (Model.AssignedStaff != null)
                        {
                            <span>@Model.AssignedStaff.Username</span>
                        }
                        else
                        {
                            <span>Not yet assigned</span>
                        }
                    </dd>

                    <dt>Work Notes</dt>
                    <dd>
                        @if (string.IsNullOrWhiteSpace(Model.StaffNotes))
                        {
                            <span>No work has been reported yet.</span>
                        }
                        else
                        {
                            @Model.StaffNotes
                        }
                    </dd>
                </dl>

                <div>
                    @* the staff member's one action: report on the job *@
                    @if (User.IsInRole("Maintenance") &&
                         !YnclinoApartmentManagementSystem.Helpers.StatusFlowHelper.IsClosedMaintenance(Model.Status))
                    {
                        <a asp-action="Work" asp-route-id="@Model.RequestID">Update Request</a>
                    }
                    @if (User.IsInRole("Tenant") && Model.Status == "Pending")
                    {
                        <form asp-action="Cancel" asp-route-id="@Model.RequestID" method="post"
                              onsubmit="return confirm('Cancel this request?')">
                            @Html.AntiForgeryToken()
                            <button type="submit">Cancel Request</button>
                        </form>
                    }
                    <a asp-action="Index">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
