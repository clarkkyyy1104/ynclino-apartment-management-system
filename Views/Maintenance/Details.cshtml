@model YnclinoApartmentManagementSystem.Models.tblMaintenanceRequest
@{
    ViewData["Title"] = "Request Details";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white fw-semibold">
                Maintenance Request #@Model.RequestID
            </div>
            <div class="card-body">
                <dl class="row info-list">
                    <dt class="col-sm-4">Tenant</dt>
                    <dd class="col-sm-8">@Model.Tenant?.FullName</dd>

                    @* the unit stamped on the request itself, so the history stays with
                       the apartment even after the tenant transfers or moves out *@
                    <dt class="col-sm-4">Unit</dt>
                    <dd class="col-sm-8">@(Model.Unit?.UnitNumber ?? Model.Tenant?.Unit?.UnitNumber ?? "—")</dd>

                    <dt class="col-sm-4">Issue Type</dt>
                    <dd class="col-sm-8">@Model.Category</dd>

                    <dt class="col-sm-4">Description</dt>
                    <dd class="col-sm-8">@Model.Description</dd>

                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <dt class="col-sm-4">Photo</dt>
                        <dd class="col-sm-8">
                            <a href="@Model.ImagePath" target="_blank">
                                <img src="@Model.ImagePath" alt="Maintenance photo" class="img-fluid rounded border" style="max-height:220px" />
                            </a>
                        </dd>
                    }

                    <dt class="col-sm-4">Priority</dt>
                    <dd class="col-sm-8">
                        @{
                            var pbadge = Model.Priority switch {
                                "Urgent"   => "bg-danger",
                                "Major"    => "bg-warning text-dark",
                                "Moderate" => "bg-info text-dark",
                                _          => "bg-secondary"
                            };
                        }
                        <span class="badge @pbadge">@Model.Priority</span>
                    </dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @{
                            var sbadge = Model.Status switch {
                                "Resolved"    => "bg-success",
                                "In Progress" => "bg-primary",
                                "Cancelled"   => "bg-secondary",
                                _             => "bg-warning text-dark"
                            };
                        }
                        <span class="badge @sbadge">@Model.Status</span>
                    </dd>

                    <dt class="col-sm-4">Date Submitted</dt>
                    <dd class="col-sm-8">@Model.DateSubmitted.ToString("MMM dd, yyyy hh:mm tt")</dd>

                    <dt class="col-sm-4">Date Resolved</dt>
                    <dd class="col-sm-8">@(Model.DateResolved?.ToString("MMM dd, yyyy") ?? "—")</dd>

                    @* the tenant does not need to see who was sent or what it cost *@
                    @if (!User.IsInRole("Tenant"))
                    {
                        <dt class="col-sm-4">Assigned Staff</dt>
                        <dd class="col-sm-8">
                            @if (Model.AssignedStaff != null)
                            {
                                <span class="badge bg-info text-dark">@Model.AssignedStaff.Username</span>
                            }
                            else
                            {
                                <span class="text-muted">Unassigned</span>
                            }
                        </dd>


                        <dt class="col-sm-4">Work Notes</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.StaffNotes) ? "—" : Model.StaffNotes)</dd>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <dt class="col-sm-4">Admin Notes</dt>
                        <dd class="col-sm-8">@(Model.AdminNotes ?? "—")</dd>
                    }
                </dl>

                <div class="d-flex gap-2 mt-3">
                    @* the staff member's one action: report on the job *@
                    @if (User.IsInRole("Maintenance") &&
                         !YnclinoApartmentManagementSystem.Helpers.StatusFlowHelper.IsClosedMaintenance(Model.Status))
                    {
                        <a asp-action="Work" asp-route-id="@Model.RequestID" class="btn btn-primary btn-sm">Update Request</a>
                    }
                    @if (User.IsInRole("Tenant") && Model.Status == "Pending")
                    {
                        <form asp-action="Cancel" asp-route-id="@Model.RequestID" method="post" class="d-inline"
                              onsubmit="return confirm('Cancel this request?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">Cancel Request</button>
                        </form>
                    }
                    <a asp-action="Index" class="btn btn-secondary btn-sm">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
