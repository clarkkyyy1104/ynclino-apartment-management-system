@model YnclinoApartmentManagementSystem.Models.ViewModels.MaintenanceViewModel
@{
    ViewData["Title"] = "New Maintenance Request";
    bool isAdmin = User.IsInRole("Admin");
}

<div>
    <div>
        <div data-form-panel>
            <div data-form-head>New Maintenance Request</div>
            <div data-form-body>
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All"></div>

                    @if (isAdmin)
                    {
                        <div>
                            <label asp-for="TenantID"></label>
                            <select asp-for="TenantID" asp-items="Model.AvailableTenants">
                                <option value="">— Select Tenant —</option>
                            </select>
                            <span asp-validation-for="TenantID"></span>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" asp-for="TenantID" />
                        <div>
                            <span>
                                Submitting as: <strong>@Model.TenantName</strong> — Unit @Model.UnitNumber
                            </span>
                        </div>
                    }

                    <div>
                        <div>
                            <label asp-for="Category"></label>
                            <select asp-for="Category" id="categorySelect" required>
                                <option value="">— Select —</option>
                                <option>Plumbing</option>
                                <option>Electrical</option>
                                <option>Structural</option>
                                <option>Appliance</option>
                                <option>Other</option>
                            </select>
                            <span asp-validation-for="Category"></span>
                        </div>
                        @if (isAdmin)
                        {
                            <div>
                            <label asp-for="Priority"></label>
                            <select asp-for="Priority" required>
                                <option value="">— Select —</option>
                                <option>Minor</option>
                                <option>Moderate</option>
                                <option>Major</option>
                                <option>Urgent</option>
                            </select>
                            <span asp-validation-for="Priority"></span>
                        </div>
                        }
                    </div>

                    <div id="descWrap">
                        <label asp-for="Description"></label>
                        <textarea asp-for="Description" rows="3"
                                  placeholder="Describe the issue in detail…"></textarea>
                        <span asp-validation-for="Description"></span>
                    </div>

                    <div>
                        <label asp-for="ImageUpload"></label>
                        <input asp-for="ImageUpload" type="file" accept="image/*" />
                        <div>Optional — attach a photo of the issue. JPG, PNG, GIF, or WEBP, up to 5 MB.</div>
                        <span asp-validation-for="ImageUpload"></span>
                    </div>

                    <div>
                        <button type="submit">Submit Request</button>
                        <a asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // the description box only matters when the issue type is "Other"
        var catSel = document.getElementById('categorySelect');
        var descWrap = document.getElementById('descWrap');
        function toggleDesc() {
            descWrap.style.display = (catSel.value === 'Other') ? '' : 'none';
        }
        catSel.addEventListener('change', toggleDesc);
        toggleDesc();
    </script>
}
