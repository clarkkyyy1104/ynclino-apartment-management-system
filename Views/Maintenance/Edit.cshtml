@model YnclinoApartmentManagementSystem.Models.ViewModels.MaintenanceViewModel
@{
    ViewData["Title"] = "Edit Request";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-secondary text-white fw-semibold">
                Edit Request #@Model.RequestID — @Model.TenantName
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="RequestID" />
                    <input type="hidden" asp-for="TenantID" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <p class="text-muted small mb-3">
                        Tenant: <strong>@Model.TenantName</strong> — Unit @Model.UnitNumber
                    </p>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label fw-semibold small"></label>
                            <select asp-for="Category" class="form-select">
                                <option>Plumbing</option>
                                <option>Electrical</option>
                                <option>Structural</option>
                                <option>Appliance</option>
                                <option>Other</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Priority" class="form-label fw-semibold small"></label>
                            <select asp-for="Priority" class="form-select">
                                <option>Low</option>
                                <option>Medium</option>
                                <option>High</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold small"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-semibold small"></label>
                        <select asp-for="Status" class="form-select">
                            <option>Pending</option>
                            <option>In Progress</option>
                            <option>Resolved</option>
                            <option>Cancelled</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label asp-for="AdminNotes" class="form-label fw-semibold small"></label>
                        <textarea asp-for="AdminNotes" class="form-control" rows="2"
                                  placeholder="Notes visible to admin only…"></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm">Save Changes</button>
                        <a asp-action="Index" class="btn btn-secondary btn-sm">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
