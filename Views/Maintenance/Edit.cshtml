@model YnclinoApartmentManagementSystem.Models.ViewModels.MaintenanceViewModel
@{
    ViewData["Title"] = "Edit Request";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-secondary text-white fw-semibold">
                Edit Request #@Model.RequestID — @Model.TenantName
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="RequestID" />
                    <input type="hidden" asp-for="TenantID" />
                    <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>

                    <p class="text-muted small mb-3">
                        Tenant: <strong>@Model.TenantName</strong> — Unit @Model.UnitNumber
                    </p>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label fw-semibold small"></label>
                            <select asp-for="Category" id="categorySelect" class="form-select">
                                <option>Plumbing</option>
                                <option>Electrical</option>
                                <option>Structural</option>
                                <option>Appliance</option>
                                <option>Other</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Priority" class="form-label fw-semibold small"></label>
                            <select asp-for="Priority" class="form-select">
                                <option>Minor</option>
                                <option>Moderate</option>
                                <option>Major</option>
                                <option>Urgent</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3" id="descWrap">
                        <label asp-for="Description" class="form-label fw-semibold small"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ImageUpload" class="form-label fw-semibold small"></label>
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <div class="mb-2">
                                <img src="@Model.ImagePath" alt="Current photo" class="img-fluid rounded border" style="max-height:160px" />
                            </div>
                        }
                        <input asp-for="ImageUpload" class="form-control" type="file" accept="image/*" />
                        <div class="form-text text-muted small">Upload to replace the current photo. JPG, PNG, GIF, or WEBP — up to 5 MB.</div>
                        <span asp-validation-for="ImageUpload" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-semibold small"></label>
                        @{
                            var allowedStatuses = ViewBag.AllowedStatuses as List<string>
                                ?? new List<string> { "Pending", "In Progress", "Resolved", "Cancelled" };
                        }
                        <select asp-for="Status" class="form-select">
                            @foreach (var st in allowedStatuses)
                            {
                                <option value="@st">@st</option>
                            }
                        </select>
                        <div class="form-text text-muted small">
                            A status can only move forward — a resolved or cancelled request
                            cannot be reopened.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AssignedStaffID" class="form-label fw-semibold small"></label>
                        <select asp-for="AssignedStaffID" class="form-select"
                                asp-items="Model.AvailableStaff">
                            <option value="0">— Unassigned —</option>
                        </select>
                        <div class="form-text text-muted small">The staff member is notified as soon as you assign them.</div>
                        <span asp-validation-for="AssignedStaffID" class="text-danger small"></span>
                    </div>


                    @if (!string.IsNullOrWhiteSpace(Model.StaffNotes))
                    {
                        <div class="mb-4">
                            <label class="form-label fw-semibold small">Work Notes (from maintenance staff)</label>
                            <p class="form-control-plaintext border rounded bg-light px-2 py-1 small mb-0">@Model.StaffNotes</p>
                        </div>
                    }

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm">Save Changes</button>
                        <a asp-action="Index" class="btn btn-secondary btn-sm">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // the description box only matters when the issue type is "Other"
        var catSel = document.getElementById('categorySelect');
        var descWrap = document.getElementById('descWrap');
        function toggleDesc() {
            descWrap.style.display = (catSel.value === 'Other') ? '' : 'none';
        }
        catSel.addEventListener('change', toggleDesc);
        toggleDesc();
    </script>
}
