@model YnclinoApartmentManagementSystem.Models.ViewModels.MaintenanceViewModel
@{
    ViewData["Title"] = "Update Request";
}

<div>
    <div>
        <div>
            <div>
                Update Request #@Model.RequestID — @Model.TenantName
            </div>
            <div>
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="RequestID" />
                    <input type="hidden" asp-for="TenantID" />
                    <div asp-validation-summary="All"></div>

                    <p>
                        Tenant: <strong>@Model.TenantName</strong> — Unit @Model.UnitNumber
                    </p>

                    <div>
                        <div>
                            <label asp-for="Category"></label>
                            <select asp-for="Category" id="categorySelect">
                                <option>Plumbing</option>
                                <option>Electrical</option>
                                <option>Structural</option>
                                <option>Appliance</option>
                                <option>Other</option>
                            </select>
                        </div>
                        <div>
                            <label asp-for="Priority"></label>
                            <select asp-for="Priority">
                                <option>Minor</option>
                                <option>Moderate</option>
                                <option>Major</option>
                                <option>Urgent</option>
                            </select>
                        </div>
                    </div>

                    <div id="descWrap">
                        <label asp-for="Description"></label>
                        <textarea asp-for="Description" rows="3"></textarea>
                        <span asp-validation-for="Description"></span>
                    </div>

                    <div>
                        <label asp-for="ImageUpload"></label>
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <div>
                                <img src="@Model.ImagePath" alt="Current photo" />
                            </div>
                        }
                        <input asp-for="ImageUpload" type="file" accept="image/*" />
                        <div>Upload to replace the current photo. JPG, PNG, GIF, or WEBP — up to 5 MB.</div>
                        <span asp-validation-for="ImageUpload"></span>
                    </div>

                    <div>
                        <label asp-for="Status"></label>
                        @{
                            var allowedStatuses = ViewBag.AllowedStatuses as List<string>
                                ?? new List<string> { "Pending", "In Progress", "Resolved", "Cancelled" };
                        }
                        <select asp-for="Status">
                            @foreach (var st in allowedStatuses)
                            {
                                <option value="@st">@st</option>
                            }
                        </select>
                        <div>
                            A status can only move forward — a resolved or cancelled request
                            cannot be reopened.
                        </div>
                    </div>

                    <div>
                        <label asp-for="AssignedStaffID"></label>
                        <select asp-for="AssignedStaffID"
                                asp-items="Model.AvailableStaff">
                            <option value="0">— Unassigned —</option>
                        </select>
                        <div>The staff member is notified as soon as you assign them.</div>
                        <span asp-validation-for="AssignedStaffID"></span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.StaffNotes))
                    {
                        <div>
                            <label>Work Notes (from maintenance staff)</label>
                            <p>@Model.StaffNotes</p>
                        </div>
                    }

                    <div>
                        <button type="submit">Save Changes</button>
                        <a asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // the description box only matters when the issue type is "Other"
        var catSel = document.getElementById('categorySelect');
        var descWrap = document.getElementById('descWrap');
        function toggleDesc() {
            descWrap.style.display = (catSel.value === 'Other') ? '' : 'none';
        }
        catSel.addEventListener('change', toggleDesc);
        toggleDesc();
    </script>
}
