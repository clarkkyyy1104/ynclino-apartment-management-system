@model YnclinoApartmentManagementSystem.Models.tblMaintenanceRequest
@{
    ViewData["Title"] = "Delete Request";
}

<div>
    <div>
        <div data-panel>
            <div data-panel-head>Confirm Delete</div>
            <div data-panel-body>
                <p>Are you sure you want to delete this maintenance request?</p>
                <dl>
                    <dt>Tenant</dt>
                    <dd>@Model.Tenant?.FullName</dd>
                    <dt>Category</dt>
                    <dd>@Model.Category</dd>
                    <dt>Description</dt>
                    <dd>@Model.Description</dd>
                    <dt>Status</dt>
                    <dd>@Model.Status</dd>
                </dl>
                <form asp-action="Delete" method="post" data-actions-row>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.RequestID" />
                    <button type="submit" data-danger>Yes, Delete</button>
                    <a asp-action="Index">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
