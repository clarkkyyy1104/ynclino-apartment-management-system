@model IEnumerable<YnclinoApartmentManagementSystem.Models.tblMaintenanceRequest>
@{
    ViewData["Title"] = "Maintenance Requests";
    bool isAdmin = User.IsInRole("Admin");
    bool isStaff = User.IsInRole("Maintenance");
    bool archived = ViewBag.Archived == true;
}

<div data-module-shell>
<div data-page-head>
    <div>
        <h3>
            @(archived ? "Maintenance Archive" : isStaff ? "My Assigned Requests" : "Maintenance Requests")
        </h3>
    </div>
</div>
    <div data-page-actions>
        @* One button, not a pair of tabs: it names the list you are NOT looking
           at, so it always reads as somewhere to go rather than as a choice
           between two things one of which you are already on. *@
        @if (archived)
        {
            <a asp-action="Index" data-back>Back</a>
        }
        else
        {
            <a asp-action="Index" asp-route-archived="true" data-action-tone="amber">Archive</a>
        }
        @* staff carry out work; they do not raise requests *@
        @if (!archived && !isStaff)
        {
            <a data-modal-link data-primary asp-action="Create">New Request</a>
        }
    </div>

<form method="get" data-auto-search>
    <input type="hidden" name="archived" value="@archived.ToString().ToLower()" />
    @if (isAdmin)
    {
        <div class="searchBar">
            <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="Search tenant or issue type…" />
        </div>
    }
    <div>
        <select name="statusFilter" onchange="this.form.submit()">
            <option value="">All Statuses</option>
            <option value="Pending"     selected="@(ViewBag.StatusFilter == "Pending")">Pending</option>
            <option value="In Progress" selected="@(ViewBag.StatusFilter == "In Progress")">In Progress</option>
            <option value="Resolved"    selected="@(ViewBag.StatusFilter == "Resolved")">Resolved</option>
            <option value="Cancelled"   selected="@(ViewBag.StatusFilter == "Cancelled")">Cancelled</option>
        </select>
    </div>
    <div>
        <a asp-action="Index" asp-route-archived="@archived.ToString().ToLower()" data-action-tone="gray">Clear</a>
    </div>
</form>
</div>

<div data-table-wrap>
    <table>
        <thead>
            <tr>
                @if (isAdmin) { <th>Tenant</th> }
                @if (isAdmin || isStaff) { <th>Unit</th> }
                <th>Issue Type</th>
                <th>Priority</th>
                <th>Status</th>
                @* the tenant sees this too — they should know who is handling their repair *@
                @if (isAdmin || !isStaff) { <th>Assigned To</th> }
                <th>Date Submitted</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    @if (isAdmin)
                    {
                        <td>@r.Tenant?.FullName</td>
                    }
                    @if (isAdmin || isStaff)
                    {
                        <td>@(r.Unit?.UnitNumber ?? r.Tenant?.Unit?.UnitNumber ?? "—")</td>
                    }
                    <td>@r.Category</td>
                    <td>
                        <span>@r.Priority</span>
                    </td>
                    <td>
                        <span>@r.Status</span>
                    </td>
                    @if (isAdmin || !isStaff)
                    {
                        <td>
                            @if (r.AssignedStaff != null)
                            {
                                <span>@r.AssignedStaff.Username</span>
                            }
                            else
                            {
                                <span>@(isAdmin ? "Unassigned" : "Not yet assigned")</span>
                            }
                        </td>
                    }
                    <td>@r.DateSubmitted.ToString("MMM dd, yyyy")</td>
                    <td>
                        
                            <!-- VIEW -->
                            <a data-modal-link asp-action="Details"
                               asp-route-id="@r.RequestID"
                               title="View"
                               aria-label="View">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="14"
                                     height="14"
                                     fill="currentColor"
                                     viewBox="0 0 16 16">
                                    <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                                    <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                                </svg>
                            </a>
                    
                            @if (isStaff && !YnclinoApartmentManagementSystem.Helpers.StatusFlowHelper.IsClosedMaintenance(r.Status))
                            {
                                <a data-modal-link asp-action="Work"
                                   asp-route-id="@r.RequestID">
                                    Update
                                </a>
                            }
                    
                            @* Update and Archive are the same slot, not two: a request
                               that can be updated is still open, and one that can be
                               archived is already closed, so no row ever shows both. *@
                            @if (!archived && YnclinoApartmentManagementSystem.Helpers.StatusFlowHelper.IsClosedMaintenance(r.Status))
                            {
                                <form asp-action="Archive"
                                      asp-route-id="@r.RequestID"
                                      method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" title="Move to archive" aria-label="Move to archive"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16"><path d="M0 2a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1v7.5a2.5 2.5 0 0 1-2.5 2.5h-9A2.5 2.5 0 0 1 1 12.5V5a1 1 0 0 1-1-1zm2 3v7.5A1.5 1.5 0 0 0 3.5 14h9a1.5 1.5 0 0 0 1.5-1.5V5zm13-3H1v2h14zM5 7.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5"/></svg></button>
                                </form>
                            }
                    
                            @if (archived)
                            {
                                <form asp-action="Unarchive"
                                      asp-route-id="@r.RequestID"
                                      method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" title="Put back on the active list" aria-label="Put back on the active list"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z"/><path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466"/></svg></button>
                                </form>
                            }
                    
                            @if (isAdmin)
                            {
                                @if (!archived && !YnclinoApartmentManagementSystem.Helpers.StatusFlowHelper.IsClosedMaintenance(r.Status))
                                {
                                    <a data-modal-link asp-action="Edit"
                                       asp-route-id="@r.RequestID">
                                        Update
                                    </a>
                                }
                            }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                @* tenants now get an "Assigned To" column too, so their row is 6 wide *@
                <tr><td colspan="@(isAdmin ? 8 : isStaff ? 6 : 6)">No maintenance requests found.</td></tr>
            }
        </tbody>
    </table>
</div>
