@model IEnumerable<YnclinoApartmentManagementSystem.Models.tblMaintenanceRequest>
@{
    ViewData["Title"] = "Maintenance Requests";
    bool isAdmin = User.IsInRole("Admin");
    bool isStaff = User.IsInRole("Maintenance");
    bool archived = ViewBag.Archived == true;
    var unreadIds = ViewBag.UnreadIds as HashSet<int> ?? new HashSet<int>();
    var readIds = ViewBag.ReadIds as HashSet<int> ?? new HashSet<int>();
}

@await Component.InvokeAsync("ModuleNotifications", new { module = "Maintenance" })

<div>
    <h3>
        @(archived ? "Maintenance Archive" : isStaff ? "My Assigned Requests" : "Maintenance Requests")
    </h3>
    <div>
        @* staff carry out work; they do not raise requests *@
        @if (!archived && !isStaff)
        {
            <a asp-action="Create">+ New Request</a>
        }
        <div>
            <a asp-action="Index">Active</a>
            <a asp-action="Index" asp-route-archived="true">Archive</a>
        </div>
    </div>
</div>

<form method="get">
    <input type="hidden" name="archived" value="@archived.ToString().ToLower()" />
    @if (isAdmin)
    {
        <div>
            <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="Search tenant or issue type…" />
        </div>
    }
    <div>
        <select name="statusFilter" onchange="this.form.submit()">
            <option value="">All Statuses</option>
            <option value="Pending"     selected="@(ViewBag.StatusFilter == "Pending")">Pending</option>
            <option value="In Progress" selected="@(ViewBag.StatusFilter == "In Progress")">In Progress</option>
            <option value="Resolved"    selected="@(ViewBag.StatusFilter == "Resolved")">Resolved</option>
            <option value="Cancelled"   selected="@(ViewBag.StatusFilter == "Cancelled")">Cancelled</option>
        </select>
    </div>
    <div>
        <a asp-action="Index" asp-route-archived="@archived.ToString().ToLower()">Clear</a>
    </div>
</form>

<div>
    <table>
        <thead>
            <tr>
                @if (isAdmin) { <th>Tenant</th> }
                @if (isAdmin || isStaff) { <th>Unit</th> }
                <th>Issue Type</th>
                <th>Priority</th>
                <th>Status</th>
                @* the tenant sees this too — they should know who is handling their repair *@
                @if (isAdmin || !isStaff) { <th>Assigned To</th> }
                <th>Date Submitted</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    @if (isAdmin)
                    {
                        <td>@r.Tenant?.FullName</td>
                    }
                    @if (isAdmin || isStaff)
                    {
                        <td>@(r.Unit?.UnitNumber ?? r.Tenant?.Unit?.UnitNumber ?? "—")</td>
                    }
                    <td>@r.Category</td>
                    <td>
                        <span>@r.Priority</span>
                    </td>
                    <td>
                        <span>@r.Status</span>
                    </td>
                    @if (isAdmin || !isStaff)
                    {
                        <td>
                            @if (r.AssignedStaff != null)
                            {
                                <span>@r.AssignedStaff.Username</span>
                            }
                            else
                            {
                                <span>@(isAdmin ? "Unassigned" : "Not yet assigned")</span>
                            }
                        </td>
                    }
                    <td>@r.DateSubmitted.ToString("MMM dd, yyyy")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@r.RequestID" title="View" aria-label="View"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/></svg></a>
                        @if (isStaff && !YnclinoApartmentManagementSystem.Helpers.StatusFlowHelper.IsClosedMaintenance(r.Status))
                        {
                            <a asp-action="Work" asp-route-id="@r.RequestID">Update</a>
                        }
                        @* A finished request only leaves this list when you file it away,
                           and it is filed for YOU — the other side keeps their own copy. *@
                        @if (!archived && YnclinoApartmentManagementSystem.Helpers.StatusFlowHelper.IsClosedMaintenance(r.Status))
                        {
                            <form asp-action="Archive" asp-route-id="@r.RequestID" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit">Archive</button>
                            </form>
                        }
                        @if (archived)
                        {
                            <form asp-action="Unarchive" asp-route-id="@r.RequestID" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit">Restore</button>
                            </form>
                        }                        
                        @if (isAdmin)
                        {
                            @* archived requests are closed history — no editing *@
                            @if (!archived && !YnclinoApartmentManagementSystem.Helpers.StatusFlowHelper.IsClosedMaintenance(r.Status))
                            {
                                <a asp-action="Edit" asp-route-id="@r.RequestID">Update</a>
                            }
                            <a asp-action="Delete" asp-route-id="@r.RequestID">Delete</a>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                @* tenants now get an "Assigned To" column too, so their row is 6 wide *@
                <tr><td colspan="@(isAdmin ? 8 : isStaff ? 6 : 6)">No maintenance requests found.</td></tr>
            }
        </tbody>
    </table>
</div>
