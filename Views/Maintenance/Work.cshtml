@model YnclinoApartmentManagementSystem.Models.ViewModels.MaintenanceViewModel
@{
    ViewData["Title"] = "Update Request";
}

<div>
    <div>
        <div data-form-panel>
            <div data-form-head>
                Update Request - Unit @Model.UnitNumber
            </div>
            <div data-form-body data-cols="1" data-request-work>

                @* read-only context: the staff member reports on the job, they don't redefine it *@
                <dl data-request-summary>
                    <div>
                        <dt>Unit</dt>
                        <dd>@(Model.UnitNumber ?? "—")</dd>
                    </div>
                    <div>
                        <dt>Tenant</dt>
                        <dd>@Model.TenantName</dd>
                    </div>
                    <div>
                        <dt>Issue Type</dt>
                        <dd>@Model.Category</dd>
                    </div>
                    <div>
                        <dt>Priority</dt>
                        <dd><span>@Model.Priority</span></dd>
                    </div>
                    <div data-span>
                        <dt>Date Submitted</dt>
                        <dd>@Model.DateSubmitted.ToString("MMM dd, yyyy")</dd>
                    </div>
                    <div data-span>
                        <dt>Description</dt>
                        <dd data-request-description>@Model.Description</dd>
                    </div>
                </dl>

                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <a href="@Model.ImagePath" target="_blank" rel="noopener" data-request-photo>
                        <img src="@Model.ImagePath" alt="Reported photo" />
                    </a>
                }

                <form asp-action="Work" method="post" data-form-grid>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="RequestID" />
                    <div asp-validation-summary="All"></div>

                    <div data-span>
                        <label asp-for="Status"></label>
                        @{
                            var allowedStatuses = ViewBag.AllowedStatuses as List<string> ?? new List<string>();
                        }
                        <select asp-for="Status" aria-describedby="request-status-help">
                            @foreach (var st in allowedStatuses)
                            {
                                <option value="@st">@st</option>
                            }
                        </select>
                        <div id="request-status-help">
                            A status can only move forward. Once you mark this
                            <strong>Resolved</strong> it is closed and can no longer be changed.
                        </div>
                        <span asp-validation-for="Status"></span>
                    </div>

                    <div data-actions-row>
                        <button type="submit">Save Update</button>
                        <a asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
