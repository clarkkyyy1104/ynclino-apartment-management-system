@model IEnumerable<YnclinoApartmentManagementSystem.Models.tblUnitTransferRequest>
@{
    ViewData["Title"] = "Unit Requests";
    bool isAdmin = User.IsInRole("Admin");
    string title = isAdmin ? "Unit Requests" : "My Unit Requests";
    var archivedList = ViewBag.ArchivedList as IEnumerable<YnclinoApartmentManagementSystem.Models.tblUnitTransferRequest>
                       ?? Enumerable.Empty<YnclinoApartmentManagementSystem.Models.tblUnitTransferRequest>();
}

<div data-page-head>
    <div>
        <h3>@title</h3>
        <p>
            @(isAdmin
                ? "Requests to move to another unit, and applications for a first unit."
                : "The requests you have sent, and what has become of them.")
        </p>
    </div>
    @if (!isAdmin)
    {
        <div data-actions>
            <a asp-action="Create" data-primary>+ New Request</a>
        </div>
    }
</div>

<div data-panel>
    <div data-panel-head>Active</div>
    <div data-panel-body>
        @{ ViewData["EmptyText"] = "No active requests."; ViewData["IsArchive"] = false; }
        <partial name="_RequestList" model="Model" />
    </div>
</div>

<div data-panel>
    <div data-panel-head>Archive</div>
    <div data-panel-body>
        @{ ViewData["EmptyText"] = "Nothing in the archive yet."; ViewData["IsArchive"] = true; }
        <partial name="_RequestList" model="archivedList" />
    </div>
</div>
