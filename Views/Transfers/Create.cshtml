@{
    bool hasUnit = ViewBag.HasUnit == true;
    ViewData["Title"] = "Request Unit Transfer";
    var availableUnits = ViewBag.AvailableUnits as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                      ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}

<div>
    <div>
        <div>
            <div>@("Request a Unit Transfer")</div>
            <div>
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All"></div>
                }

                <p>
                    @if (hasUnit)
                    {
                        <text>You are currently in <strong>Unit @ViewBag.CurrentUnit</strong>. Choose an available unit you'd like to move to.</text>
                    }
                    An administrator will review your request.
                </p>

                @if (!availableUnits.Any())
                {
                    <div>There are no available units right now.</div>
                    <a asp-action="Index" data-back>Back</a>
                }
                else
                {
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div>
                            <label>Preferred Unit</label>
                            <select name="requestedUnitID" required>
                                <option value="">— Select an available unit —</option>
                                @foreach (var u in availableUnits)
                                {
                                    <option value="@u.Value">@u.Text</option>
                                }
                            </select>
                        </div>

                        <div data-actions-row>
                            <button type="submit">Submit Request</button>
                            <a asp-action="Index">Cancel</a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
