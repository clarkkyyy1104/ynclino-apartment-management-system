@{
    bool hasUnit = ViewBag.HasUnit == true;
    ViewData["Title"] = hasUnit ? "Request Unit Transfer" : "Apply for a Unit";
    var availableUnits = ViewBag.AvailableUnits as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                      ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white fw-semibold">@(hasUnit ? "Request a Unit Transfer" : "Apply for a Unit")</div>
            <div class="card-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
                }

                <p class="text-muted small mb-3">
                    @if (hasUnit)
                    {
                        <text>You are currently in <strong>Unit @ViewBag.CurrentUnit</strong>. Choose an available unit you'd like to move to and tell us why.</text>
                    }
                    else
                    {
                        <text>You don't have a unit yet. Choose a available unit you'd like to occupy and tell us why.</text>
                    }
                    An administrator will review your request.
                </p>

                @if (!availableUnits.Any())
                {
                    <div class="alert alert-warning small">There are no available units right now.</div>
                    <a asp-action="Index" class="btn btn-secondary btn-sm">Back</a>
                }
                else
                {
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Preferred Unit</label>
                            <select name="requestedUnitID" class="form-select" required>
                                <option value="">— Select an available unit —</option>
                                @foreach (var u in availableUnits)
                                {
                                    <option value="@u.Value">@u.Text</option>
                                }
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold small">Reason <span class="text-muted fw-normal">(optional)</span></label>
                            <textarea name="reason" class="form-control" rows="3" maxlength="500"
                                      placeholder="@(hasUnit ? "e.g. I'd prefer a unit closer to the entrance…" : "e.g. I'd like to occupy this available unit…")"></textarea>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-sm">Submit Request</button>
                            <a asp-action="Index" class="btn btn-secondary btn-sm">Cancel</a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
