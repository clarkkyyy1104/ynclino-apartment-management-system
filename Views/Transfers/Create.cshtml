@model YnclinoApartmentManagementSystem.Models.tblUnit
@{
    ViewData["Title"] = "Request Unit Transfer";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white fw-semibold">Request a Unit Transfer</div>
            <div class="card-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
                }

                <p class="text-muted small mb-3">
                    You are currently in <strong>Unit @ViewBag.CurrentUnit</strong>. You're requesting a
                    move to the unit below. An administrator will review your request.
                </p>

                <div class="border rounded p-3 mb-3 bg-light">
                    <div class="fw-semibold mb-1">Unit @Model.UnitNumber <span class="text-muted">— @Model.UnitType</span></div>
                    <div class="row small text-muted g-1">
                        <div class="col-6">Monthly Rent: <strong class="text-dark">₱@Model.RentPrice.ToString("N0")</strong></div>
                        <div class="col-6">Capacity: <strong class="text-dark">@Model.Capacity person(s)</strong></div>
                        <div class="col-6">Deposit: <strong class="text-dark">₱@Model.Deposit.ToString("N0")</strong></div>
                        <div class="col-6">Advance: <strong class="text-dark">₱@Model.AdvancePayment.ToString("N0")</strong></div>
                    </div>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="requestedUnitID" value="@Model.UnitID" />

                    <div class="mb-4">
                        <label class="form-label fw-semibold small">Reason for Transfer</label>
                        <textarea name="reason" class="form-control" rows="3" maxlength="500" required
                                  placeholder="e.g. I'd prefer a unit closer to the entrance…">@ViewBag.Reason</textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm">Submit Request</button>
                        <a asp-controller="Units" asp-action="Index" class="btn btn-secondary btn-sm">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
