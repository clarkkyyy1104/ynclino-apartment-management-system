@{
    ViewData["Title"] = "Request Unit Transfer";
    var vacantUnits = ViewBag.VacantUnits as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                      ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white fw-semibold">Request a Unit Transfer</div>
            <div class="card-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
                }

                <p class="text-muted small mb-3">
                    You are currently in <strong>Unit @ViewBag.CurrentUnit</strong>. Choose an available
                    unit you'd like to move to and tell us why. An administrator will review your request.
                </p>

                @if (!vacantUnits.Any())
                {
                    <div class="alert alert-warning small">There are no available units to transfer to right now.</div>
                    <a asp-action="Index" class="btn btn-secondary btn-sm">Back</a>
                }
                else
                {
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Preferred Unit</label>
                            <select name="requestedUnitID" class="form-select" required>
                                <option value="">— Select an available unit —</option>
                                @foreach (var u in vacantUnits)
                                {
                                    <option value="@u.Value">@u.Text</option>
                                }
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold small">Reason for Transfer</label>
                            <textarea name="reason" class="form-control" rows="3" maxlength="500" required
                                      placeholder="e.g. I'd prefer a unit closer to the entrance…"></textarea>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-sm">Submit Request</button>
                            <a asp-action="Index" class="btn btn-secondary btn-sm">Cancel</a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
