@model IEnumerable<YnclinoApartmentManagementSystem.Models.tblUnitTransferRequest>
@{
    bool isAdmin = User.IsInRole("Admin");
    var unreadIds = ViewBag.UnreadIds as HashSet<int> ?? new HashSet<int>();
    var readIds = ViewBag.ReadIds as HashSet<int> ?? new HashSet<int>();
    string emptyText = ViewData["EmptyText"] as string ?? "Nothing here.";
    // the same partial draws both columns, so it has to know which one it is
    bool isArchiveColumn = ViewData["IsArchive"] as bool? ?? false;
    var closedStatuses = ViewBag.ClosedStatuses as string[] ?? new[] { "Approved", "Rejected", "Cancelled" };    
}
@if (!Model.Any())
{
    <div data-empty><p>@emptyText</p></div>
}
else
{
    <div data-table-wrap>
        <table>
            <thead>
                <tr>
                    @if (isAdmin) { <th>Tenant</th> }
                    <th>From</th>
                    <th>To</th>
                    <th>Status</th>
                    @* every row has a cell of buttons under this; without a heading
                    for it the navy bar stopped short of the buttons and the
                    column looked broken off *@
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        @if (isAdmin) { <td>@r.Tenant?.FullName</td> }
                        <td>@(r.CurrentUnit?.UnitNumber ?? "—")</td>
                        <td>@r.RequestedUnit?.UnitNumber</td>
                        <td><span>@r.Status</span></td>
                        <td>
                            @if (isAdmin && r.Status == "Pending")
                            {
                                <div>
                                    <form asp-action="Approve" asp-route-id="@r.TransferID" method="post" onsubmit="return confirm('Move @r.Tenant?.FullName to unit @r.RequestedUnit?.UnitNumber?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit">Approve</button>
                                    </form>
                                    <form asp-action="Reject" asp-route-id="@r.TransferID" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit">Reject</button>
                                    </form>
                                </div>
                            }
                            else if (!isAdmin && r.Status == "Pending")
                            {
                                <form asp-action="Cancel" asp-route-id="@r.TransferID" method="post"
                                      onsubmit="return confirm('Cancel this request?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit">Cancel</button>
                                </form>
                            }
                            else
                            {
                                @* A reviewed request stays here until you file it away,
                                   and only for YOU — the other side keeps their copy. *@
                                @if (!isArchiveColumn && closedStatuses.Contains(r.Status))
                                {
                                    <form asp-action="Archive" asp-route-id="@r.TransferID" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" title="Move to archive" aria-label="Move to archive"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16"><path d="M0 2a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1v7.5a2.5 2.5 0 0 1-2.5 2.5h-9A2.5 2.5 0 0 1 1 12.5V5a1 1 0 0 1-1-1zm2 3v7.5A1.5 1.5 0 0 0 3.5 14h9a1.5 1.5 0 0 0 1.5-1.5V5zm13-3H1v2h14zM5 7.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5"/></svg></button>
                                    </form>
                                }
                                else if (isArchiveColumn)
                                {
                                    <form asp-action="Unarchive" asp-route-id="@r.TransferID" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" title="Put back on the active list" aria-label="Put back on the active list"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z"/><path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466"/></svg></button>
                                    </form>
                                }
                                @if (!string.IsNullOrEmpty(r.AdminNotes))
                                {
                                    <div>Note: @r.AdminNotes</div>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
