@model IEnumerable<YnclinoApartmentManagementSystem.Models.tblUnitTransferRequest>
@{
    bool isAdmin = User.IsInRole("Admin");
    string emptyText = ViewData["EmptyText"] as string ?? "Nothing here.";
    // the same partial draws both columns, so it has to know which one it is
    bool isArchiveColumn = ViewData["IsArchive"] as bool? ?? false;
    @* 'Approved' is NOT closed — the tenant still has to be moved. Archiving one
       would hide outstanding work, so the fallback must match the controller. *@
    var closedStatuses = ViewBag.ClosedStatuses as string[] ?? new[] { "Completed", "Rejected", "Cancelled" };
}
@if (!Model.Any())
{
    <div data-empty><p>@emptyText</p></div>
}
else
{
    <div data-table-wrap>
        <table>
            <thead>
                <tr>
                    @if (isAdmin) { <th>Tenant</th> }
                    <th>From</th>
                    <th>To</th>
                    <th>Status</th>
                    @* every row has a cell of buttons under this; without a heading
                    for it the navy bar stopped short of the buttons and the
                    column looked broken off *@
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        @if (isAdmin) { <td>@r.Tenant?.FullName</td> }
                        <td>@(r.CurrentUnit?.UnitNumber ?? "—")</td>
                        <td>@r.RequestedUnit?.UnitNumber</td>
                        @* 'Approved' on its own reads as finished, which it is not —
                           the tenant still has to be moved. Name the phase instead. *@
                        <td>
                            <span data-status="@r.Status">
                                @(r.Status == "Approved" ? "Approved — For Transfer" : r.Status)
                            </span>
                        </td>
                        <td>
                            @if (isAdmin && r.Status == "Pending")
                            {
                                <div>
                                    @* Approving does NOT move anybody, so the wording must not
                                       promise that it does. The move happens on Complete. *@
                                    <form asp-action="Approve" asp-route-id="@r.TransferID" method="post" onsubmit="return confirm('Approve this request? @r.Tenant?.FullName will be subject for transfer to unit @r.RequestedUnit?.UnitNumber, but will not be moved until you mark it as completed.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit">Approve</button>
                                    </form>
                                    <form asp-action="Reject" asp-route-id="@r.TransferID" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit">Reject</button>
                                    </form>
                                </div>
                            }
                            else if (isAdmin && r.Status == "Approved")
                            {
                                <div>
                                    @* This is the step the old design was missing: the
                                       transfer has been agreed and is now being carried
                                       out. Completing it is what moves the tenant. *@
                                    <form asp-action="Complete" asp-route-id="@r.TransferID" method="post" onsubmit="return confirm('Mark as done? This moves @r.Tenant?.FullName into unit @r.RequestedUnit?.UnitNumber and closes their old assignment.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit">Mark as Completed</button>
                                    </form>
                                    <form asp-action="CancelApproved" asp-route-id="@r.TransferID" method="post" onsubmit="return confirm('Call off this approved transfer? Unit @r.RequestedUnit?.UnitNumber will be released.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit">Call Off</button>
                                    </form>
                                </div>
                            }
                            else if (!isAdmin && r.Status == "Pending")
                            {
                                <form asp-action="Cancel" asp-route-id="@r.TransferID" method="post"
                                      onsubmit="return confirm('Cancel this request?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit">Cancel</button>
                                </form>
                            }
                            else if (!isAdmin && r.Status == "Approved")
                            {
                                @* Decided in their favour, but not theirs to cancel any
                                   more — the office is carrying it out. *@
                                <span>Waiting to be moved</span>
                            }
                            else
                            {
                                @* A reviewed request stays here until you file it away,
                                   and only for YOU — the other side keeps their copy. *@
                                @if (!isArchiveColumn && closedStatuses.Contains(r.Status))
                                {
                                    <form asp-action="Archive" asp-route-id="@r.TransferID" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" title="Move to archive" aria-label="Move to archive"><img src="/images/icons/archive.svg" /></button>
                                    </form>
                                }
                                else if (isArchiveColumn)
                                {
                                    <form asp-action="Unarchive" asp-route-id="@r.TransferID" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" title="Put back on the active list" aria-label="Put back on the active list"><img src="/images/icons/restore.svg"/></button>
                                    </form>
                                }
                                @if (!string.IsNullOrEmpty(r.AdminNotes))
                                {
                                    <div>Note: @r.AdminNotes</div>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
