@model YnclinoApartmentManagementSystem.Models.tblUnit
@{
    ViewData["Title"] = "Delete Unit";
}

<div>
    <div>
        <div data-panel>
            <div data-panel-head>Confirm Delete</div>
            <div data-panel-body>
                <p>Are you sure you want to permanently delete this unit?</p>

                <dl>
                    <dt>Unit Number</dt>
                    <dd>@Model.UnitNumber</dd>
                    <dt>Unit Type</dt>
                    <dd>@Model.UnitType</dd>
                    <dt>Status</dt>
                    <dd>@Model.Status</dd>
                </dl>

                @if (Model.Tenants != null && Model.Tenants.Any(t => t.Status == "Active"))
                {
                    <div>
                        This unit has active tenants and cannot be deleted.
                    </div>
                }

                <form asp-action="Delete" method="post">
                    <input type="hidden" name="id" value="@Model.UnitID" />
                    <div>
                        <button type="submit">Yes, Delete</button>
                        <a asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
