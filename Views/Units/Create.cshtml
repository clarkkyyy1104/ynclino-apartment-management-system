@model YnclinoApartmentManagementSystem.Models.ViewModels.UnitViewModel
@{
    ViewData["Title"] = "Add Unit";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white fw-semibold">Add New Unit</div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none"></div>

                    <div class="mb-3">
                        <label asp-for="UnitNumber" class="form-label fw-semibold"></label>
                        <input asp-for="UnitNumber" class="form-control" placeholder="e.g. 101"
                               inputmode="numeric" pattern="[0-9]+" />
                        <span asp-validation-for="UnitNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UnitType" class="form-label fw-semibold"></label>
                        <select asp-for="UnitType" class="form-select" id="unitTypeSelect">
                            <option value="">— Select Unit Type —</option>
                            <option>Studio</option>
                            <option>1-Bedroom</option>
                            <option>2-Bedroom</option>
                            <option>3-Bedroom</option>
                        </select>
                        <span asp-validation-for="UnitType" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RentPrice" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">₱</span>
                            <input asp-for="RentPrice" class="form-control" type="number" min="0.01" step="100" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="RentPrice" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Capacity" class="form-label fw-semibold"></label>
                        <input asp-for="Capacity" class="form-control" type="number" min="1" step="1" placeholder="e.g. 2" />
                        <span asp-validation-for="Capacity" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Status" class="form-label fw-semibold"></label>
                        <select asp-for="Status" class="form-select">
                            <option>Vacant</option>
                            <option>Occupied</option>
                            <option>Under Maintenance</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Add Unit</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        var presetPrices = { 'Studio': 3500, '1-Bedroom': 5000, '2-Bedroom': 8000, '3-Bedroom': 12000 };
        var presetCapacity = { 'Studio': 1, '1-Bedroom': 2, '2-Bedroom': 4, '3-Bedroom': 6 };
        document.getElementById('unitTypeSelect').addEventListener('change', function () {
            var price = presetPrices[this.value];
            if (price) document.getElementById('RentPrice').value = price;
            var capacity = presetCapacity[this.value];
            if (capacity) document.getElementById('Capacity').value = capacity;
        });
    </script>
}
