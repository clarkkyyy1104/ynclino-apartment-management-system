@model YnclinoApartmentManagementSystem.Models.tblUnit
@{
    ViewData["Title"] = $"Tenancy History — Unit {Model.UnitNumber}";
}

@* Who has lived in this unit. Opened from the unit's own details modal. *@
<div data-modal-source>
    <div data-panel>
        <div data-panel-head>Tenancy History</div>
        <div data-panel-body>
            @if (Model.Tenants.Any())
            {
                <div data-table-wrap>
                    <table>
                        <thead>
                            <tr>
                                <th>Tenant Name</th>
                                <th>Recorded</th>
                                <th>Move-Out</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tenant in Model.Tenants.OrderByDescending(t => t.Status == "Active").ThenByDescending(t => t.DateRecorded))
                            {
                                <tr>
                                    <td>@tenant.LastName, @tenant.FirstName</td>
                                    <td>@tenant.DateRecorded.ToString("MMM dd, yyyy")</td>
                                    <td>@(tenant.MoveOutDate?.ToString("MMM dd, yyyy") ?? "-")</td>
                                    <td>@tenant.Status</td>
                                    <td>
                                        <a data-modal-link asp-controller="Tenants" asp-action="Details" asp-route-id="@tenant.TenantID" title="View" aria-label="View"><img src="/images/icons/view.svg" alt="" /></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p>No tenants have been assigned to this unit yet.</p>
            }
        </div>
    </div>

    <div data-actions-row>
        <a asp-action="Index">Back to Units</a>
    </div>
</div>
