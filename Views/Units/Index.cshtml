@model IEnumerable<YnclinoApartmentManagementSystem.Models.tblUnit>
@{
    ViewData["Title"] = "Units";
    bool isStaff = User.IsInRole("Admin");
    bool isTenant = User.IsInRole("Tenant");
}

<div data-module-shell>
<div data-page-head>
    <div><h3>Units</h3></div>
    @if (isStaff)
    {
        <div data-actions>
            @* Demo data for the defence. Only offered while the list is empty,
               so it can never overwrite real records. *@
            @if (ViewBag.HasUnits != true)
            {
                <form asp-action="GenerateSampleData" method="post"
                      onsubmit="return confirm('Load the sample data (5 units, 5 tenants, and connected records)?')">
                    @Html.AntiForgeryToken()
                    <button type="submit">Load Sample Data</button>
                </form>
            }
            <a data-modal-link data-primary asp-action="Create">Add Unit</a>
        </div>
    }
    @if (isTenant)
    {
        <div data-actions>
            <a data-modal-link data-primary asp-controller="Transfers" asp-action="Create">Request Transfer</a>
        </div>
    }
</div>

<form method="get">
    <div>
        <input type="text" name="searchTerm" value="@ViewBag.SearchTerm"
               placeholder="Search unit number or type…" />
    </div>
    <div>
        <select name="statusFilter" onchange="this.form.submit()">
            <option value="">All Statuses</option>
            <option value="Available" selected="@(ViewBag.StatusFilter == "Available")">Available</option>
            <option value="Reserved" selected="@(ViewBag.StatusFilter == "Reserved")">Reserved</option>
            <option value="Occupied" selected="@(ViewBag.StatusFilter == "Occupied")">Occupied</option>
            <option value="Under Maintenance" selected="@(ViewBag.StatusFilter == "Under Maintenance")">Under Maintenance</option>
        </select>
    </div>
    <div>
        <a asp-action="Index">Clear</a>
    </div>
</form>
</div>

<div data-table-wrap>
    <table>
        <thead>
            <tr>
                <th>Unit Number</th>
                <th>Unit Type</th>
                <th>Rent Price</th>
                <th>Deposit</th>
                <th>Advance</th>
                <th>Capacity</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var unit in Model)
            {
                <tr>
                    <td>@unit.UnitNumber</td>
                    <td>@unit.UnitType</td>
                    <td>₱@unit.RentPrice.ToString("N0")</td>
                    <td>₱@unit.Deposit.ToString("N0")</td>
                    <td>₱@unit.AdvancePayment.ToString("N0")</td>
                    <td>@unit.Capacity</td>
                    <td>
                        <span>@unit.Status</span>
                    </td>
                    <td>
                        <a data-modal-link asp-action="Details" asp-route-id="@unit.UnitID" title="View" aria-label="View"><img src="/images/icons/eye.svg"/></a>
                        @if (isStaff)
                        {
                            <a data-modal-link asp-action="Edit" asp-route-id="@unit.UnitID">Update</a>
                            <a data-modal-link asp-action="Delete" asp-route-id="@unit.UnitID">Delete</a>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8">No units found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
