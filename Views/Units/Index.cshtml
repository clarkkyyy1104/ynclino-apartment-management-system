@model IEnumerable<YnclinoApartmentManagementSystem.Models.tblUnit>
@{
    ViewData["Title"] = "Units";
    bool isStaff = User.IsInRole("Admin");
    bool isTenant = User.IsInRole("Tenant");
}

<div>
    <h3>Units</h3>
    @if (isStaff)
    {
        <div>
            @* @if (ViewBag.HasUnits != true)
            {
                <form asp-action="GenerateSampleData" method="post"
                      onsubmit="return confirm('Load the sample data (5 units, 5 tenants, and connected records)?')">
                    @Html.AntiForgeryToken()
                    <button type="submit">Load Sample Data</button>
                </form>
            }
            else
            {
                <form asp-action="ReloadSampleData" method="post"
                      onsubmit="return confirm('Reload the sample data? This DELETES the current units, tenants, bills, maintenance, and lost &amp; found records (admin accounts are kept) and regenerates a fresh set of 5 units and 5 tenants.')">
                    @Html.AntiForgeryToken()
                    <button type="submit">Reload Sample Data</button>
                </form>
            } *@
            <a asp-action="Create">+ Add Unit</a>
        </div>
    }
    @if (isTenant)
    {
        <a asp-controller="Transfers" asp-action="Create">+ Request Transfer</a>
    }
</div>

@if (isTenant)
{
    @await Component.InvokeAsync("ModuleNotifications", new { module = "Transfer" })
}

<form method="get">
    <div>
        <input type="text" name="searchTerm" value="@ViewBag.SearchTerm"
               placeholder="Search unit number or type…" />
    </div>
    <div>
        <select name="statusFilter" onchange="this.form.submit()">
            <option value="">All Statuses</option>
            <option value="Available" selected="@(ViewBag.StatusFilter == "Available")">Available</option>
            <option value="Reserved" selected="@(ViewBag.StatusFilter == "Reserved")">Reserved</option>
            <option value="Occupied" selected="@(ViewBag.StatusFilter == "Occupied")">Occupied</option>
            <option value="Under Maintenance" selected="@(ViewBag.StatusFilter == "Under Maintenance")">Under Maintenance</option>
        </select>
    </div>
    <div>
        <a asp-action="Index">Clear</a>
    </div>
</form>

<div>
    <table>
        <thead>
            <tr>
                <th>Unit Number</th>
                <th>Unit Type</th>
                <th>Rent Price</th>
                <th>Deposit</th>
                <th>Advance</th>
                <th>Capacity</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var unit in Model)
            {
                <tr>
                    <td>@unit.UnitNumber</td>
                    <td>@unit.UnitType</td>
                    <td>₱@unit.RentPrice.ToString("N0")</td>
                    <td>₱@unit.Deposit.ToString("N0")</td>
                    <td>₱@unit.AdvancePayment.ToString("N0")</td>
                    <td>@unit.Capacity</td>
                    <td>
                        <span>@unit.Status</span>
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@unit.UnitID" title="View" aria-label="View"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/></svg></a>
                        @if (isStaff)
                        {
                            <a asp-action="Edit" asp-route-id="@unit.UnitID">Update</a>
                            <a asp-action="Delete" asp-route-id="@unit.UnitID">Delete</a>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8">No units found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
