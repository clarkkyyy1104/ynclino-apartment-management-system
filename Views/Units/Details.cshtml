@model YnclinoApartmentManagementSystem.Models.tblUnit
@{
    ViewData["Title"] = $"Unit {Model.UnitNumber}";
    bool isAdmin = User.IsInRole("Admin");
}

@* data-modal-source is the part the modal script lifts into the dialog *@
<div data-modal-source>
    <div data-panel>
        <div data-panel-head>Unit @Model.UnitNumber</div>
        <div data-panel-body>
            <dl>
                <dt>Unit Type</dt>
                <dd>@Model.UnitType</dd>
                <dt>Rent Price</dt>
                <dd>₱ @Model.RentPrice.ToString("N2")</dd>
                <dt>Deposit</dt>
                <dd>₱ @Model.Deposit.ToString("N2")</dd>
                <dt>One Month Advance</dt>
                <dd>₱ @Model.AdvancePayment.ToString("N2")</dd>
                <dt>Capacity</dt>
                <dd>@Model.Capacity</dd>
                <dt>Status</dt>
                <dd>@Model.Status</dd>
            </dl>
        </div>
    </div>

    <div data-actions-row>
        <a asp-action="Index">Back to Units</a>
        @if (isAdmin)
        {
            @* the history opens in a modal of its own, as the design has it *@
            <a data-modal-link data-primary asp-action="History" asp-route-id="@Model.UnitID">Tenancy History</a>
        }
    </div>
</div>
