@model YnclinoApartmentManagementSystem.Models.ViewModels.UnitViewModel
@{
    ViewData["Title"] = "Update Unit";
}

<div>
    <div>
        <div data-form-panel>
            <div data-form-head>Update Unit — @Model.UnitNumber</div>
            <div data-form-body>
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="UnitID" />
                    <div asp-validation-summary="ModelOnly"></div>

                    <div>
                        <label asp-for="UnitNumber"></label>
                        <input asp-for="UnitNumber"
                               inputmode="numeric" pattern="[0-9]+" />
                        <span asp-validation-for="UnitNumber"></span>
                    </div>

                    <div>
                        <label asp-for="UnitType"></label>
                        <select id="roomTypeSelect">
                            <option value="">— Select Unit Type —</option>
                            <option value="Studio">Studio</option>
                            <option value="Bedspacer">Bedspacer</option>
                            <option value="Custom">Custom (choose bedrooms)</option>
                        </select>
                        <input asp-for="UnitType" type="hidden" id="unitTypeHidden" />
                        <span asp-validation-for="UnitType"></span>
                    </div>

                    <div id="bedroomWrap">
                        <label>Number of Bedrooms</label>
                        <input type="number" id="bedroomCount" min="1" step="1" value="1" />
                        <div>Saved as e.g. <em>2-Bedroom</em>.</div>
                    </div>

                    <div>
                        <label asp-for="RentPrice"></label>
                        <div>
                            <span>₱</span>
                            <input asp-for="RentPrice" type="number" min="0.01" step="100" />
                        </div>
                        <span asp-validation-for="RentPrice"></span>
                    </div>

                    <div>
                        <label asp-for="Deposit"></label>
                        <div>
                            <span>₱</span>
                            <input asp-for="Deposit" type="number" min="0" step="100" />
                        </div>
                        <div>1 month security deposit.</div>
                        <span asp-validation-for="Deposit"></span>
                    </div>

                    <div>
                        <label asp-for="AdvancePayment"></label>
                        <div>
                            <span>₱</span>
                            <input asp-for="AdvancePayment" type="number" min="0" step="100" />
                        </div>
                        <div>1 month advance payment.</div>
                        <span asp-validation-for="AdvancePayment"></span>
                    </div>

                    <div>
                        <label asp-for="Capacity"></label>
                        <input asp-for="Capacity" type="number" min="1" step="1" />
                        <span asp-validation-for="Capacity"></span>
                    </div>

                    <div>
                        <label asp-for="Status"></label>
                        <select asp-for="Status">
                            <option>Available</option>
                            <option>Occupied</option>
                            <option>Under Maintenance</option>
                        </select>
                        <span asp-validation-for="Status"></span>
                    </div>

                    <div>
                        <button type="submit">Update Unit</button>
                        <a asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        // standard pricing per unit type (deposit = 1 month, advance = 1 month)
        var presets = {
            'Studio':    { rent: 6000, deposit: 6000, advance: 6000, capacity: 2 },
            'Bedspacer': { rent: 1500, deposit: 1500, advance: 1500, capacity: 4 }
        };

        var roomTypeSelect = document.getElementById('roomTypeSelect');
        var unitTypeHidden = document.getElementById('unitTypeHidden');
        var bedroomWrap = document.getElementById('bedroomWrap');
        var bedroomCount = document.getElementById('bedroomCount');
        var rentEl = document.getElementById('RentPrice');
        var depositEl = document.getElementById('Deposit');
        var advanceEl = document.getElementById('AdvancePayment');
        var capacityEl = document.getElementById('Capacity');
        // start "touched" so editing the rent doesn't clobber the stored amounts;
        // picking a preset type below re-enables the auto-fill
        var depositTouched = true;
        var advanceTouched = true;
        depositEl.addEventListener('input', function () { depositTouched = true; });
        advanceEl.addEventListener('input', function () { advanceTouched = true; });

        function setPricing(rent, deposit, advance, capacity) {
            rentEl.value = rent;
            depositEl.value = deposit;
            advanceEl.value = advance;
            capacityEl.value = capacity;
            depositTouched = false;
            advanceTouched = false;
        }

        function updateCustom() {
            var beds = parseInt(bedroomCount.value, 10);
            if (isNaN(beds) || beds < 1) beds = 1;
            unitTypeHidden.value = beds + '-Bedroom';
            capacityEl.value = beds * 2;
        }

        roomTypeSelect.addEventListener('change', function () {
            var choice = roomTypeSelect.value;
            if (choice === 'Custom') {
                bedroomWrap.style.display = '';
                updateCustom();
                rentEl.value = '';
                depositEl.value = '';
                advanceEl.value = '';
                depositTouched = false;
                advanceTouched = false;
            } else {
                bedroomWrap.style.display = 'none';
                unitTypeHidden.value = choice;
                if (presets[choice]) {
                    var p = presets[choice];
                    setPricing(p.rent, p.deposit, p.advance, p.capacity);
                }
            }
        });
        bedroomCount.addEventListener('input', updateCustom);

        rentEl.addEventListener('input', function () {
            var rent = parseFloat(this.value);
            if (isNaN(rent)) return;
            if (!depositTouched) depositEl.value = rent;
            if (!advanceTouched) advanceEl.value = rent;
        });

        // reflect the stored unit type in the dropdown without touching the saved pricing
        (function initRoomType() {
            var current = unitTypeHidden.value;
            if (current === 'Studio' || current === 'Bedspacer') {
                roomTypeSelect.value = current;
            } else if (/^\d+-Bedroom$/.test(current)) {
                roomTypeSelect.value = 'Custom';
                bedroomWrap.style.display = '';
                bedroomCount.value = parseInt(current, 10);
            }
        })();
    </script>
}
