@model YnclinoApartmentManagementSystem.Models.ViewModels.ReportsViewModel
@*
    Charts are drawn with plain inline SVG — no chart library and no internet
    needed, so the reports render the same on any machine, even offline.
*@

<div>

    @* ── Occupancy donut ── *@
    <div>
        <div>
            <div><span>Occupancy Rate</span></div>
            <div>
                @{
                    double circ = 2 * Math.PI * 54;                 // circumference of the ring
                    double filled = Model.OccupancyRate / 100.0 * circ;
                }
                <svg viewBox="0 0 140 140">
                    <circle cx="70" cy="70" r="54" fill="none" stroke="#e9ecef" stroke-width="16" />
                    <circle cx="70" cy="70" r="54" fill="none" stroke="#198754" stroke-width="16"
                            stroke-dasharray="@filled.ToString("F2") @circ.ToString("F2")"
                            stroke-linecap="round" transform="rotate(-90 70 70)" />
                    <text x="70" y="66" text-anchor="middle" font-size="24" font-weight="700" fill="#212529">
                        @Model.OccupancyRate.ToString("N0")%
                    </text>
                    <text x="70" y="86" text-anchor="middle" font-size="11" fill="#6c757d">occupied</text>
                </svg>
                <div>
                    @Model.OccupiedUnits of @Model.TotalUnits units
                </div>
            </div>
        </div>
    </div>

    @* ── Monthly income bar chart ── *@
    <div>
        <div>
            <div><span>Monthly Income (last 6 months)</span></div>
            <div>
                @{
                    var months = Model.MonthlyIncome;
                    decimal peak = months.Count == 0 ? 0m
                        : Math.Max(months.Max(x => x.Billed), months.Max(x => x.Collected));
                    if (peak <= 0) peak = 1m;
                    int slot = 60;      // horizontal space per month
                    int chartH = 130;   // pixel height of the tallest bar
                }
                @{
                    // Razor reserves <text> inside code blocks, so the bars are built
                    // as a string and written out with Html.Raw.
                    var svg = new System.Text.StringBuilder();
                    for (int i = 0; i < months.Count; i++)
                    {
                        var m = months[i];
                        int hBilled = (int)(m.Billed / peak * chartH);
                        int hPaid = (int)(m.Collected / peak * chartH);
                        int x = i * slot;
                        svg.Append($"<rect x='{x + 8}' y='{chartH - hBilled + 10}' width='18' height='{hBilled}' fill='#adb5bd' rx='2' />");
                        svg.Append($"<rect x='{x + 30}' y='{chartH - hPaid + 10}' width='18' height='{hPaid}' fill='#198754' rx='2' />");
                        svg.Append($"<text x='{x + 30}' y='{chartH + 26}' text-anchor='middle' font-size='10' fill='#6c757d'>{m.Month:MMM}</text>");
                        svg.Append($"<text x='{x + 30}' y='{chartH + 38}' text-anchor='middle' font-size='9' fill='#adb5bd'>{m.Month:yy}</text>");
                    }
                }
                <svg viewBox="0 0 @(Math.Max(months.Count,1) * slot) 170">
                    @Html.Raw(svg.ToString())
                </svg>
                <div>
                    <span>&nbsp;</span> Billed
                    <span>&nbsp;</span> Collected
                </div>
            </div>
        </div>
    </div>
</div>