@model YnclinoApartmentManagementSystem.Models.ViewModels.ReportsViewModel
@{
    ViewData["Title"] = "Reports & Records";
}

<div data-page-head>
    <div>
        <h3>Reports &amp; Records</h3>
        <div>Summary of apartment operations · viewable on screen only</div>
    </div>
    <span>As of @DateTime.Today.ToString("MMMM dd, yyyy")</span>
</div>

@* ── Headline figures ── *@
<div data-stats>
    <div>
        <div data-stat>
            <div>
                <div>Total Units</div>
                <div>@Model.TotalUnits</div>
                <div>@Model.OccupancyRate.ToString("N0")% occupied</div>
            </div>
        </div>
    </div>
    <div>
        <div data-stat>
            <div>
                <div>Income This Month</div>
                <div>₱@Model.IncomeThisMonth.ToString("N0")</div>
                <div>₱@Model.IncomeAllTime.ToString("N0") all time</div>
            </div>
        </div>
    </div>
    <div>
        <div data-stat>
            <div>
                <div>Outstanding</div>
                <div>₱@Model.OutstandingTotal.ToString("N0")</div>
                <div>@Model.OverdueTenants overdue tenant(s)</div>
            </div>
        </div>
    </div>
    <div>
        <div data-stat>
            <div>
                <div>Pending Requests</div>
                <div>@(Model.PendingMaintenance + Model.PendingTransfers + Model.OpenLostFound)</div>
                <div>
                    @Model.PendingMaintenance maintenance · @Model.PendingTransfers transfer · @Model.OpenLostFound lost &amp; found
                </div>
            </div>
        </div>
    </div>
</div>

@* ── Graphs ── *@
<partial name="_Charts" model="Model" />

<div>
    @* ── Occupancy report ── *@
    <div>
        <div data-panel>
            <div data-panel-head><span>Occupancy Report</span></div>
            <div data-panel-body>
                <table>
                    <tbody>
                        <tr><td>Occupied</td><td>@Model.OccupiedUnits</td></tr>
                        <tr><td>Available</td><td>@Model.AvailableUnits</td></tr>
                        <tr><td>Reserved</td><td>@Model.ReservedUnits</td></tr>
                        <tr><td>Under Maintenance</td><td>@Model.MaintenanceUnits</td></tr>
                        <tr><td>Total Units</td><td>@Model.TotalUnits</td></tr>
                    </tbody>
                </table>
                <div>
                    <div role="progressbar">
                        @Model.OccupancyRate.ToString("N0")%
                    </div>
                </div>
                <div>
                    Active tenants: <strong>@Model.ActiveTenants</strong> ·
                    Inactive: <strong>@Model.InactiveTenants</strong>
                </div>
            </div>
        </div>
    </div>

    @* ── Monthly income summary ── *@
    <div>
        <div data-panel>
            <div data-panel-head><span>Monthly Income Summary</span></div>
            <div data-panel-body>
                <table>
                    <thead>
                        <tr><th>Month</th><th>Billed</th><th>Collected</th><th>Uncollected</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.MonthlyIncome)
                        {
                            <tr>
                                <td>@m.Month.ToString("MMMM yyyy")</td>
                                <td>₱@m.Billed.ToString("N0")</td>
                                <td>₱@m.Collected.ToString("N0")</td>
                                <td>₱@m.Uncollected.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ── Standing balance, every tenant ──
       This used to list only the tenants who owed something, which made it
       impossible to check the ones who did not: a tenant missing from the
       report and a tenant who is square looked the same. Every tenant has a
       line now, the arithmetic on each line is shown in full — Billed − Paid =
       Balance — and the name opens that tenant's own billing record so the
       figures can be traced to the bills they came from. *@
    <div>
        <div data-panel>
            <div data-panel-head><span>Tenant Accounts &amp; Standing Balance</span></div>
            <div data-panel-body>
                <div data-table-wrap>
                <table>
                    <thead>
                        <tr>
                            <th>Tenant</th><th>Unit</th><th>Status</th>
                            <th>Bills</th><th>Billed</th><th>Paid</th>
                            <th>Advance</th><th>Balance</th>
                            <th>Overdue</th><th>Last Payment</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.TenantAccounts)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Billing" asp-action="TenantHistory" asp-route-id="@t.TenantID" data-record-link>@t.TenantName</a>
                                </td>
                                <td>@(t.UnitNumber ?? "—")</td>
                                <td>@t.Status</td>
                                <td>@t.BillsIssued</td>
                                <td>₱@t.Billed.ToString("N0")</td>
                                <td>₱@t.Paid.ToString("N0")</td>
                                <td>@(t.AdvanceCredit > 0 ? "₱" + t.AdvanceCredit.ToString("N0") : "—")</td>
                                <td>@(t.Balance > 0 ? "₱" + t.Balance.ToString("N0") : "Settled")</td>
                                <td>@(t.OverdueBills > 0 ? t.OverdueBills.ToString() : "—")</td>
                                <td>
                                    @if (t.LastPaymentDate.HasValue)
                                    {
                                        @($"{t.LastPaymentDate.Value:MMM dd, yyyy} · ₱{t.LastPaymentAmount:N0}")
                                    }
                                    else
                                    {
                                        <text>Never paid</text>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.TenantAccounts.Any())
                        {
                            <tr><td colspan="10">No tenants on record yet.</td></tr>
                        }
                    </tbody>
                    @if (Model.TenantAccounts.Any())
                    {
                        <tfoot>
                            <tr>
                                <th colspan="4">@Model.TenantAccounts.Count tenants</th>
                                <th>₱@Model.TenantAccounts.Sum(x => x.Billed).ToString("N0")</th>
                                <th>₱@Model.TenantAccounts.Sum(x => x.Paid).ToString("N0")</th>
                                <th>₱@Model.TenantAccounts.Sum(x => x.AdvanceCredit).ToString("N0")</th>
                                <th>₱@Model.TenantAccounts.Sum(x => x.Balance).ToString("N0")</th>
                                <th colspan="2">@Model.Outstanding.Count still owing</th>
                            </tr>
                        </tfoot>
                    }
                </table>
                </div>
            </div>
        </div>
    </div>

    @* ── Maintenance records ── *@
    <div>
        <div data-panel>
            <div data-panel-head><span>Maintenance Records</span></div>
            <div data-panel-body>
                <table>
                    <thead><tr><th>Status</th><th>Requests</th></tr></thead>
                    <tbody>
                        @foreach (var m in Model.MaintenanceByStatus)
                        {
                            <tr><td>@m.Status</td><td>@m.Count</td></tr>
                        }
                        @if (!Model.MaintenanceByStatus.Any())
                        {
                            <tr><td colspan="2">No maintenance requests yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div>
    @* ── Maintenance requests by issue type ── *@
    <div>
        <div data-panel>
            <div data-panel-head><span>Maintenance by Issue Type</span></div>
            <div data-panel-body>
                <table>
                    <thead>
                        <tr><th>Issue Type</th><th>Requests</th></tr>
                    </thead>
                    <tbody>
                        @{ int peakRequests = Model.MaintenanceByCategory.Count == 0 ? 1 : Math.Max(Model.MaintenanceByCategory.Max(c => c.Requests), 1); }
                        @foreach (var c in Model.MaintenanceByCategory)
                        {
                            <tr>
                                <td>
                                    @c.Category
                                    <div>
                                        <div></div>
                                    </div>
                                </td>
                                <td>@c.Requests</td>
                            </tr>
                        }
                        @if (!Model.MaintenanceByCategory.Any())
                        {
                            <tr><td colspan="2">No maintenance requests yet.</td></tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>Total requests</th>
                            <th>@Model.MaintenanceByCategory.Sum(c => c.Requests)</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    @* ── Tenant histories ── *@
    <div>
        <div data-panel>
            <div data-panel-head><span>Tenant Histories</span></div>
            <div data-panel-body>
                <div data-table-wrap>
                    <table>
                        <thead>
                            <tr>
                                <th>Tenant</th><th>Unit</th><th>Status</th>
                                <th>Move-In</th><th>Move-Out</th>
                                <th>Bills</th>
                                <th>Billed</th><th>Paid</th><th>Balance</th>
                                <th>Advance</th><th>Last Payment</th>
                                <th>Req.</th>
                            </tr>
                        </thead>
                        <tbody>
                            @* Billed sat behind this table rather than on it, so a row
                               read "Paid ₱27,500, Balance ₱2,500" with nothing to check
                               it against. Billed is on the line now: Billed − Paid is
                               the Balance, on every row, and the name opens the bills
                               those totals were added up from. *@
                            @foreach (var h in Model.TenantHistory)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Billing" asp-action="TenantHistory" asp-route-id="@h.TenantID" data-record-link>@h.TenantName</a>
                                    </td>
                                    <td>@(h.UnitNumber ?? "—")</td>
                                    <td><span>@h.Status</span></td>
                                    <td>@(h.MoveInDate?.ToString("MMM dd, yyyy") ?? "—")</td>
                                    <td>@(h.MoveOutDate?.ToString("MMM dd, yyyy") ?? "—")</td>
                                    <td>@h.MonthsBilled</td>
                                    <td>₱@h.TotalBilled.ToString("N0")</td>
                                    <td>₱@h.TotalPaid.ToString("N0")</td>
                                    <td>@(h.Balance > 0 ? "₱" + h.Balance.ToString("N0") : "Settled")</td>
                                    <td>@(h.AdvanceCredit > 0 ? "₱" + h.AdvanceCredit.ToString("N0") : "—")</td>
                                    <td>@(h.LastPaymentDate?.ToString("MMM dd, yyyy") ?? "—")</td>
                                    <td>@(h.MaintenanceRequests + h.TransferRequests)</td>
                                </tr>
                            }
                            @if (!Model.TenantHistory.Any())
                            {
                                <tr><td colspan="12">No tenants on record yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>