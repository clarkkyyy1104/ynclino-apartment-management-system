@model YnclinoApartmentManagementSystem.Models.ViewModels.ReportsViewModel
@{
    ViewData["Title"] = "Reports & Records";
}

<div data-page-head>
    <div>
        <h3>Reports &amp; Records</h3>
        <div>Summary of apartment operations · viewable on screen only</div>
    </div>
    <span>As of @DateTime.Today.ToString("MMMM dd, yyyy")</span>
</div>

@* ── Headline figures ── *@
<div data-stats>
    <div>
        <div data-stat>
            <div>
                <div>Total Units</div>
                <div>@Model.TotalUnits</div>
                <div>@Model.OccupancyRate.ToString("N0")% occupied</div>
            </div>
        </div>
    </div>
    <div>
        <div data-stat>
            <div>
                <div>Income This Month</div>
                <div>₱@Model.IncomeThisMonth.ToString("N0")</div>
                <div>₱@Model.IncomeAllTime.ToString("N0") all time</div>
            </div>
        </div>
    </div>
    <div>
        <div data-stat>
            <div>
                <div>Outstanding</div>
                <div>₱@Model.OutstandingTotal.ToString("N0")</div>
                <div>@Model.OverdueTenants overdue tenant(s)</div>
            </div>
        </div>
    </div>
    <div>
        <div data-stat>
            <div>
                <div>Pending Requests</div>
                <div>@(Model.PendingMaintenance + Model.PendingTransfers + Model.OpenLostFound)</div>
                <div>
                    @Model.PendingMaintenance maintenance · @Model.PendingTransfers transfer · @Model.OpenLostFound lost &amp; found
                </div>
            </div>
        </div>
    </div>
</div>

@* ── Graphs ── *@
<partial name="_Charts" model="Model" />

<div>
    @* ── Occupancy report ── *@
    <div>
        <div data-panel>
            <div data-panel-head><span>Occupancy Report</span></div>
            <div data-panel-body>
                <table>
                    <tbody>
                        <tr><td>Occupied</td><td>@Model.OccupiedUnits</td></tr>
                        <tr><td>Available</td><td>@Model.AvailableUnits</td></tr>
                        <tr><td>Reserved</td><td>@Model.ReservedUnits</td></tr>
                        <tr><td>Under Maintenance</td><td>@Model.MaintenanceUnits</td></tr>
                        <tr><td>Total Units</td><td>@Model.TotalUnits</td></tr>
                    </tbody>
                </table>
                <div>
                    <div role="progressbar">
                        @Model.OccupancyRate.ToString("N0")%
                    </div>
                </div>
                <div>
                    Active tenants: <strong>@Model.ActiveTenants</strong> ·
                    Inactive: <strong>@Model.InactiveTenants</strong>
                </div>
            </div>
        </div>
    </div>

    @* ── Monthly income summary ── *@
    <div>
        <div data-panel>
            <div data-panel-head><span>Monthly Income Summary</span></div>
            <div data-panel-body>
                <table>
                    <thead>
                        <tr><th>Month</th><th>Billed</th><th>Collected</th><th>Uncollected</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.MonthlyIncome)
                        {
                            <tr>
                                <td>@m.Month.ToString("MMMM yyyy")</td>
                                <td>₱@m.Billed.ToString("N0")</td>
                                <td>₱@m.Collected.ToString("N0")</td>
                                <td>₱@m.Uncollected.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ── Outstanding balances ── *@
    <div>
        <div data-panel>
            <div data-panel-head><span>Outstanding Balances</span></div>
            <div data-panel-body>
                <table>
                    <thead>
                        <tr><th>Tenant</th><th>Unit</th><th>Billed</th><th>Paid</th><th>Balance</th><th>Overdue</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Outstanding)
                        {
                            <tr>
                                <td>@t.TenantName</td>
                                <td>@(t.UnitNumber ?? "—")</td>
                                <td>₱@t.Billed.ToString("N0")</td>
                                <td>₱@t.Paid.ToString("N0")</td>
                                <td>₱@t.Balance.ToString("N0")</td>
                                <td>
                                    @if (t.OverdueBills > 0)
                                    {
                                        <span>@t.OverdueBills</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.Outstanding.Any())
                        {
                            <tr><td colspan="6">No outstanding balances — everyone is paid up.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ── Maintenance records ── *@
    <div>
        <div data-panel>
            <div data-panel-head><span>Maintenance Records</span></div>
            <div data-panel-body>
                <table>
                    <thead><tr><th>Status</th><th>Requests</th></tr></thead>
                    <tbody>
                        @foreach (var m in Model.MaintenanceByStatus)
                        {
                            <tr><td>@m.Status</td><td>@m.Count</td></tr>
                        }
                        @if (!Model.MaintenanceByStatus.Any())
                        {
                            <tr><td colspan="2">No maintenance requests yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div>
    @* ── Maintenance requests by issue type ── *@
    <div>
        <div data-panel>
            <div data-panel-head><span>Maintenance by Issue Type</span></div>
            <div data-panel-body>
                <table>
                    <thead>
                        <tr><th>Issue Type</th><th>Requests</th></tr>
                    </thead>
                    <tbody>
                        @{ int peakRequests = Model.MaintenanceByCategory.Count == 0 ? 1 : Math.Max(Model.MaintenanceByCategory.Max(c => c.Requests), 1); }
                        @foreach (var c in Model.MaintenanceByCategory)
                        {
                            <tr>
                                <td>
                                    @c.Category
                                    <div>
                                        <div></div>
                                    </div>
                                </td>
                                <td>@c.Requests</td>
                            </tr>
                        }
                        @if (!Model.MaintenanceByCategory.Any())
                        {
                            <tr><td colspan="2">No maintenance requests yet.</td></tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>Total requests</th>
                            <th>@Model.MaintenanceByCategory.Sum(c => c.Requests)</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    @* ── Tenant histories ── *@
    <div>
        <div data-panel>
            <div data-panel-head><span>Tenant Histories</span></div>
            <div data-panel-body>
                <div>
                    <table>
                        <thead>
                            <tr>
                                <th>Tenant</th><th>Unit</th><th>Status</th>
                                <th>Move-In</th><th>Move-Out</th>
                                <th>Months</th>
                                <th>Paid</th><th>Balance</th>
                                <th>Req.</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in Model.TenantHistory)
                            {
                                <tr>
                                    <td>@h.TenantName</td>
                                    <td>@(h.UnitNumber ?? "—")</td>
                                    <td><span>@h.Status</span></td>
                                    <td>@(h.MoveInDate?.ToString("MMM dd, yyyy") ?? "—")</td>
                                    <td>@(h.MoveOutDate?.ToString("MMM dd, yyyy") ?? "—")</td>
                                    <td>@h.MonthsBilled</td>
                                    <td>₱@h.TotalPaid.ToString("N0")</td>
                                    <td>₱@h.Balance.ToString("N0")</td>
                                    <td>@(h.MaintenanceRequests + h.TransferRequests)</td>
                                </tr>
                            }
                            @if (!Model.TenantHistory.Any())
                            {
                                <tr><td colspan="9">No tenants on record yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>