@model YnclinoApartmentManagementSystem.Models.tblUser
@{
    ViewData["Title"] = "User Management";
}

<div>
    <div>
        <div data-panel>
            <div data-panel-head>
                <h5>Delete Account</h5>
            </div>
            <div data-panel-body>
                <p>Are you sure you want to permanently delete this account?</p>

                <dl>
                    <dt>Username</dt>
                    <dd>@Model.Username</dd>
                    <dt>Role</dt>
                    <dd>@Model.Role</dd>
                    <dt>Status</dt>
                    <dd>@(Model.IsActive ? "Active" : "Inactive")</dd>
                    <dt>Created</dt>
                    <dd>@Model.DateCreated.ToString("MM/dd/yyyy")</dd>
                </dl>

                <div>
                    This permanently removes the account. If it has Lost &amp; Found records the delete will be blocked — deactivate the account instead.
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.UserID" />
                    <div data-actions-row>
                        <button type="submit" data-danger>Yes, Delete</button>
                        <a asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
