@model YnclinoApartmentManagementSystem.Models.ViewModels.UserViewModel
@{
    ViewData["Title"] = "Add User Account";
}

<div>
    <div>
        <div data-form-panel>
            <div data-form-head>
                <h5>User Management — Add Account</h5>
            </div>
            <div data-form-body data-cols="1">
                <form asp-action="Create" method="post" id="userForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly"></div>

                    <div>
                        <label asp-for="FirstName"></label>
                        <input asp-for="FirstName" autocomplete="given-name" />
                        <span asp-validation-for="FirstName"></span>
                    </div>

                    <div>
                        <label asp-for="LastName"></label>
                        <input asp-for="LastName" autocomplete="family-name" />
                        <span asp-validation-for="LastName"></span>
                    </div>

                    <div>
                        <label asp-for="ContactNumber"></label>
                        <input asp-for="ContactNumber" type="tel" autocomplete="tel" />
                        <span asp-validation-for="ContactNumber"></span>
                    </div>

                    <div>
                        <label asp-for="Username"></label>
                        <input asp-for="Username" autocomplete="username" />
                        <span asp-validation-for="Username"></span>
                    </div>

                    <div>
                        <label asp-for="Password"></label>
                        <div class="pw-wrap">
                            <input asp-for="Password" id="pw" autocomplete="new-password" oninput="checkStrength(this.value)" />
                            @await Html.PartialAsync("_PasswordToggle", "pw")
                        </div>
                        <span asp-validation-for="Password"></span>
                    </div>

                    <ul id="pwRules">
                        <li id="r-len"><span></span> At least 8 characters</li>
                        <li id="r-upper"><span></span> At least one uppercase letter</li>
                        <li id="r-lower"><span></span> At least one lowercase letter</li>
                        <li id="r-digit"><span></span> At least one number</li>
                        <li id="r-special"><span></span> At least one special character (!&#64;#$%^&amp;*)</li>
                    </ul>

                    <div>
                        <label asp-for="ConfirmPassword"></label>
                        <div class="pw-wrap">
                            <input asp-for="ConfirmPassword" id="cpw" autocomplete="new-password" />
                            @await Html.PartialAsync("_PasswordToggle", "cpw")
                        </div>
                        <span asp-validation-for="ConfirmPassword"></span>
                    </div>

                    <div>
                        <label asp-for="Role"></label>
                        <select asp-for="Role">
                            <option value="Admin">Administrator</option>
                            <option value="Maintenance">Maintenance Staff</option>
                        </select>
                        <div>
                            Maintenance Staff can only see the maintenance requests assigned to them.
                            To add a tenant account, go to the Tenants module.
                        </div>
                        <span asp-validation-for="Role"></span>
                    </div>

                    <div>
                        <input asp-for="IsActive" type="checkbox" />
                        <label asp-for="IsActive">Active</label>
                    </div>

                    <div data-actions-row>
                        <button type="submit">Create</button>
                        <a asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/password.js" asp-append-version="true"></script>
    <script>
        document.getElementById('userForm').addEventListener('submit', function (e) {
            var pw = document.getElementById('pw').value;
            if (!meetsAllRules(pw)) {
                e.preventDefault();
                document.getElementById('pwRules').classList.add('shake');
                setTimeout(() => document.getElementById('pwRules').classList.remove('shake'), 600);
            }
        });
    </script>
}
