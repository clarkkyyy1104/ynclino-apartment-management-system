@model YnclinoApartmentManagementSystem.Models.tblLostFoundItem
@{
    ViewData["Title"] = "Delete Item";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white fw-semibold">Confirm Delete</div>
            <div class="card-body">
                <p class="mb-1">Are you sure you want to delete this item report?</p>
                <dl class="row info-list mt-3">
                    <dt class="col-sm-5">Item Name</dt>
                    <dd class="col-sm-7">@Model.ItemName</dd>
                    <dt class="col-sm-5">Category</dt>
                    <dd class="col-sm-7">@Model.ItemType</dd>
                    <dt class="col-sm-5">Reported By</dt>
                    <dd class="col-sm-7">@(Model.ReportedBy?.DisplayName ?? "—")</dd>
                    <dt class="col-sm-5">Date Reported</dt>
                    <dd class="col-sm-7">@Model.DateReported.ToString("MMM dd, yyyy")</dd>
                </dl>
                <form asp-action="Delete" method="post" class="d-flex gap-2 mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.ItemID" />
                    <button type="submit" class="btn btn-danger btn-sm">Yes, Delete</button>
                    <a asp-action="Index" class="btn btn-secondary btn-sm">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
