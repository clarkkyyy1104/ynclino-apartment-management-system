@model YnclinoApartmentManagementSystem.Models.tblLostFoundItem
@{
    ViewData["Title"] = "Delete Item";
}

<div>
    <div>
        <div data-panel>
            <div data-panel-head>Confirm Delete</div>
            <div data-panel-body>
                <p>Are you sure you want to delete this item report?</p>
                <dl>
                    <dt>Item Name</dt>
                    <dd>@Model.ItemName</dd>
                    <dt>Category</dt>
                    <dd>@Model.ItemType</dd>
                    <dt>Reported By</dt>
                    <dd>@(Model.ReportedBy?.DisplayName ?? "—")</dd>
                    <dt>Date Reported</dt>
                    <dd>@Model.DateReported.ToString("MMM dd, yyyy")</dd>
                </dl>
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.ItemID" />
                    <button type="submit">Yes, Delete</button>
                    <a asp-action="Index">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
