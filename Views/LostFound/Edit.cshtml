@model YnclinoApartmentManagementSystem.Models.ViewModels.LostFoundViewModel
@{
    ViewData["Title"] = "Update Item";
}

<div>
    <div>
        <div data-form-panel>
            <div data-form-head>Update Item Report</div>
            <div data-form-body>
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ItemID" />
                    <input type="hidden" asp-for="ReportedByUserID" />
                    <input type="hidden" asp-for="ReportedByName" />
                    <div asp-validation-summary="ModelOnly"></div>

                    @if (!string.IsNullOrEmpty(Model.ReportedByName))
                    {
                        <p>Reported by: <strong>@Model.ReportedByName</strong></p>
                    }

                    <div>
                        <label asp-for="ItemType"></label>
                        <select asp-for="ItemType">
                            <option>Lost</option>
                            <option>Found</option>
                        </select>
                    </div>

                    <div>
                        <label asp-for="ItemName"></label>
                        <input asp-for="ItemName" />
                        <span asp-validation-for="ItemName"></span>
                    </div>

                    <div>
                        <label asp-for="Description"></label>
                        <textarea asp-for="Description" rows="2"></textarea>
                    </div>

                    <div>
                        <label asp-for="Location"></label>
                        <input asp-for="Location" />
                    </div>

                    <div>
                        <label asp-for="Status"></label>
                        @{
                            var allowed = ViewBag.AllowedStatuses as List<string> ?? new List<string> { "Reported", "Claimed"};
                        }
                        <select asp-for="Status" id="statusSelect">
                            @foreach (var st in allowed)
                            {
                                <option value="@st">@st</option>
                            }
                        </select>
                    </div>

                    @* An item marked Claimed must say WHO collected it — "Claimed" on
                       its own tells the admin nothing a month later. *@
                    <div id="claimedByWrap">
                        <label asp-for="ClaimedByUserID"></label>
                        <select asp-for="ClaimedByUserID" asp-items="Model.AvailableTenants">
                            <option value="0">— Select tenant —</option>
                        </select>
                        <div>The tenant who collected this item.</div>
                        <span asp-validation-for="ClaimedByUserID"></span>
                    </div>

                    <div>
                        <label asp-for="ImageUpload"></label>
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <div>
                                <img src="@Model.ImagePath" alt="Current photo" />
                            </div>
                        }
                        <input asp-for="ImageUpload" type="file" accept="image/*" />
                        <div>Upload to replace the current photo. JPG, PNG, GIF, or WEBP — up to 5 MB.</div>
                        <span asp-validation-for="ImageUpload"></span>
                    </div>

                    <div>
                        <button type="submit">Save Changes</button>
                        <a asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // the claimant only matters once the item is being marked Claimed
        var statusSel = document.getElementById('statusSelect');
        var claimedWrap = document.getElementById('claimedByWrap');
        function toggleClaimedBy() {
            claimedWrap.style.display = (statusSel.value === 'Claimed') ? '' : 'none';
        }
        statusSel.addEventListener('change', toggleClaimedBy);
        toggleClaimedBy();
    </script>
}
