@model YnclinoApartmentManagementSystem.Models.ViewModels.LostFoundViewModel
@{
    ViewData["Title"] = "Update Item";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-secondary text-white fw-semibold">Update Item Report</div>
            <div class="card-body">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ItemID" />
                    <input type="hidden" asp-for="ReportedByUserID" />
                    <input type="hidden" asp-for="ReportedByName" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    @if (!string.IsNullOrEmpty(Model.ReportedByName))
                    {
                        <p class="text-muted small mb-3">Reported by: <strong>@Model.ReportedByName</strong></p>
                    }

                    <div class="mb-3">
                        <label asp-for="ItemType" class="form-label fw-semibold small"></label>
                        <select asp-for="ItemType" class="form-select">
                            <option>Lost</option>
                            <option>Found</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ItemName" class="form-label fw-semibold small"></label>
                        <input asp-for="ItemName" class="form-control" />
                        <span asp-validation-for="ItemName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold small"></label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Location" class="form-label fw-semibold small"></label>
                        <input asp-for="Location" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-semibold small"></label>
                        @{
                            var allowed = ViewBag.AllowedStatuses as List<string> ?? new List<string> { "Reported", "Claimed"};
                        }
                        <select asp-for="Status" class="form-select">
                            @foreach (var st in allowed)
                            {
                                <option value="@st">@st</option>
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ImageUpload" class="form-label fw-semibold small"></label>
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <div class="mb-2">
                                <img src="@Model.ImagePath" alt="Current photo" class="img-fluid rounded border" style="max-height:160px" />
                            </div>
                        }
                        <input asp-for="ImageUpload" class="form-control" type="file" accept="image/*" />
                        <div class="form-text text-muted small">Upload to replace the current photo. JPG, PNG, GIF, or WEBP — up to 5 MB.</div>
                        <span asp-validation-for="ImageUpload" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm">Save Changes</button>
                        <a asp-action="Index" class="btn btn-secondary btn-sm">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
