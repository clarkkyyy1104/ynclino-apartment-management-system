@model YnclinoApartmentManagementSystem.Models.tblLostFoundItem
@{
    ViewData["Title"] = "Item Details";
}

<div>
    <div>
        <div data-panel>
            <div data-panel-head>
                @Model.ItemType Item — @Model.ItemName
            </div>
            <div data-panel-body>
                <dl>
                    <dt>Item Name</dt>
                    <dd>@Model.ItemName</dd>

                    <dt>Category</dt>
                    <dd>
                        <span>
                            @Model.ItemType
                        </span>
                    </dd>

                    <dt>Description</dt>
                    <dd>@(Model.Description ?? "—")</dd>

                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <dt>Photo</dt>
                        <dd>
                            <a href="@Model.ImagePath" target="_blank">
                                <img src="@Model.ImagePath" alt="Item photo" />
                            </a>
                        </dd>
                    }

                    <dt>Location</dt>
                    <dd>@(Model.Location ?? "—")</dd>

                    <dt>Status</dt>
                    <dd>
                        <span>@Model.Status</span>
                    </dd>

                    @if (Model.Status == "Claimed")
                    {
                        <dt>Claimed By</dt>
                        <dd>@(Model.ClaimedBy?.DisplayName ?? "—")</dd>

                        <dt>Date Claimed</dt>
                        <dd>@(Model.DateClaimed?.ToString("MMM dd, yyyy hh:mm tt") ?? "—")</dd>
                    }

                    <dt>Reported By</dt>
                    <dd>@(Model.ReportedBy?.DisplayName ?? "—")</dd>

                    <dt>Date Reported</dt>
                    <dd>@Model.DateReported.ToString("MMM dd, yyyy hh:mm tt")</dd>

                </dl>

                @if (User.IsInRole("Admin"))
                {
                    var claims = ViewBag.Claims as IEnumerable<YnclinoApartmentManagementSystem.Models.tblClaimRequest> ?? new List<YnclinoApartmentManagementSystem.Models.tblClaimRequest>();
                    if (claims.Any())
                    {
                        <hr />
                        <h6>Ownership Claims</h6>
                        @foreach (var claim in claims)
                        {
                            <div>
                                <div>
                                    <span>@(claim.Claimant?.DisplayName ?? "—")</span>
                                    <span>@claim.Status</span>
                                </div>
                                <p>@claim.VerificationDetails</p>
                                @if (!string.IsNullOrEmpty(claim.ImagePath))
                                {
                                    <a href="@claim.ImagePath" target="_blank">
                                        <img src="@claim.ImagePath" alt="Proof photo" />
                                    </a>
                                }
                                <p>Submitted: @claim.SubmittedAt.ToString("MMM dd, yyyy hh:mm tt")</p>
                                @if (claim.Status == "Pending")
                                {
                                    <form asp-action="ReviewClaim" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="claimId" value="@claim.ClaimID" />
                                        <div data-actions-row>
                                            <button type="submit" name="decision" value="Approved">Approve</button>
                                            <button type="submit" name="decision" value="Rejected">Reject</button>
                                        </div>
                                    </form>
                                }
                            </div>
                        }
                    }
                }

                @if (User.IsInRole("Tenant"))
                {
                    var myClaims = ViewBag.MyClaims as IEnumerable<YnclinoApartmentManagementSystem.Models.tblClaimRequest> ?? new List<YnclinoApartmentManagementSystem.Models.tblClaimRequest>();
                    if (myClaims.Any())
                    {
                        <hr />
                        <h6>My Claim</h6>
                        @foreach (var claim in myClaims)
                        {
                            <div>
                                <div>
                                    <span>Submitted @claim.SubmittedAt.ToString("MMM dd, yyyy")</span>
                                    <span>@claim.Status</span>
                                </div>
                                <p>@claim.VerificationDetails</p>
                                @if (!string.IsNullOrEmpty(claim.ImagePath))
                                {
                                    <a href="@claim.ImagePath" target="_blank">
                                        <img src="@claim.ImagePath" alt="Proof photo" />
                                    </a>
                                }
                            </div>
                        }
                    }
                }

                <div data-actions-row>
                    <a asp-action="Index">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
