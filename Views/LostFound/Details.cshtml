@model YnclinoApartmentManagementSystem.Models.tblLostFoundItem
@{
    ViewData["Title"] = "Item Details";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white fw-semibold">
                @Model.ItemType Item — @Model.ItemName
            </div>
            <div class="card-body">
                <dl class="row info-list">
                    <dt class="col-sm-4">Item Name</dt>
                    <dd class="col-sm-8">@Model.ItemName</dd>

                    <dt class="col-sm-4">Category</dt>
                    <dd class="col-sm-8">
                        <span class="badge @(Model.ItemType == "Lost" ? "bg-danger" : "bg-info text-dark")">
                            @Model.ItemType
                        </span>
                    </dd>

                    <dt class="col-sm-4">Description</dt>
                    <dd class="col-sm-8">@(Model.Description ?? "—")</dd>

                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <dt class="col-sm-4">Photo</dt>
                        <dd class="col-sm-8">
                            <a href="@Model.ImagePath" target="_blank">
                                <img src="@Model.ImagePath" alt="Item photo" class="img-fluid rounded border" style="max-height:220px" />
                            </a>
                        </dd>
                    }

                    <dt class="col-sm-4">Location</dt>
                    <dd class="col-sm-8">@(Model.Location ?? "—")</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @{
                            var sbadge = Model.Status switch {
                                "Resolved" => "bg-success",
                                _          => "bg-warning text-dark"
                            };
                        }
                        <span class="badge @sbadge">@Model.Status</span>
                    </dd>

                    <dt class="col-sm-4">Date Reported</dt>
                    <dd class="col-sm-8">@Model.DateReported.ToString("MMM dd, yyyy hh:mm tt")</dd>

                    <dt class="col-sm-4">Notes</dt>
                    <dd class="col-sm-8">@(Model.Notes ?? "—")</dd>
                </dl>

                <div class="d-flex gap-2 mt-3">
                    @if (Model.Status != "Resolved")
                    {
                        <form asp-action="Resolve" asp-route-id="@Model.ItemID" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-success btn-sm">Mark Resolved</button>
                        </form>
                    }
                    <a asp-action="Edit" asp-route-id="@Model.ItemID" class="btn btn-outline-primary btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@Model.ItemID" class="btn btn-outline-danger btn-sm">Delete</a>
                    <a asp-action="Index" class="btn btn-secondary btn-sm">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
