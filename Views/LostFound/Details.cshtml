@model YnclinoAMS.Models.tblLostFoundItem
@{
    ViewData["Title"] = "Item Details";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white fw-semibold">
                @Model.ItemType Item — @Model.ItemName
            </div>
            <div class="card-body">
                <dl class="row info-list">
                    <dt class="col-sm-4">Item Name</dt>
                    <dd class="col-sm-8">@Model.ItemName</dd>

                    <dt class="col-sm-4">Type</dt>
                    <dd class="col-sm-8">
                        <span class="badge @(Model.ItemType == "Lost" ? "bg-danger" : "bg-info text-dark")">
                            @Model.ItemType
                        </span>
                    </dd>

                    <dt class="col-sm-4">Description</dt>
                    <dd class="col-sm-8">@(Model.Description ?? "—")</dd>

                    <dt class="col-sm-4">Location</dt>
                    <dd class="col-sm-8">@(Model.Location ?? "—")</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @{
                            var sbadge = Model.Status switch {
                                "Resolved" => "bg-success",
                                "Claimed"  => "bg-primary",
                                _          => "bg-warning text-dark"
                            };
                        }
                        <span class="badge @sbadge">@Model.Status</span>
                    </dd>

                    <dt class="col-sm-4">Reported By</dt>
                    <dd class="col-sm-8">@(Model.ReportedBy?.Username ?? "—")</dd>

                    <dt class="col-sm-4">Date Reported</dt>
                    <dd class="col-sm-8">@Model.DateReported.ToString("MMM dd, yyyy hh:mm tt")</dd>

                    <dt class="col-sm-4">Notes</dt>
                    <dd class="col-sm-8">@(Model.Notes ?? "—")</dd>
                </dl>

                @if (User.IsInRole("Admin") || User.IsInRole("SemiAdmin"))
                {
                    var claims = ViewBag.Claims as IEnumerable<YnclinoAMS.Models.tblClaimRequest> ?? new List<YnclinoAMS.Models.tblClaimRequest>();
                    if (claims.Any())
                    {
                        <hr />
                        <h6 class="fw-semibold mb-2">Ownership Claims</h6>
                        @foreach (var claim in claims)
                        {
                            <div class="border rounded p-3 mb-2 @(claim.Status == "Pending" ? "border-warning" : claim.Status == "Approved" ? "border-success" : "border-secondary")">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <span class="fw-semibold small">@(claim.Claimant?.Username ?? "—")</span>
                                    <span class="badge @(claim.Status == "Pending" ? "bg-warning text-dark" : claim.Status == "Approved" ? "bg-success" : "bg-secondary")">@claim.Status</span>
                                </div>
                                <p class="small mb-1">@claim.VerificationDetails</p>
                                <p class="text-muted small mb-2">Submitted: @claim.SubmittedAt.ToString("MMM dd, yyyy hh:mm tt")</p>
                                @if (claim.Status == "Pending")
                                {
                                    <div class="d-flex gap-2">
                                        <form asp-action="ReviewClaim" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="claimId" value="@claim.ClaimID" />
                                            <input type="hidden" name="decision" value="Approved" />
                                            <button type="submit" class="btn btn-success btn-sm">Approve</button>
                                        </form>
                                        <form asp-action="ReviewClaim" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="claimId" value="@claim.ClaimID" />
                                            <input type="hidden" name="decision" value="Rejected" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">Reject</button>
                                        </form>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(claim.AdminNotes))
                                {
                                    <p class="text-muted small mt-1 mb-0">Note: @claim.AdminNotes</p>
                                }
                            </div>
                        }
                    }
                }

                <div class="d-flex gap-2 mt-3">
                    @if (User.IsInRole("Admin") || User.IsInRole("SemiAdmin"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.ItemID" class="btn btn-primary btn-sm">Edit</a>
                    }
                    <a asp-action="Index" class="btn btn-secondary btn-sm">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
