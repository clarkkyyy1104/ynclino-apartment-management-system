@model YnclinoApartmentManagementSystem.Models.ViewModels.LostFoundViewModel
@{
    ViewData["Title"] = "Report Item";
}

<div>
    <div>
        <div data-form-panel>
            <div data-form-head>Report Lost or Found Item</div>
            <div data-form-body>
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly"></div>

                    <div>
                        <label asp-for="ItemType"></label>
                        <select asp-for="ItemType" required>
                            <option value="">— Select —</option>
                            <option>Lost</option>
                            <option>Found</option>
                        </select>
                        <span asp-validation-for="ItemType"></span>
                    </div>

                    <div>
                        <label asp-for="ItemName"></label>
                        <input asp-for="ItemName" placeholder="e.g. Black Wallet, Phone Charger" />
                        <span asp-validation-for="ItemName"></span>
                    </div>

                    <div>
                        <label asp-for="Description"></label>
                        <textarea asp-for="Description" rows="2"
                                  placeholder="Color, brand, distinguishing features…"></textarea>
                        <span asp-validation-for="Description"></span>
                    </div>

                    <div>
                        <label asp-for="Location"></label>
                        <input asp-for="Location" placeholder="e.g. Lobby, Floor 2 hallway" />
                        <span asp-validation-for="Location"></span>
                    </div>

                    <div>
                        <label asp-for="ImageUpload"></label>
                        <input asp-for="ImageUpload" type="file" accept="image/*" />
                        <div>JPG, PNG, GIF, or WEBP — up to 5 MB.</div>
                        <span asp-validation-for="ImageUpload"></span>
                    </div>

                    <div data-actions-row>
                        <button type="submit">Submit Report</button>
                        <a asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
