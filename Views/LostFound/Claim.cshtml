@{
    ViewData["Title"] = "Claim Found Item";
    var item = (YnclinoApartmentManagementSystem.Models.tblLostFoundItem)ViewBag.Item;
}

<div>
    <div>
        <div data-form-panel>
            <div data-form-head>Claim Found Item — @item.ItemName</div>
            <div data-form-body>
                <div>
                    <strong>How this works:</strong> Describe how you can prove this item is yours (colour, markings, contents, where you lost it, etc.). An admin will verify your claim before confirming.
                </div>

                <dl>
                    <dt>Item</dt><dd>@item.ItemName</dd>
                    <dt>Description</dt><dd>@(item.Description ?? "—")</dd>
                    <dt>Found at</dt><dd>@(item.Location ?? "—")</dd>
                </dl>

                <form asp-action="Claim" asp-route-id="@item.ItemID" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div>
                        <label>Proof of Ownership <span>*</span></label>
                        <textarea name="verificationDetails" rows="5" required
                                  placeholder="Describe unique details that prove this item belongs to you…"></textarea>
                    </div>
                    <div>
                        <label>Proof Photo <span>(optional)</span></label>
                        <input type="file" name="proofImage" accept="image/*" />
                        <div>Attach a photo that helps prove the item is yours (e.g. a picture of the item, a receipt).</div>
                    </div>
                    <div>
                        <button type="submit">Claim</button>
                        <a asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
