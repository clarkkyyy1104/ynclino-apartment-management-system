@model YnclinoApartmentManagementSystem.Models.ViewModels.BillingViewModel
@{
    ViewData["Title"] = "Update Payment";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white fw-semibold">
                Update Payment — @Model.TenantName · @Model.BillingPeriod.ToString("MMMM yyyy")
            </div>
            <div class="card-body">

                <div class="row g-2 mb-3">
                    <div class="col-4">
                        <div class="border rounded p-2 text-center h-100">
                            <div class="text-muted small">Monthly Rent</div>
                            <div class="fw-bold">₱@Model.TenantRent.ToString("N0")</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="border rounded p-2 text-center h-100">
                            <div class="text-muted small">Already Paid</div>
                            <div class="fw-bold text-success">₱@Model.AlreadyPaid.ToString("N0")</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="border rounded p-2 text-center h-100">
                            <div class="text-muted small">Remaining</div>
                            <div class="fw-bold text-danger">₱@Model.RemainingBalance.ToString("N0")</div>
                        </div>
                    </div>
                </div>

                <form asp-action="Edit" asp-route-id="@Model.BillingID" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="BillingID" />
                    <input type="hidden" asp-for="TenantID" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="AmountPaid" class="form-label fw-semibold small">Additional Payment</label>
                        <div class="input-group">
                            <span class="input-group-text">₱</span>
                            <input asp-for="AmountPaid" type="number" min="1" step="1" class="form-control" placeholder="0" />
                        </div>
                        <div class="form-text text-muted small">
                            Paying more than ₱@Model.RemainingBalance.ToString("N0") fully settles this bill, and the extra
                            automatically starts a new bill for the next month.
                        </div>
                        <span asp-validation-for="AmountPaid" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PaymentMethod" class="form-label fw-semibold small"></label>
                        <select asp-for="PaymentMethod" class="form-select">
                            <option value="">— Select method —</option>
                            <option value="Cash">Cash</option>
                            <option value="GCash">GCash</option>
                        </select>
                        <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm">Record Payment</button>
                        <a asp-action="Index" class="btn btn-secondary btn-sm">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
