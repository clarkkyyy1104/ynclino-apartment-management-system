@model YnclinoApartmentManagementSystem.Models.ViewModels.BillingViewModel
@{
    ViewData["Title"] = "Update Bill";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-secondary text-white fw-semibold">Update Bill</div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="BillingID" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="TenantID" class="form-label fw-semibold small"></label>
                        <select asp-for="TenantID" asp-items="Model.AvailableTenants" class="form-select">
                            <option value="">— Select Tenant —</option>
                        </select>
                        <span asp-validation-for="TenantID" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="BillingPeriod" class="form-label fw-semibold small">Billing Period (Month)</label>
                            <input asp-for="BillingPeriod" type="month" class="form-control"
                                   value="@Model.BillingPeriod.ToString("yyyy-MM")" />
                            <span asp-validation-for="BillingPeriod" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DueDate" class="form-label fw-semibold small"></label>
                            <input asp-for="DueDate" type="date" class="form-control" />
                            <span asp-validation-for="DueDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AmountDue" class="form-label fw-semibold small"></label>
                        <div class="input-group">
                            <span class="input-group-text">₱</span>
                            <input asp-for="AmountDue" type="number" min="1" step="1000" class="form-control" />
                        </div>
                        <span asp-validation-for="AmountDue" class="text-danger small"></span>
                    </div>

                    @* running totals — computed from the payments below, never typed *@
                    <div class="row g-2 mb-3 text-center">
                        <div class="col-4">
                            <div class="border rounded py-2">
                                <div class="small text-muted">Amount Due</div>
                                <div class="fw-bold">₱@Model.AmountDue.ToString("N2")</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border rounded py-2">
                                <div class="small text-muted">Total Paid</div>
                                <div class="fw-bold text-success">₱@Model.TotalPaid.ToString("N2")</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border rounded py-2">
                                <div class="small text-muted">Balance</div>
                                <div class="fw-bold @(Model.Balance > 0 ? "text-danger" : "text-muted")">₱@Model.Balance.ToString("N2")</div>
                            </div>
                        </div>
                    </div>

                    @if (Model.Balance <= 0)
                    {
                        <div class="alert alert-success py-2 small mb-3">
                            This bill is fully settled — no further payment is needed.
                        </div>
                    }
                    else
                    {
                        <h6 class="section-label mb-2">Record a Payment</h6>
                        <p class="form-text mt-0 mb-2">
                            Enter only what the tenant just paid. It is <strong>added</strong> to the total above,
                            and the balance and status update automatically.
                        </p>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="PaymentAmount" class="form-label fw-semibold small"></label>
                                <div class="input-group">
                                    <span class="input-group-text">₱</span>
                                    <input asp-for="PaymentAmount" type="number" min="1" step="1000"
                                           max="@Model.Balance" class="form-control"
                                           placeholder="— leave blank if none" />
                                </div>
                                <div class="form-text text-muted small">Maximum: ₱@Model.Balance.ToString("N2")</div>
                                <span asp-validation-for="PaymentAmount" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PaymentDate" class="form-label fw-semibold small"></label>
                                <input asp-for="PaymentDate" type="date" class="form-control" />
                                <span asp-validation-for="PaymentDate" class="text-danger small"></span>
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Status</label>
                        <p class="form-text mb-0">
                            The status is set automatically from the total paid and the due date —
                            <strong>Paid</strong> (paid in full), <strong>Partial</strong> (part paid),
                            <strong>Unpaid</strong> (nothing paid, not yet due), or
                            <strong>Overdue</strong> (past due and not fully paid).
                        </p>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm">Save Changes</button>
                        <a asp-action="Index" class="btn btn-secondary btn-sm">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
