@model YnclinoApartmentManagementSystem.Models.ViewModels.BillingViewModel
@{
    ViewData["Title"] = "Update Bill";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-secondary text-white fw-semibold">Update Bill</div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="BillingID" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="TenantID" class="form-label fw-semibold small"></label>
                        <select asp-for="TenantID" asp-items="Model.AvailableTenants" class="form-select">
                            <option value="">— Select Tenant —</option>
                        </select>
                        <span asp-validation-for="TenantID" class="text-danger small"></span>
                    </div>

                    @* Bill details are fixed when the bill is issued — shown here, never edited *@
                    <div class="row mb-2">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Billing Period (Month)</label>
                            <input class="form-control bg-light" value="@Model.BillingPeriod.ToString("MMMM yyyy")" disabled />
                            <input type="hidden" asp-for="BillingPeriod" value="@Model.BillingPeriod.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Due Date</label>
                            <input class="form-control bg-light" value="@Model.DueDate.ToString("MMM dd, yyyy")" disabled />
                            <input type="hidden" asp-for="DueDate" value="@Model.DueDate.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    @* carried so model validation still passes; the controller ignores it *@
                    <input type="hidden" asp-for="AmountDue" />
                    <p class="form-text mt-0 mb-3">
                        The billing month, due date and bill amount are set when the bill is issued and cannot be changed here.
                    </p>

                    @* running totals — computed from the payments below, never typed *@
                    <div class="row g-2 mb-3 text-center">
                        <div class="col-4">
                            <div class="border rounded py-2">
                                <div class="small text-muted">Amount Due</div>
                                <div class="fw-bold">₱@Model.AmountDue.ToString("N0")</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border rounded py-2">
                                <div class="small text-muted">Total Paid</div>
                                @* the full amount received, then where it went *@
                                <div class="fw-bold money-paid">₱@Model.TotalReceived.ToString("N0")</div>
                                @if (Model.AdvanceFromOverpayment > 0)
                                {
                                    <div class="money-dest small">
                                        ₱@Model.TotalPaid.ToString("N0") rent ·
                                        ₱@Model.AdvanceFromOverpayment.ToString("N0") advance
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border rounded py-2">
                                <div class="small text-muted">Balance</div>
                                <div class="fw-bold @(Model.Balance > 0 ? "text-danger" : "text-muted")">₱@Model.Balance.ToString("N0")</div>
                            </div>
                        </div>
                    </div>

                    @if (Model.Deposit > 0 || Model.Advance > 0)
                    {
                        <p class="form-text mt-0 mb-3">
                            This bill includes a
                            <span class="money-deposit">₱@Model.Deposit.ToString("N0")</span> deposit
                            (held until the tenant moves out) and
                            <span class="money-dest">₱@Model.Advance.ToString("N0")</span> advance payment.
                        </p>
                    }

                    @if (Model.AdvanceCredit > 0)
                    {
                        <div class="alert alert-info py-2 small mb-3">
                            This tenant is holding <strong>₱@Model.AdvanceCredit.ToString("N0")</strong>
                            in advance payment. It is applied automatically to their next bill.
                        </div>
                    }

                    @if (Model.Balance <= 0)
                    {
                        <div class="alert alert-success py-2 small mb-3">
                            This bill is fully settled — no further payment is needed.
                        </div>
                    }
                    else
                    {
                        <h6 class="section-label mb-2">Record a Payment</h6>
                        <p class="form-text mt-0 mb-2">
                            Enter only what the tenant just paid. It is <strong>added</strong> to the total above,
                            and the balance and status update automatically.
                        </p>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="PaymentAmount" class="form-label fw-semibold small"></label>
                                <div class="input-group">
                                    <span class="input-group-text">₱</span>
                                    <input asp-for="PaymentAmount" type="number" min="0" step="1"
                                           class="form-control"
                                           placeholder="— leave blank if none" />
                                </div>
                                <div class="form-text text-muted small">
                                    Balance: ₱@Model.Balance.ToString("N0"). Paying more is fine — the extra
                                    settles other unpaid bills, then becomes advance payment.
                                </div>
                                <span asp-validation-for="PaymentAmount" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Date Paid</label>
                                <input class="form-control bg-light" value="@DateTime.Today.ToString("MMM dd, yyyy")" disabled />
                                <div class="form-text text-muted small">Recorded as today automatically.</div>
                            </div>
                        </div>
                    }

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm">Save Changes</button>
                        <a asp-action="Index" class="btn btn-secondary btn-sm">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
