@model YnclinoApartmentManagementSystem.Models.ViewModels.BillingViewModel
@{
    ViewData["Title"] = "Update Bill";
}

<div>
    <div>
        <div data-form-panel>
            <div data-form-head>Update Bill</div>
            <div data-form-body>
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="BillingID" />
                    <div asp-validation-summary="ModelOnly"></div>

                    <div>
                        <label asp-for="TenantID"></label>
                        <select asp-for="TenantID" asp-items="Model.AvailableTenants">
                            <option value="">— Select Tenant —</option>
                        </select>
                        <span asp-validation-for="TenantID"></span>
                    </div>

                    @* Bill details are fixed when the bill is issued — shown here, never edited *@
                    <div>
                        <div>
                            <label>Billing Period (Month)</label>
                            <input value="@Model.BillingPeriod.ToString("MMMM yyyy")" disabled />
                            <input type="hidden" asp-for="BillingPeriod" value="@Model.BillingPeriod.ToString("yyyy-MM-dd")" />
                        </div>
                        <div>
                            <label>Due Date</label>
                            <input value="@Model.DueDate.ToString("MMM dd, yyyy")" disabled />
                            <input type="hidden" asp-for="DueDate" value="@Model.DueDate.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    @* carried so model validation still passes; the controller ignores it *@
                    <input type="hidden" asp-for="AmountDue" />
                    <p>
                        The billing month, due date and bill amount are set when the bill is issued and cannot be changed here.
                    </p>

                    @* running totals — computed from the payments below, never typed *@
                    <div>
                        <div>
                            <div>
                                <div>Amount Due</div>
                                <div>₱@Model.AmountDue.ToString("N0")</div>
                            </div>
                        </div>
                        <div>
                            <div>
                                <div>Total Paid</div>
                                @* the full amount received, then where it went *@
                                <div>₱@Model.TotalReceived.ToString("N0")</div>
                                @if (Model.AdvanceFromOverpayment > 0)
                                {
                                    <div>
                                        <span>₱@Model.TotalPaid.ToString("N0") rent</span>
                                        <span>·</span>
                                        <span>₱@Model.AdvanceFromOverpayment.ToString("N0") advance</span>
                                    </div>
                                }
                            </div>
                        </div>
                        <div>
                            <div>
                                <div>Balance</div>
                                <div>₱@Model.Balance.ToString("N0")</div>
                            </div>
                        </div>
                    </div>

                    @if (Model.Deposit > 0 || Model.Advance > 0)
                    {
                        <p>
                            This bill includes a
                            <span>₱@Model.Deposit.ToString("N0")</span> deposit
                            (held until the tenant moves out) and
                            <span>₱@Model.Advance.ToString("N0")</span> advance payment.
                        </p>
                    }

                    @if (Model.AdvanceCredit > 0)
                    {
                        <div>
                            This tenant is holding <strong>₱@Model.AdvanceCredit.ToString("N0")</strong>
                            in advance payment. It is applied automatically to their next bill.
                        </div>
                    }

                    @if (Model.Balance <= 0)
                    {
                        <div>
                            This bill is fully settled — no further payment is needed.
                        </div>
                    }
                    else
                    {
                        <h6>Record a Payment</h6>
                        <p>
                            Enter only what the tenant just paid. It is <strong>added</strong> to the total above,
                            and the balance and status update automatically.
                        </p>

                        <div>
                            <div>
                                <label asp-for="PaymentAmount"></label>
                                <div>
                                    <span>₱</span>
                                    <input asp-for="PaymentAmount" type="number" min="0" step="1"
                                           placeholder="— leave blank if none" />
                                </div>
                                <div>
                                    Balance: ₱@Model.Balance.ToString("N0"). Paying more is fine — the extra
                                    settles other unpaid bills, then becomes advance payment.
                                </div>
                                <span asp-validation-for="PaymentAmount"></span>
                            </div>
                            <div>
                                <label>Date Paid</label>
                                <input value="@DateTime.Today.ToString("MMM dd, yyyy")" disabled />
                                <div>Recorded as today automatically.</div>
                            </div>
                        </div>
                    }

                    <div>
                        <button type="submit">Save Changes</button>
                        <a asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
