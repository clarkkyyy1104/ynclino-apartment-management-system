@model YnclinoApartmentManagementSystem.Models.tblBilling
@{
    ViewData["Title"] = "Delete Bill";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white fw-semibold">Confirm Delete</div>
            <div class="card-body">
                <p class="mb-1">Are you sure you want to delete this payment record?</p>
                <dl class="row info-list mt-3">
                    <dt class="col-sm-5">Tenant</dt>
                    <dd class="col-sm-7">@Model.Tenant?.FullName</dd>
                    <dt class="col-sm-5">Billing Period</dt>
                    <dd class="col-sm-7">@Model.BillingPeriod.ToString("MMMM yyyy")</dd>
                    <dt class="col-sm-5">Amount Paid</dt>
                    <dd class="col-sm-7">₱@Model.AmountPaid.ToString("N2")</dd>
                    <dt class="col-sm-5">Method</dt>
                    <dd class="col-sm-7">@(string.IsNullOrEmpty(Model.PaymentMethod) ? "—" : Model.PaymentMethod)</dd>
                </dl>
                <form asp-action="Delete" method="post" class="d-flex gap-2 mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.BillingID" />
                    <button type="submit" class="btn btn-danger btn-sm">Yes, Delete</button>
                    <a asp-action="Index" class="btn btn-secondary btn-sm">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
