@model YnclinoApartmentManagementSystem.Models.tblBilling
@{
    ViewData["Title"] = "Delete Bill";
}

<div>
    <div>
        <div data-panel>
            <div data-panel-head>Confirm Delete</div>
            <div data-panel-body>
                <p>Are you sure you want to delete this billing record?</p>
                <dl>
                    <dt>Tenant</dt>
                    <dd>@Model.Tenant?.FullName</dd>
                    <dt>Billing Period</dt>
                    <dd>@Model.BillingPeriod.ToString("MMMM yyyy")</dd>
                    <dt>Amount Due</dt>
                    <dd>₱@Model.AmountDue.ToString("N0")</dd>
                    <dt>Status</dt>
                    <dd>@Model.Status</dd>
                </dl>
                <form asp-action="Delete" method="post" data-actions-row>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.BillingID" />
                    <button type="submit" data-danger>Yes, Delete</button>
                    <a asp-action="Index">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
