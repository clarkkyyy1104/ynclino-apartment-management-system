@model IEnumerable<YnclinoApartmentManagementSystem.Models.ViewModels.TenantPaymentSummary>
@{
    ViewData["Title"] = "Payment History";
    decimal totalCollected = (decimal)(ViewBag.TotalCollected ?? 0m);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold mb-0">Payment History</h3>
    <span class="badge bg-success fs-6">Total Collected: ₱@totalCollected.ToString("N0")</span>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-auto">
        <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control"
               style="width:229px" placeholder="Search tenant name..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
        <a asp-action="History" class="btn btn-link">Clear</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle table-sm small">
        <thead class="table-primary">
            <tr>
                <th>Tenant</th>
                <th>Unit</th>
                <th>Payments</th>
                <th>Total Paid</th>
                <th>Last Payment</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td class="fw-semibold">@t.TenantName</td>
                    <td>@(t.UnitNumber ?? "—")</td>
                    <td>@t.PaymentCount</td>
                    <td class="text-success fw-semibold">₱@t.TotalPaid.ToString("N0")</td>
                    <td>@(t.LastPaymentDate?.ToString("MMM dd, yyyy") ?? "—")</td>
                    <td>
                        <a asp-action="TenantHistory" asp-route-id="@t.TenantID"
                           class="btn btn-sm btn-outline-info">Details</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-4">No tenants found.</td></tr>
            }
        </tbody>
    </table>
</div>
