@model IEnumerable<YnclinoApartmentManagementSystem.Models.tblPayment>
@{
    ViewData["Title"] = "Payment History";
    bool isAdmin = User.IsInRole("Admin");
    decimal totalCollected = (decimal)(ViewBag.TotalCollected ?? 0m);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold mb-0">Payment History</h3>
    <span class="badge bg-success fs-6">
        @(isAdmin ? "Total Collected" : "Total Paid"): ₱@totalCollected.ToString("N2")
    </span>
</div>

@if (isAdmin)
{
    <form method="get" class="row g-2 mb-4">
        <div class="col-auto">
            <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control"
                   style="width:229px" placeholder="Search tenant name..." />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Search</button>
            <a asp-action="History" class="btn btn-link">Clear</a>
        </div>
    </form>
}

<div class="table-responsive">
    <table class="table table-hover align-middle table-sm small">
        <thead class="table-primary">
            <tr>
                @if (isAdmin) { <th>Tenant</th><th>Unit</th> }
                <th>For the Month</th>
                <th>Date Paid</th>
                <th>Amount Paid</th>
                <th>Method</th>
                <th>Bill Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                var bill = p.Billing;
                <tr>
                    @if (isAdmin)
                    {
                        <td class="fw-semibold">@(bill?.Tenant?.FullName ?? "—")</td>
                        <td>@(bill?.Tenant?.Unit?.UnitNumber ?? "—")</td>
                    }
                    <td>@(bill != null ? bill.BillingPeriod.ToString("MMMM yyyy") : "—")</td>
                    <td>@p.DatePaid.ToString("MMM dd, yyyy")</td>
                    <td class="text-success fw-semibold">₱@p.Amount.ToString("N2")</td>
                    <td>@(string.IsNullOrEmpty(p.Method) ? "—" : p.Method)</td>
                    <td>
                        @{
                            var status = bill?.Status ?? "—";
                            var badge = status switch
                            {
                                "Paid" => "bg-success",
                                "Partial" => "bg-info text-dark",
                                "Overdue" => "bg-danger",
                                "Unpaid" => "bg-warning text-dark",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @badge">@status</span>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="@(isAdmin ? 8 : 6)" class="text-center text-muted py-4">No payments recorded yet.</td></tr>
            }
        </tbody>
    </table>
</div>
