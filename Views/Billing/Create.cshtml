@model YnclinoApartmentManagementSystem.Models.ViewModels.BillingViewModel
@{
    ViewData["Title"] = "Create Payment";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white fw-semibold">Issue New Bill</div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="TenantID" class="form-label fw-semibold small"></label>
                        <select asp-for="TenantID" asp-items="Model.AvailableTenants" class="form-select">
                            <option value="">— Select Tenant —</option>
                        </select>
                        <span asp-validation-for="TenantID" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BillingPeriod" class="form-label fw-semibold small">Billing Period (Month)</label>
                        <input asp-for="BillingPeriod" type="month" class="form-control"
                               value="@Model.BillingPeriod.ToString("yyyy-MM")" />
                        <span asp-validation-for="BillingPeriod" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AmountPaid" class="form-label fw-semibold small"></label>
                        <div class="input-group">
                            <span class="input-group-text">₱</span>
                            <input asp-for="AmountPaid" type="number" min="1" step="1" class="form-control" placeholder="0" />
                        </div>
                        <span asp-validation-for="AmountPaid" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PaymentMethod" class="form-label fw-semibold small"></label>
                        <select asp-for="PaymentMethod" class="form-select">
                            <option value="">— Not paid / not recorded —</option>
                            <option value="Cash">Cash</option>
                            <option value="GCash">GCash</option>
                        </select>
                        <div class="form-text text-muted small">How the tenant paid. Cleared automatically if no amount is paid.</div>
                        <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-semibold small"></label>
                        <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Optional notes…"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm">Issue Bill</button>
                        <a asp-action="Index" class="btn btn-secondary btn-sm">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
