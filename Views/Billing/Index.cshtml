@model IEnumerable<YnclinoApartmentManagementSystem.Models.tblBilling>
@{
    ViewData["Title"] = "Billing & Payment";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold mb-0">Billing &amp; Payment</h3>
    <a asp-action="Create" class="btn btn-primary">+ Record Payment</a>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-auto">
        <input type="text" name="searchTerm" value="@ViewBag.SearchTerm"
               class="form-control" style="width:229px" placeholder="Search tenant name…" />
    </div>
    <div class="col-auto">
        <a asp-action="Index" class="btn btn-link">Clear</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-primary">
            <tr>
                <th>Tenant</th>
                <th>Billing Period</th>
                <th>Amount Paid</th>
                <th>Method</th>
                <th>Status</th>
                <th>Date Recorded</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td class="fw-semibold">@b.Tenant?.FullName</td>
                    <td>@b.BillingPeriod.ToString("MMMM yyyy")</td>
                    <td>₱@b.AmountPaid.ToString("N2")</td>
                    <td>@(string.IsNullOrEmpty(b.PaymentMethod) ? "—" : b.PaymentMethod)</td>
                    <td>
                        @{
                            var badge = b.PaymentStatus switch {
                                "Paid"    => "bg-success",
                                "Partial" => "bg-info text-dark",
                                _         => "bg-warning text-dark"
                            };
                        }
                        <span class="badge @badge">@b.PaymentStatus</span>
                    </td>
                    <td>@b.DateIssued.ToString("MMM dd, yyyy")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@b.BillingID" class="btn btn-sm btn-outline-info">Details</a>
                        <a asp-action="Delete" asp-route-id="@b.BillingID" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No payments recorded yet.</td></tr>
            }
        </tbody>
    </table>
</div>
