@model IEnumerable<YnclinoApartmentManagementSystem.Models.tblBilling>
@{
    ViewData["Title"] = "Billing & Payment";
    bool isAdmin = User.IsInRole("Admin");
    var unreadIds = ViewBag.UnreadIds as HashSet<int> ?? new HashSet<int>();
    var readIds = ViewBag.ReadIds as HashSet<int> ?? new HashSet<int>();
}

@await Component.InvokeAsync("ModuleNotifications", new { module = "Billing" })

<div data-page-head>
    <div><h3>Billing &amp; Payment</h3></div>
    <div data-actions>
        @if (isAdmin)
        {
            <a data-primary asp-action="Create">+ Issue Bill</a>
        }
    </div>
</div>

@{
    decimal advanceCredit = (decimal)(ViewBag.AdvanceCredit ?? 0m);
}
@if (!isAdmin && advanceCredit > 0)
{
    <div>
        You have <strong>₱@advanceCredit.ToString("N0")</strong> in advance payment.
        It will be applied automatically to your next bill.
    </div>
}

<form method="get">
    @if (isAdmin)
    {
        <div>
            <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="Search tenant name…" />
        </div>
    }
    <div>
        <select name="statusFilter" onchange="this.form.submit()">
            <option value="">All Statuses</option>
            <option value="Paid"    selected="@(ViewBag.StatusFilter == "Paid")">Paid</option>
            <option value="Unpaid"  selected="@(ViewBag.StatusFilter == "Unpaid")">Unpaid</option>
            <option value="Partial" selected="@(ViewBag.StatusFilter == "Partial")">Partial</option>
            <option value="Overdue"    selected="@(ViewBag.StatusFilter == "Overdue")">Overdue</option>
        </select>
    </div>
    <div>
        <a asp-action="Index">Clear</a>
    </div>
</form>

<div data-table-wrap>
    <table>
        <thead>
            <tr>
                @if (isAdmin) { <th>Tenant</th><th>Unit</th> }
                <th>Billing Period</th>
                <th>Due Date</th>
                <th>Deposit</th>
                @* the one-month advance CHARGED at move-in — not the credit a tenant is
                   holding from an overpayment, which is shown on the bill's own page *@
                <th>Advance Payment</th>
                <th>Monthly Rent</th>
                <th>Balance</th>
                <th>Amount Paid</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    @if (isAdmin)
                    {
                        <td>@b.Tenant?.FullName</td>
                        <td>@(b.Tenant?.Unit?.UnitNumber ?? "—")</td>
                    }
                    <td>
                        @* bills the system issued out of an overpayment carry the same
                           blue as the advance payment that paid for them *@
                        @if (b.IssuedFromAdvance)
                        {
                            <span>@b.BillingPeriod.ToString("MMMM yyyy")</span>
                            <div><span>from advance payment</span></div>
                        }
                        else
                        {
                            @b.BillingPeriod.ToString("MMMM yyyy")
                        }
                        @if (!isAdmin && !string.IsNullOrEmpty(b.Notes))
                        {
                            <div>@b.Notes</div>
                        }
                    </td>
                    <td>@b.DueDate.ToString("MMM dd, yyyy")</td>
                    <td>₱@((b.Tenant?.Unit?.Deposit ?? 0m).ToString("N0"))</td>
                    @* Two things are advance payment and both belong in this column:
                       the one month charged at move-in, and anything the tenant
                       overpaid. Only the second is ever non-zero on a normal rent
                       bill, which is why this column used to read ₱0 forever. *@
                    <td>
                        @{ var advanceOnBill = b.Advance + b.AdvanceFromOverpayment; }
                        @if (b.AdvanceFromOverpayment > 0)
                        {
                            <span>₱@advanceOnBill.ToString("N0")</span>
                            <div>from overpayment</div>
                        }
                        else
                        {
                            <text>₱@advanceOnBill.ToString("N0")</text>
                        }
                    </td>
                    <td>₱@((b.AmountDue - b.Deposit - b.Advance).ToString("N0"))</td>
                    <td>₱@((b.AmountDue - (b.AmountPaid ?? 0m)).ToString("N0"))</td>
                    @* the whole amount handed over, with the overpaid part named
                       underneath so the row still adds up to what was received *@
                    <td>
                        @if (b.TotalReceived > 0)
                        {
                            <span>₱@b.TotalReceived.ToString("N0")</span>
                            @if (b.AdvanceFromOverpayment > 0)
                            {
                                <div>
                                    <span>₱@((b.AmountPaid ?? 0m).ToString("N0")) rent</span>
                                    <span>·</span>
                                    <span>₱@b.AdvanceFromOverpayment.ToString("N0") advance</span>
                                </div>
                            }
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </td>
                    <td>
                        <span>@b.Status</span>
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@b.BillingID" title="View" aria-label="View"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/></svg></a>
                        @if (isAdmin)
                        {
                            @if (b.Status == "Paid")
                            {
                                <span
                                      title="This bill is fully paid — there is nothing left to update.">Update</span>
                            }
                            else
                            {
                                <a asp-action="Edit" asp-route-id="@b.BillingID">Update</a>
                            }
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="@(isAdmin ? 11 : 9)">No billing records found.</td></tr>
            }
        </tbody>
    </table>
</div>
