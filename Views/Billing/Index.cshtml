@model IEnumerable<YnclinoApartmentManagementSystem.Models.tblBilling>
@{
    ViewData["Title"] = "Billing & Payment";
    bool isAdmin = User.IsInRole("Admin") || User.IsInRole("SemiAdmin");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold mb-0">Billing &amp; Payment</h3>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary">+ Issue Bill</a>
    }
</div>

<form method="get" class="row g-2 mb-4">
    @if (isAdmin)
    {
        <div class="col-auto">
            <input type="text" name="searchTerm" value="@ViewBag.SearchTerm"
                   class="form-control" style="width:229px" placeholder="Search tenant name…" />
        </div>
    }
    <div class="col-auto">
        <select name="statusFilter" class="form-select" onchange="this.form.submit()">
            <option value="">All Statuses</option>
            <option value="Unpaid"  selected="@(ViewBag.StatusFilter == "Unpaid")">Unpaid</option>
            <option value="Paid"    selected="@(ViewBag.StatusFilter == "Paid")">Paid</option>
            <option value="Overdue" selected="@(ViewBag.StatusFilter == "Overdue")">Overdue</option>
        </select>
    </div>
    <div class="col-auto">
        <a asp-action="Index" class="btn btn-link">Clear</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-primary">
            <tr>
                @if (isAdmin) { <th>Tenant</th><th>Unit</th> }
                <th>Billing Period</th>
                <th>Amount Due</th>
                <th>Due Date</th>
                <th>Amount Paid</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    @if (isAdmin)
                    {
                        <td class="fw-semibold">@b.Tenant?.FullName</td>
                        <td>@(b.Tenant?.Unit?.UnitNumber ?? "—")</td>
                    }
                    <td>@b.BillingPeriod.ToString("MMMM yyyy")</td>
                    <td>₱@b.AmountDue.ToString("N2")</td>
                    <td>@b.DueDate.ToString("MMM dd, yyyy")</td>
                    <td>@(b.AmountPaid.HasValue ? "₱" + b.AmountPaid.Value.ToString("N2") : "—")</td>
                    <td>
                        @{
                            var badge = b.Status switch {
                                "Paid"    => "bg-success",
                                "Overdue" => "bg-danger",
                                _         => "bg-warning text-dark"
                            };
                        }
                        <span class="badge @badge">@b.Status</span>
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@b.BillingID" class="btn btn-sm btn-outline-info">Details</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-4">No billing records found.</td></tr>
            }
        </tbody>
    </table>
</div>
