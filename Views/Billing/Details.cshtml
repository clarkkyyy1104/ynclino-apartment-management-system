@model YnclinoApartmentManagementSystem.Models.tblBilling
@{
    ViewData["Title"] = "Bill Details";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white fw-semibold">
                Bill — @Model.Tenant?.FullName · @Model.BillingPeriod.ToString("MMMM yyyy")
            </div>
            <div class="card-body">
                <dl class="row info-list">
                    <dt class="col-sm-4">Tenant</dt>
                    <dd class="col-sm-8">@Model.Tenant?.FullName</dd>

                    <dt class="col-sm-4">Unit</dt>
                    <dd class="col-sm-8">@(Model.Tenant?.Unit?.UnitNumber ?? "—")</dd>

                    <dt class="col-sm-4">Billing Period</dt>
                    <dd class="col-sm-8">@Model.BillingPeriod.ToString("MMMM yyyy")</dd>

                    <dt class="col-sm-4">Amount Due</dt>
                    <dd class="col-sm-8">₱@Model.AmountDue.ToString("N2")</dd>

                    <dt class="col-sm-4">Monthly Rent</dt>
                    <dd class="col-sm-8">₱@((Model.AmountDue - Model.Deposit - Model.Advance).ToString("N2"))</dd>

                    <dt class="col-sm-4">Deposit on File</dt>
                    <dd class="col-sm-8">
                        ₱@((Model.Tenant?.Unit?.Deposit ?? 0m).ToString("N2"))
                        <span class="badge bg-info text-dark ms-1">covers the final month at move-out</span>
                    </dd>

                    <dt class="col-sm-4">Advance Payment</dt>
                    <dd class="col-sm-8">₱@Model.Advance.ToString("N2")</dd>


                    <dt class="col-sm-4">Due Date</dt>
                    <dd class="col-sm-8">@Model.DueDate.ToString("MMM dd, yyyy")</dd>

                    <dt class="col-sm-4">Amount Paid</dt>
                    <dd class="col-sm-8">@(Model.AmountPaid.HasValue ? "₱" + Model.AmountPaid.Value.ToString("N2") : "—")</dd>

                    <dt class="col-sm-4">Date Paid</dt>
                    <dd class="col-sm-8">@(Model.DatePaid?.ToString("MMM dd, yyyy") ?? "—")</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @{
                            var badge = Model.Status switch {
                                "Paid"    => "bg-success",
                                "Partial" => "bg-info text-dark",
                                "Overdue"    => "bg-danger",
                                _         => "bg-warning text-dark"
                            };
                        }
                        <span class="badge @badge">@Model.Status</span>
                    </dd>
                    <dt class="col-sm-4">Date Issued</dt>
                    <dd class="col-sm-8">@Model.DateIssued.ToString("MMM dd, yyyy hh:mm tt")</dd>
                </dl>

                <div class="d-flex gap-2 mt-3">
                    <a asp-action="Index" class="btn btn-secondary btn-sm">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
