@model YnclinoApartmentManagementSystem.Models.tblBilling
@{
    ViewData["Title"] = "Bill Details";
}

<div>
    <div>
        <div>
            <div>
                Bill — @Model.Tenant?.FullName · @Model.BillingPeriod.ToString("MMMM yyyy")
            </div>
            <div>
                <dl>
                    <dt>Tenant</dt>
                    <dd>@Model.Tenant?.FullName</dd>

                    <dt>Unit</dt>
                    <dd>@(Model.Tenant?.Unit?.UnitNumber ?? "—")</dd>

                    <dt>Billing Period</dt>
                    @* a bill the system issued out of an overpayment is shown in the
                       same blue as the advance payment it was paid with *@
                    <dd>
                        @if (Model.IssuedFromAdvance)
                        {
                            <span>@Model.BillingPeriod.ToString("MMMM yyyy")</span>
                            <span>issued from advance payment</span>
                        }
                        else
                        {
                            @Model.BillingPeriod.ToString("MMMM yyyy")
                        }
                    </dd>

                    <dt>Amount Due</dt>
                    <dd>₱@Model.AmountDue.ToString("N0")</dd>

                    <dt>Monthly Rent</dt>
                    <dd>₱@((Model.AmountDue - Model.Deposit - Model.Advance).ToString("N0"))</dd>

                    <dt>Deposit on File</dt>
                    <dd>
                        <span>₱@((Model.Tenant?.Unit?.Deposit ?? 0m).ToString("N0"))</span>
                        <span>covers the final month at move-out</span>
                    </dd>

                    @* Two different things used to share the name "Advance Payment".
                       This one is part of what the bill CHARGES — the one-month advance
                       collected at move-in. It only exists on the move-in bill. *@
                    @if (Model.Advance > 0)
                    {
                        <dt>Advance Payment Charged</dt>
                        <dd>
                            ₱@Model.Advance.ToString("N0")
                            <span>one month, collected at move-in</span>
                        </dd>
                    }

                    @* This one is CHANGE, not a charge: whatever the tenant paid beyond
                       what the bill asked for is kept here and settles their next bill. *@
                    <dt>Advance Payment on File</dt>
                    <dd>
                        @* only colour it while there is actually credit being held *@
                        @if ((Model.Tenant?.AdvanceCredit ?? 0m) > 0)
                        {
                            <span>₱@((Model.Tenant!.AdvanceCredit).ToString("N0"))</span>
                            <span>applied automatically to the next bill</span>
                        }
                        else
                        {
                            <span>₱0</span>
                        }
                        else
                        {
                            <span>— no overpayment being held</span>
                        }
                    </dd>

                    <dt>Due Date</dt>
                    <dd>@Model.DueDate.ToString("MMM dd, yyyy")</dd>

                    @* Amount Paid is what the tenant actually handed over, NOT what the
                       bill happened to ask for. Pay 12,000 on a 6,000 bill and it says
                       12,000, then breaks down where each half of it went. *@
                    <dt>Amount Paid</dt>
                    <dd>
                        @if (Model.TotalReceived > 0)
                        {
                            <span>₱@Model.TotalReceived.ToString("N0")</span>

                            @* only worth splitting when the money went two ways *@
                            @if (Model.AdvanceFromOverpayment > 0)
                            {
                                <div>
                                    <div>
                                        Monthly Rent
                                        <span>₱@((Model.AmountPaid ?? 0m).ToString("N0"))</span>
                                    </div>
                                    <div>
                                        Advance Payment
                                        <span>₱@Model.AdvanceFromOverpayment.ToString("N0")</span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </dd>

                    @* One line naming where the money ended up, so it reads at a glance. *@
                    @if (Model.TotalReceived > 0)
                    {
                        <dt>Payment Applied To</dt>
                        <dd>
                            @* each destination keeps its own colour, so the sentence
                               reads the same way as the split above it *@
                            @if ((Model.AmountPaid ?? 0m) > 0)
                            {
                                <span>Monthly Rent</span>
                            }
                            @if (Model.AdvanceFromOverpayment > 0 && (Model.AmountPaid ?? 0m) > 0)
                            {
                                <span>&amp;</span>
                            }
                            @if (Model.AdvanceFromOverpayment > 0)
                            {
                                <span>Advance Payment</span>
                            }
                        </dd>
                    }

                    <dt>Date Paid</dt>
                    <dd>@(Model.DatePaid?.ToString("MMM dd, yyyy") ?? "—")</dd>

                    <dt>Status</dt>
                    <dd>
                        <span>@Model.Status</span>
                    </dd>
                    <dt>Date Issued</dt>
                    <dd>@Model.DateIssued.ToString("MMM dd, yyyy hh:mm tt")</dd>
                </dl>

                @{
                    var payments = ViewBag.Payments as List<YnclinoApartmentManagementSystem.Models.tblPayment>
                                   ?? new List<YnclinoApartmentManagementSystem.Models.tblPayment>();
                }
                @if (payments.Any())
                {
                    <h6>Payment History</h6>
                    <div>
                        <table>
                            <thead>
                                <tr>
                                    <th>Date Paid</th>
                                    <th>Method</th>
                                    <th>Amount</th>
                                    <th>Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in payments)
                                {
                                    <tr>
                                        <td>@p.DatePaid.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            @* money that came out of held advance payment
                                               rather than cash handed over today *@
                                            @if (p.Method == "Advance")
                                            {
                                                <span>Advance</span>
                                            }
                                            else
                                            {
                                                <span>@p.Method</span>
                                            }
                                        </td>
                                        <td>₱@p.Amount.ToString("N0")</td>
                                        <td>@(string.IsNullOrWhiteSpace(p.Remarks) ? "—" : p.Remarks)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div>
                    <a asp-action="Index">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
