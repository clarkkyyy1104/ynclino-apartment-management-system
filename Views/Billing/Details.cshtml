@model YnclinoApartmentManagementSystem.Models.tblBilling
@{
    ViewData["Title"] = "Bill Details";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white fw-semibold">
                Bill — @Model.Tenant?.FullName · @Model.BillingPeriod.ToString("MMMM yyyy")
            </div>
            <div class="card-body">
                <dl class="row info-list">
                    <dt class="col-sm-4">Tenant</dt>
                    <dd class="col-sm-8">@Model.Tenant?.FullName</dd>

                    <dt class="col-sm-4">Unit</dt>
                    <dd class="col-sm-8">@(Model.Tenant?.Unit?.UnitNumber ?? "—")</dd>

                    <dt class="col-sm-4">Billing Period</dt>
                    <dd class="col-sm-8">@Model.BillingPeriod.ToString("MMMM yyyy")</dd>

                    <dt class="col-sm-4">Amount Due</dt>
                    <dd class="col-sm-8">₱@Model.AmountDue.ToString("N0")</dd>

                    <dt class="col-sm-4">Monthly Rent</dt>
                    <dd class="col-sm-8">₱@((Model.AmountDue - Model.Deposit - Model.Advance).ToString("N0"))</dd>

                    <dt class="col-sm-4">Deposit on File</dt>
                    <dd class="col-sm-8">
                        <span class="money-deposit">₱@((Model.Tenant?.Unit?.Deposit ?? 0m).ToString("N0"))</span>
                        <span class="badge bg-info text-dark ms-1">covers the final month at move-out</span>
                    </dd>

                    @* Two different things used to share the name "Advance Payment".
                       This one is part of what the bill CHARGES — the one-month advance
                       collected at move-in. It only exists on the move-in bill. *@
                    @if (Model.Advance > 0)
                    {
                        <dt class="col-sm-4">Advance Payment Charged</dt>
                        <dd class="col-sm-8">
                            ₱@Model.Advance.ToString("N0")
                            <span class="badge bg-info text-dark ms-1">one month, collected at move-in</span>
                        </dd>
                    }

                    @* This one is CHANGE, not a charge: whatever the tenant paid beyond
                       what the bill asked for is kept here and settles their next bill. *@
                    <dt class="col-sm-4">Advance Payment on File</dt>
                    <dd class="col-sm-8">
                        ₱@((Model.Tenant?.AdvanceCredit ?? 0m).ToString("N0"))
                        @if ((Model.Tenant?.AdvanceCredit ?? 0m) > 0)
                        {
                            <span class="badge bg-success ms-1">applied automatically to the next bill</span>
                        }
                        else
                        {
                            <span class="text-muted small ms-1">— no overpayment being held</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Due Date</dt>
                    <dd class="col-sm-8">@Model.DueDate.ToString("MMM dd, yyyy")</dd>

                    @* Amount Paid is what the tenant actually handed over, NOT what the
                       bill happened to ask for. Pay 12,000 on a 6,000 bill and it says
                       12,000, then breaks down where each half of it went. *@
                    <dt class="col-sm-4">Amount Paid</dt>
                    <dd class="col-sm-8">
                        @if (Model.TotalReceived > 0)
                        {
                            <span class="money-paid">₱@Model.TotalReceived.ToString("N0")</span>

                            @* only worth splitting when the money went two ways *@
                            @if (Model.AdvanceFromOverpayment > 0)
                            {
                                <div class="money-split mt-2">
                                    <div>
                                        Monthly Rent
                                        <span class="money-dest ms-1">₱@((Model.AmountPaid ?? 0m).ToString("N0"))</span>
                                    </div>
                                    <div>
                                        Advance Payment
                                        <span class="money-dest ms-1">₱@Model.AdvanceFromOverpayment.ToString("N0")</span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </dd>

                    @* One line naming where the money ended up, so it reads at a glance. *@
                    @if (Model.TotalReceived > 0)
                    {
                        <dt class="col-sm-4">Payment Applied To</dt>
                        <dd class="col-sm-8">
                            <span class="money-dest">
                                @if (Model.AdvanceFromOverpayment > 0 && (Model.AmountPaid ?? 0m) > 0)
                                {
                                    <text>Monthly Rent &amp; Advance Payment</text>
                                }
                                else if (Model.AdvanceFromOverpayment > 0)
                                {
                                    <text>Advance Payment</text>
                                }
                                else
                                {
                                    <text>Monthly Rent</text>
                                }
                            </span>
                        </dd>
                    }

                    <dt class="col-sm-4">Date Paid</dt>
                    <dd class="col-sm-8">@(Model.DatePaid?.ToString("MMM dd, yyyy") ?? "—")</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @{
                            var badge = Model.Status switch {
                                "Paid"    => "bg-success",
                                "Partial" => "bg-info text-dark",
                                "Overdue"    => "bg-danger",
                                _         => "bg-warning text-dark"
                            };
                        }
                        <span class="badge @badge">@Model.Status</span>
                    </dd>
                    <dt class="col-sm-4">Date Issued</dt>
                    <dd class="col-sm-8">@Model.DateIssued.ToString("MMM dd, yyyy hh:mm tt")</dd>
                </dl>

                @{
                    var payments = ViewBag.Payments as List<YnclinoApartmentManagementSystem.Models.tblPayment>
                                   ?? new List<YnclinoApartmentManagementSystem.Models.tblPayment>();
                }
                @if (payments.Any())
                {
                    <h6 class="fw-semibold mt-4 mb-2">Payment History</h6>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Date Paid</th>
                                    <th>Method</th>
                                    <th class="text-end">Amount</th>
                                    <th>Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in payments)
                                {
                                    <tr>
                                        <td>@p.DatePaid.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            @* money that came out of held advance payment
                                               rather than cash handed over today *@
                                            @if (p.Method == "Advance")
                                            {
                                                <span class="badge bg-success">Advance</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@p.Method</span>
                                            }
                                        </td>
                                        <td class="text-end">₱@p.Amount.ToString("N0")</td>
                                        <td class="text-muted small">@(string.IsNullOrWhiteSpace(p.Remarks) ? "—" : p.Remarks)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="d-flex gap-2 mt-3">
                    <a asp-action="Index" class="btn btn-secondary btn-sm">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
