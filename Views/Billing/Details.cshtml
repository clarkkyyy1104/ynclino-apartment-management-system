@model YnclinoApartmentManagementSystem.Models.tblBilling
@{
    ViewData["Title"] = "Payment Details";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white fw-semibold">
                Payment — @Model.Tenant?.FullName · @Model.BillingPeriod.ToString("MMMM yyyy")
            </div>
            <div class="card-body">
                <dl class="row info-list">
                    <dt class="col-sm-4">Tenant</dt>
                    <dd class="col-sm-8">@Model.Tenant?.FullName</dd>

                    <dt class="col-sm-4">Billing Period</dt>
                    <dd class="col-sm-8">@Model.BillingPeriod.ToString("MMMM yyyy")</dd>

                    <dt class="col-sm-4">Amount Paid</dt>
                    <dd class="col-sm-8">₱@Model.AmountPaid.ToString("N2")</dd>

                    <dt class="col-sm-4">Payment Method</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.PaymentMethod) ? "—" : Model.PaymentMethod)</dd>

                    <dt class="col-sm-4">Notes</dt>
                    <dd class="col-sm-8">@(Model.Notes ?? "—")</dd>

                    <dt class="col-sm-4">Date Recorded</dt>
                    <dd class="col-sm-8">@Model.DateIssued.ToString("MMM dd, yyyy hh:mm tt")</dd>
                </dl>

                <div class="d-flex gap-2 mt-3">
                    <a asp-action="Index" class="btn btn-secondary btn-sm">Back</a>
                    <a asp-action="Delete" asp-route-id="@Model.BillingID" class="btn btn-outline-danger btn-sm">Delete</a>
                </div>
            </div>
        </div>
    </div>
</div>
