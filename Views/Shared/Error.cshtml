@model YnclinoApartmentManagementSystem.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div>
    <h1>An Error Occurred</h1>
    <h2>The request could not be processed.</h2>
    @if (Model.ShowRequestId)
    {
        <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index">Go to Dashboard</a>
</div>
