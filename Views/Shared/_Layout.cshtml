<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Apartment Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <style>
        /* show/hide password toggle placed inside the input */
        .pw-wrapper { position: relative; }
        .pw-wrapper .form-control { padding-right: 2.5rem; }
        .pw-toggle {
            position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
            background: none; border: none; padding: 2px 4px; color: #6c757d;
            cursor: pointer; line-height: 1; z-index: 5; display: inline-flex; align-items: center;
        }
        .pw-toggle:hover { color: #343a40; }
        /* password-rules checklist */
        .pw-rules { margin-top: .4rem; padding: .5rem .75rem; background: #f8f9fa; border-radius: .375rem; border: 1px solid #e9ecef; }
        .pw-rules li { color: #6c757d; padding: .15rem 0; display: flex; align-items: center; gap: .4rem; }
        .pw-rules li.rule-pass { color: #198754; }
        .pw-rules li.rule-fail { color: #dc3545; }
        .pw-rules .rule-icon { display: inline-flex; align-items: center; flex-shrink: 0; }
        .shake { animation: shake .5s ease; }
        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            20% { transform: translateX(-6px); }
            40% { transform: translateX(6px); }
            60% { transform: translateX(-4px); }
            80% { transform: translateX(4px); }
        }
    </style>
</head>
<body>
@{
    var activeController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(string c) => activeController == c ? "active" : "";
}
@if (User.Identity?.IsAuthenticated == true)
{
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Apartment Management System</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain" aria-controls="navMain" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Dashboard</a></li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item"><a class="nav-link @Active("Users")" asp-controller="Users" asp-action="Index">Manage Users</a></li>
                    }
                    <li class="nav-item"><a class="nav-link @Active("Units")" asp-controller="Units" asp-action="Index">Units</a></li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item"><a class="nav-link @Active("Tenants")" asp-controller="Tenants" asp-action="Index">Tenants</a></li>
                    }
                    <li class="nav-item"><a class="nav-link @Active("Billing")" asp-controller="Billing" asp-action="Index">Billing &amp; Payment @await Component.InvokeAsync("NavAlert", new { module = "Billing" })</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Maintenance")" asp-controller="Maintenance" asp-action="Index">Maintenance @await Component.InvokeAsync("NavAlert", new { module = "Maintenance" })</a></li>
                    <li class="nav-item"><a class="nav-link @Active("LostFound")" asp-controller="LostFound" asp-action="Index">Lost &amp; Found @await Component.InvokeAsync("NavAlert", new { module = "LostFound" })</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Transfers")" asp-controller="Transfers" asp-action="Index">@(User.IsInRole("Admin") ? "Unit Requests" : "My Unit") @await Component.InvokeAsync("NavAlert", new { module = "Transfer" })</a></li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            @User.Identity.Name (@(User.IsInRole("Admin") ? "Admin" : "Tenant"))
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (User.IsInRole("Tenant"))
                            {
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index">My Profile</a></li>
                            }
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Change Password</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="px-3">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">Sign Out</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container-fluid py-4 px-4">
        @RenderBody()
    </main>
}
else
{
    <div class="container-fluid py-4 px-4">
        @RenderBody()
    </div>
}

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:1100">
    @if (TempData["Success"] != null)
    {
        <div class="toast align-items-center text-bg-success border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body fw-semibold">@TempData["Success"]</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast align-items-center text-bg-danger border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body fw-semibold">@TempData["Error"]</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    }
</div>
<script>
    document.querySelectorAll('.toast').forEach(function (el) {
        new bootstrap.Toast(el, { delay: 5000 }).show();
    });
</script>
</body>
</html>
