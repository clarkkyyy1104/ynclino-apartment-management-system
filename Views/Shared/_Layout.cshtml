<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Apartment Management System</title>
    <link rel="stylesheet" href="~/css/ynclino.css" asp-append-version="true" />
    @* Applied before anything is drawn, so a collapsed rail does not flash open
       on every page load. *@
    <script>
        try { if (localStorage.getItem('ynclino-rail') !== '0') document.documentElement.setAttribute('data-rail', ''); } catch (e) { }
    </script>
</head>
<body>
@{
    var activeController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    // marks the current page semantically: style it with a[aria-current="page"]
    string? Active(string c) => activeController == c ? "page" : null;
    bool isAdmin = User.IsInRole("Admin");
    var accountName = User.Identity?.Name ?? "";
    if (isAdmin && accountName.Length > 0)
        accountName = char.ToUpperInvariant(accountName[0]) + accountName.Substring(1);
    // three roles now, so "not admin" no longer means "tenant" — name each one
    bool isStaff = User.IsInRole("Maintenance");
    bool isTenant = User.IsInRole("Tenant");
    bool unitsOpen = activeController == "Units" || activeController == "Transfers";
    var activeAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool billingOpen = activeController == "Billing";
    // one tenant's record is opened from Payment History and goes back to it,
    // so it belongs under that item rather than falling through to Bills
    bool paymentHistoryActive = billingOpen && (activeAction == "History" || activeAction == "TenantHistory");
}
@if (User.Identity?.IsAuthenticated == true)
{
    <div>
        <aside id="appSidebar">
            @* The brand shows the full wordmark normally and just the Y when the
               rail is narrow. Both are in the markup; the stylesheet shows one. *@
            <div data-brand>
                <a asp-controller="Home" asp-action="Index" data-brand-link>
                    <img data-logo-full src="~/images/logo.png" alt="Ynclino Apartment Management System" />
                    <img data-logo-mark src="~/images/logo-y.png" alt="Ynclino" />
                </a>
            </div>
            <nav>
                @* Each link is an icon slot, a label and (where it applies) its
                   count. Collapsed, only the icon and the count remain; the title
                   is what a hover then shows instead of the label.
                   The icon slot names its module; the stylesheet maps that name
                   to a file in wwwroot/images/icons. *@
                <a aria-current="@Active("Home")" asp-controller="Home" asp-action="Index" title="Dashboard">
                    <span data-nav-icon="dashboard"></span>
                    <span data-nav-label>Dashboard</span>
                </a>

                @if (isAdmin)
                {
                    <a data-collapse="#unitsGroup" href="#unitsGroup" role="button" title="Units"
                       aria-expanded="@(unitsOpen ? "true" : "false")">
                        <span data-nav-icon="units"></span>
                        <span data-nav-label>Units</span>
                        @await Component.InvokeAsync("NavAlert", new { module = "Transfer" })
                        <svg data-caret aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </a>
                    <div id="unitsGroup" hidden="@(unitsOpen ? null : "hidden")">
                        <div>
                            <a aria-current="@Active("Units")" asp-controller="Units" asp-action="Index">Units</a>
                            <a aria-current="@Active("Transfers")" asp-controller="Transfers" asp-action="Index">
                                Units Request @await Component.InvokeAsync("NavAlert", new { module = "Transfer" })
                            </a>
                        </div>
                    </div>
                }
                else if (isTenant)
                {
                    @* tenant: a single Units link (browse); My Unit / Transfer lives in their Profile *@
                    <a aria-current="@Active("Units")" asp-controller="Units" asp-action="Index" title="Units">
                        <span data-nav-icon="units"></span>
                        <span data-nav-label>Units</span>
                    </a>
                }

                @if (isAdmin)
                {
                    <a aria-current="@Active("Users")" asp-controller="Users" asp-action="Index" title="Manage Users">
                        <span data-nav-icon="users"></span>
                        <span data-nav-label>Manage Users</span>
                    </a>
                    <a aria-current="@Active("Tenants")" asp-controller="Tenants" asp-action="Index" title="Tenants">
                        <span data-nav-icon="tenants"></span>
                        <span data-nav-label>Tenants</span>
                    </a>
                }

                @* maintenance staff only ever see their own module — no billing,
                   no tenants, no units, no lost &amp; found *@
                @if (!isStaff)
                {
                    <a data-collapse="#billingGroup" href="#billingGroup" role="button" title="Billing and Payment"
                       aria-expanded="@(billingOpen ? "true" : "false")">
                        <span data-nav-icon="billing"></span>
                        <span data-nav-label>Billing and Payment</span>
                        @await Component.InvokeAsync("NavAlert", new { module = "Billing" })
                        <svg data-caret aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </a>
                    <div id="billingGroup" hidden="@(billingOpen ? null : "hidden")">
                        <div>
                            <a aria-current="@(billingOpen && !paymentHistoryActive ? "page" : null)" asp-controller="Billing" asp-action="Index">Bills</a>
                            <a aria-current="@(paymentHistoryActive ? "page" : null)" asp-controller="Billing" asp-action="History">Payment History</a>
                        </div>
                    </div>
                }

                <a aria-current="@Active("Maintenance")" asp-controller="Maintenance" asp-action="Index" title="Maintenance">
                    <span data-nav-icon="maintenance"></span>
                    <span data-nav-label>Maintenance</span>
                    @await Component.InvokeAsync("NavAlert", new { module = "Maintenance" })
                </a>

                @if (!isStaff)
                {
                    <a aria-current="@Active("LostFound")" asp-controller="LostFound" asp-action="Index" title="Lost and Found">
                        <span data-nav-icon="lostfound"></span>
                        <span data-nav-label>Lost and Found</span>
                        @await Component.InvokeAsync("NavAlert", new { module = "LostFound" })
                    </a>
                }
                @* Reports & Records is for the admin (a tenant lands on their own
                   records); maintenance staff have no business in it at all *@
                @if (!isStaff)
                {
                    <a aria-current="@Active("Reports")" asp-controller="Reports" asp-action="Index" title="Reports &amp; Records">
                        <span data-nav-icon="reports"></span>
                        <span data-nav-label>Reports &amp; Records</span>
                    </a>
                }
            </nav>

            @* The account sits at the foot of the sidebar rather than across the
               top of the page, so the first thing at the top of every module is
               that module's own heading. *@
            <div data-account>
                @if (isStaff && !isAdmin)
                {
                    <div class="maintenanceProfileCard" data-account-card title="My Profile">
                    <span data-nav-icon="profile"></span>
                    <span data-account-text>
                        <span>@accountName</span>
                        @if(isAdmin){ <span/> }
                        else{<span>@(isAdmin ? "Admin" : isStaff ? "Maintenance Staff" : "Tenant")</span>}
                    </span>
                    </div>
                    @* a form, not a link: Logout only accepts a POST carrying the token *@
                    <form asp-controller="Account" asp-action="Logout" method="post" data-logout>
                        @Html.AntiForgeryToken()
                        <button type="submit" title="Logout">
                            <span data-nav-icon="logout"></span>
                            <span data-nav-label>Logout</span>
                        </button>
                    </form>
                }
                else 
                {
                    <a data-account-card aria-current="@Active("Profile")" asp-controller="Profile" asp-action="Index" title="My Profile">
                    <span data-nav-icon="profile"></span>
                    <span data-account-text>
                        <span>@accountName</span>
                        @if(isAdmin){ <span/> }
                        else{<span>@(isAdmin ? "Admin" : isStaff ? "Maintenance Staff" : "Tenant")</span>}
                    </span>
                    </a>
                    @* a form, not a link: Logout only accepts a POST carrying the token *@
                    <form asp-controller="Account" asp-action="Logout" method="post" data-logout>
                        @Html.AntiForgeryToken()
                        <button type="submit" title="Logout">
                            <span data-nav-icon="logout"></span>
                            <span data-nav-label>Logout</span>
                        </button>
                    </form>
                }
            </div>
        </aside>

        <div>
            <main>
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <div>
        @RenderBody()
    </div>
}

@* The modal every "Add"/"Update" button opens. One shell for the whole system:
   the button says which page to load, the script below fetches that page and
   lifts its [data-form-panel] in here. *@
<dialog data-modal id="appModal" aria-labelledby="appModalTitle">
    <div data-modal-panel>
        <div data-modal-head>
            <span data-modal-title id="appModalTitle"></span>
            <button type="button" data-modal-close aria-label="Close">&times;</button>
        </div>
        <div data-modal-body></div>
    </div>
</dialog>

    <script src="~/js/ynclino.js" asp-append-version="true"></script>
    @* wrapped so the modal script can tell a page's own scripts from the layout's *@
    <div data-page-scripts>@await RenderSectionAsync("Scripts", required: false)</div>

@* flash messages: data-flash is the hook, ynclino.js removes them after 5s *@
@if (TempData["Success"] != null)
{
    <p data-flash="success" role="status">
        @TempData["Success"]
        <button type="button" data-dismiss aria-label="Dismiss">&times;</button>
    </p>
}
@if (TempData["Error"] != null)
{
    <p data-flash="error" role="alert">
        @TempData["Error"]
        <button type="button" data-dismiss aria-label="Dismiss">&times;</button>
    </p>
}
</body>
</html>
