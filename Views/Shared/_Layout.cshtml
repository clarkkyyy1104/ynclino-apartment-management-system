<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Apartment Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <style>
        /* show/hide password toggle placed inside the input */
        .pw-wrapper { position: relative; }
        .pw-wrapper .form-control { padding-right: 2.5rem; }
        .pw-toggle {
            position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
            background: none; border: none; padding: 2px 4px; color: #6c757d;
            cursor: pointer; line-height: 1; z-index: 5; display: inline-flex; align-items: center;
        }
        .pw-toggle:hover { color: #343a40; }
        .pw-rules { margin-top: .4rem; padding: .5rem .75rem; background: #f8f9fa; border-radius: .375rem; border: 1px solid #e9ecef; }
        .pw-rules li { color: #6c757d; padding: .15rem 0; display: flex; align-items: center; gap: .4rem; }
        .pw-rules li.rule-pass { color: #198754; }
        .pw-rules li.rule-fail { color: #dc3545; }
        .pw-rules .rule-icon { display: inline-flex; align-items: center; flex-shrink: 0; }
        .shake { animation: shake .5s ease; }
        @@keyframes shake { 0%,100%{transform:translateX(0);} 20%{transform:translateX(-6px);} 40%{transform:translateX(6px);} 60%{transform:translateX(-4px);} 80%{transform:translateX(4px);} }

        /* ── Left sidebar layout ── */
        body { background:#f4f5f7; }
        .app-sidebar { width:240px; min-width:240px; background:#1f2a44; color:#cbd5e1; min-height:100vh; }
        .app-sidebar .brand { color:#fff; font-weight:700; padding:16px 18px; font-size:1.02rem; border-bottom:1px solid rgba(255,255,255,.08); display:block; text-decoration:none; }
        .app-sidebar .nav-link { color:#cbd5e1; padding:.55rem 1.1rem; display:flex; align-items:center; gap:.5rem; border-radius:0; }
        .app-sidebar .nav-link:hover { background:rgba(255,255,255,.06); color:#fff; }
        .app-sidebar .nav-link.active { background:#2f5bd6; color:#fff; }
        .app-sidebar .sub { background:rgba(0,0,0,.16); }
        .app-sidebar .sub .nav-link { padding-left:2.4rem; font-size:.9rem; }
        .app-sidebar .group-toggle { cursor:pointer; }
        .app-sidebar .group-toggle .caret { margin-left:auto; transition:transform .15s; }
        .app-sidebar .group-toggle[aria-expanded="true"] .caret { transform:rotate(180deg); }
        .app-topbar { background:#16203a; color:#e5e7eb; padding:.55rem 1rem; display:flex; align-items:center; gap:.75rem; }
        .app-topbar .dropdown-toggle { color:#e5e7eb; text-decoration:none; }
        .app-content { min-width:0; }
        @@media (max-width:768px){
            .app-sidebar { position:fixed; z-index:1045; left:-240px; transition:left .2s; height:100%; }
            .app-sidebar.show { left:0; }
        }
    </style>
</head>
<body>
@{
    var activeController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(string c) => activeController == c ? "active" : "";
    bool isAdmin = User.IsInRole("Admin");
    bool unitsOpen = activeController == "Units" || activeController == "Transfers";
}
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="d-flex">
        <aside class="app-sidebar" id="appSidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">Apartment MS</a>
            <nav class="nav flex-column py-2">
                <a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Dashboard</a>

                @if (isAdmin)
                {
                    <a class="nav-link group-toggle @(unitsOpen ? "active" : "")" data-bs-toggle="collapse" href="#unitsGroup" role="button" aria-expanded="@(unitsOpen ? "true" : "false")">
                        Units <span class="caret">▾</span>
                    </a>
                    <div class="collapse @(unitsOpen ? "show" : "")" id="unitsGroup">
                        <div class="sub">
                            <a class="nav-link @Active("Units")" asp-controller="Units" asp-action="Index">Units</a>
                            <a class="nav-link @Active("Transfers")" asp-controller="Transfers" asp-action="Index">
                                Unit Requests @await Component.InvokeAsync("NavAlert", new { module = "Transfer" })
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    @* tenant: a single Units link (browse); My Unit / Transfer lives in their Profile *@
                    <a class="nav-link @Active("Units")" asp-controller="Units" asp-action="Index">Units</a>
                }

                @if (isAdmin)
                {
                    @* Manage Users tab hidden for now — restore this line to bring it back *@
                    @* <a class="nav-link @Active("Users")" asp-controller="Users" asp-action="Index">Manage Users</a> *@
                    <a class="nav-link @Active("Tenants")" asp-controller="Tenants" asp-action="Index">Tenants</a>
                }
                <a class="nav-link @Active("Billing")" asp-controller="Billing" asp-action="Index">Billing &amp; Payment @await Component.InvokeAsync("NavAlert", new { module = "Billing" })</a>
                <a class="nav-link @Active("Maintenance")" asp-controller="Maintenance" asp-action="Index">Maintenance @await Component.InvokeAsync("NavAlert", new { module = "Maintenance" })</a>
                <a class="nav-link @Active("LostFound")" asp-controller="LostFound" asp-action="Index">Lost &amp; Found @await Component.InvokeAsync("NavAlert", new { module = "LostFound" })</a>
            </nav>
        </aside>

        <div class="flex-grow-1 d-flex flex-column min-vh-100 app-content">
            <header class="app-topbar">
                <button class="btn btn-sm btn-outline-light d-md-none" type="button" onclick="document.getElementById('appSidebar').classList.toggle('show')">☰</button>
                <div class="ms-auto dropdown">
                    <a class="dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        @User.Identity.Name <span class="text-secondary">(@(isAdmin ? "Admin" : "Tenant"))</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" asp-controller="Profile" asp-action="Index">
                                My Profile @if (!isAdmin) { @await Component.InvokeAsync("NavAlert", new { module = "Transfer" }) }
                            </a>
                        </li>
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Change Password</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="px-3">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100">Sign Out</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </header>

            <main class="p-4 flex-grow-1">
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <div class="container-fluid py-4 px-4">
        @RenderBody()
    </div>
}

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:1100">
    @if (TempData["Success"] != null)
    {
        <div class="toast align-items-center text-bg-success border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body fw-semibold">@TempData["Success"]</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast align-items-center text-bg-danger border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body fw-semibold">@TempData["Error"]</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    }
</div>
<script>
    document.querySelectorAll('.toast').forEach(function (el) {
        new bootstrap.Toast(el, { delay: 5000 }).show();
    });
</script>
</body>
</html>
