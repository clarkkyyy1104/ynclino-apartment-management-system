<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — BKS Apartment</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>
<body>
@{
    var activeController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(string c) => activeController == c ? "active" : "";
}
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="app-shell" id="appShell">
        <aside class="app-sidebar">
            <a class="sb-brand" asp-controller="Home" asp-action="Index">
                <span class="sb-mark">
                    <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" fill="#fff" viewBox="0 0 16 16"><path d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.707L2 8.207V13.5A1.5 1.5 0 0 0 3.5 15h9a1.5 1.5 0 0 0 1.5-1.5V8.207l.646.646a.5.5 0 0 0 .708-.707L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293z"/></svg>
                </span>
                <span class="sb-word">BKS Apartment</span>
            </a>

            <nav class="sb-nav">
                <a class="sb-link @Active("Home")" asp-controller="Home" asp-action="Index">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5zm8 0A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5zm-8 8A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5zm8 0A1.5 1.5 0 0 1 10.5 9h3A1.5 1.5 0 0 1 15 10.5v3A1.5 1.5 0 0 1 13.5 15h-3A1.5 1.5 0 0 1 9 13.5z"/></svg>
                    <span class="sb-label">Dashboard</span>
                </a>
                <a class="sb-link @Active("Tenants")" asp-controller="Tenants" asp-action="Index">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/></svg>
                    <span class="sb-label">Tenants</span>
                </a>
                <a class="sb-link @Active("Billing")" asp-controller="Billing" asp-action="Index">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M4 10.781c.148 1.667 1.513 2.85 3.591 3.003V15h1.043v-1.216c2.27-.179 3.678-1.438 3.678-3.3 0-1.59-.947-2.51-2.956-3.028l-.722-.187V3.467c1.122.11 1.879.714 2.07 1.616h1.47c-.166-1.6-1.54-2.748-3.54-2.875V1H7.591v1.233c-1.939.23-3.27 1.472-3.27 3.156 0 1.454.966 2.483 2.661 2.917l.61.162v4.031c-1.149-.17-1.94-.8-2.131-1.718zm3.391-3.836c-1.043-.263-1.6-.825-1.6-1.616 0-.944.704-1.641 1.8-1.828v3.495l-.2-.05zm1.591 1.872c1.287.323 1.852.859 1.852 1.769 0 1.097-.826 1.828-2.2 1.939V8.73z"/></svg>
                    <span class="sb-label">Billing &amp; Payment</span>
                </a>
                <a class="sb-link @Active("LostFound")" asp-controller="LostFound" asp-action="Index">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/></svg>
                    <span class="sb-label">Lost &amp; Found</span>
                </a>
            </nav>

            <div class="sb-foot dropup">
                <a class="sb-user dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="sb-avatar">@((User.Identity?.Name ?? "?").Substring(0, 1).ToUpper())</span>
                    <span class="sb-user-meta">
                        <span class="sb-uname">@User.Identity?.Name</span>
                        <span class="sb-role">Admin</span>
                    </span>
                </a>
                <ul class="dropdown-menu w-100">
                    <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Change Password</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="px-3 pb-1">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger w-100">Sign Out</button>
                        </form>
                    </li>
                </ul>
            </div>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <button class="sb-toggle" type="button" id="sbToggle" aria-label="Toggle menu">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5"/></svg>
                </button>
                <span class="topbar-title">@ViewData["Title"]</span>
            </header>
            <main class="app-content">
                @RenderBody()
            </main>
        </div>

        <div class="sb-backdrop" id="sbBackdrop"></div>
    </div>
}
else
{
    <div class="container-fluid py-4 px-4">
        @RenderBody()
    </div>
}

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var shell = document.getElementById('appShell');
            var toggle = document.getElementById('sbToggle');
            var backdrop = document.getElementById('sbBackdrop');
            if (toggle && shell) toggle.addEventListener('click', function () { shell.classList.toggle('nav-open'); });
            if (backdrop && shell) backdrop.addEventListener('click', function () { shell.classList.remove('nav-open'); });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)

<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:1100">
    @if (TempData["Success"] != null)
    {
        <div class="toast align-items-center text-bg-success border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body fw-semibold">@TempData["Success"]</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast align-items-center text-bg-danger border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body fw-semibold">@TempData["Error"]</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    }
</div>
<script>
    document.querySelectorAll('.toast').forEach(function (el) {
        new bootstrap.Toast(el, { delay: 5000 }).show();
    });
</script>
</body>
</html>
