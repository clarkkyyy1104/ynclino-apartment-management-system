<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Apartment Management System</title>
    <link rel="stylesheet" href="~/css/ynclino.css" asp-append-version="true" />
</head>
<body>
@{
    var activeController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    // marks the current page semantically: style it with a[aria-current="page"]
    string? Active(string c) => activeController == c ? "page" : null;
    bool isAdmin = User.IsInRole("Admin");
    // three roles now, so "not admin" no longer means "tenant" — name each one
    bool isStaff = User.IsInRole("Maintenance");
    bool isTenant = User.IsInRole("Tenant");
    bool unitsOpen = activeController == "Units" || activeController == "Transfers";
    var activeAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool billingOpen = activeController == "Billing";
}
@if (User.Identity?.IsAuthenticated == true)
{
    <div>
        <aside id="appSidebar">
            <a asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.png" alt="Ynclino Apartment Management System" />
            </a>
            <nav>
                @* No count here: it would only re-total the per-module badges below. *@
                <a aria-current="@Active("Home")" asp-controller="Home" asp-action="Index">Dashboard</a>

                @if (isAdmin)
                {
                    <a data-collapse="#unitsGroup" href="#unitsGroup" role="button" aria-expanded="@(unitsOpen ? "true" : "false")">
                        Units @await Component.InvokeAsync("NavAlert", new { module = "Transfer" }) <span>▾</span>
                    </a>
                    <div id="unitsGroup" hidden="@(unitsOpen ? null : "hidden")">
                        <div>
                            <a aria-current="@Active("Units")" asp-controller="Units" asp-action="Index">Units</a>
                            <a aria-current="@Active("Transfers")" asp-controller="Transfers" asp-action="Index">
                                Unit Requests @await Component.InvokeAsync("NavAlert", new { module = "Transfer" })
                            </a>
                        </div>
                    </div>
                }
                else if (isTenant)
                {
                    @* tenant: a single Units link (browse); My Unit / Transfer lives in their Profile *@
                    <a aria-current="@Active("Units")" asp-controller="Units" asp-action="Index">Units</a>
                }

                @if (isAdmin)
                {
                    <a aria-current="@Active("Users")" asp-controller="Users" asp-action="Index">User Management</a>
                    <a aria-current="@Active("Tenants")" asp-controller="Tenants" asp-action="Index">Tenants</a>
                }

                @* maintenance staff only ever see their own module — no billing,
                   no tenants, no units, no lost &amp; found *@
                @if (!isStaff)
                {
                    <a data-collapse="#billingGroup" href="#billingGroup" role="button" aria-expanded="@(billingOpen ? "true" : "false")">
                        Billing &amp; Payment @await Component.InvokeAsync("NavAlert", new { module = "Billing" }) <span>▾</span>
                    </a>
                    <div id="billingGroup" hidden="@(billingOpen ? null : "hidden")">
                        <div>
                            <a aria-current="@(activeController == "Billing" && activeAction != "History" ? "page" : null)" asp-controller="Billing" asp-action="Index">Bills</a>
                            <a aria-current="@(activeController == "Billing" && activeAction == "History" ? "page" : null)" asp-controller="Billing" asp-action="History">Payment History</a>
                        </div>
                    </div>
                }

                <a aria-current="@Active("Maintenance")" asp-controller="Maintenance" asp-action="Index">Maintenance @await Component.InvokeAsync("NavAlert", new { module = "Maintenance" })</a>

                @if (!isStaff)
                {
                    <a aria-current="@Active("LostFound")" asp-controller="LostFound" asp-action="Index">Lost &amp; Found @await Component.InvokeAsync("NavAlert", new { module = "LostFound" })</a>
                }
                @* Reports & Records is for the admin (a tenant lands on their own
                   records); maintenance staff have no business in it at all *@
                @if (!isStaff)
                {
                    <a aria-current="@Active("Reports")" asp-controller="Reports" asp-action="Index">Reports &amp; Records</a>
                }
            </nav>
        </aside>

        <div>
            <header>
                <button type="button" onclick="document.getElementById('appSidebar').toggleAttribute('data-open')">☰</button>
                <div>
                    <a href="#" role="button" data-dropdown aria-expanded="false" aria-controls="accountMenu">
                        @User.Identity.Name <span>(@(isAdmin ? "Admin" : isStaff ? "Maintenance Staff" : "Tenant"))</span>
                    </a>
                    <ul id="accountMenu" hidden>
                        @if (!isStaff)
                        {
                            <li>
                                <a asp-controller="Profile" asp-action="Index">
                                    My Profile @if (isTenant) { @await Component.InvokeAsync("NavAlert", new { module = "Transfer" }) }
                                </a>
                            </li>
                        }
                        <li><a asp-controller="Account" asp-action="ChangePassword">Change Password</a></li>
                        <li><hr></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit">Sign Out</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </header>

            <main>
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <div>
        @RenderBody()
    </div>
}

    <script src="~/js/ynclino.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

@* flash messages: data-flash is the hook, ynclino.js removes them after 5s *@
@if (TempData["Success"] != null)
{
    <p data-flash="success" role="status">
        @TempData["Success"]
        <button type="button" data-dismiss aria-label="Dismiss">&times;</button>
    </p>
}
@if (TempData["Error"] != null)
{
    <p data-flash="error" role="alert">
        @TempData["Error"]
        <button type="button" data-dismiss aria-label="Dismiss">&times;</button>
    </p>
}
</body>
</html>
