@model string
<button type="button" class="password-toggle" data-password-target="@Model"
        data-show-icon="@Url.Content("~/images/icons/eye.svg")"
        data-hide-icon="@Url.Content("~/images/icons/eye-slash.svg")"
        aria-controls="@Model" aria-label="Show password" aria-pressed="false">
    <img src="@Url.Content("~/images/icons/eye.svg")" alt="" aria-hidden="true" />
</button>
