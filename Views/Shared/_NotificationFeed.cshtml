@model IEnumerable<YnclinoApartmentManagementSystem.Models.SystemNotification>
@*
    The dashboard feed, shared by all three dashboards so the admin, the tenant
    and the maintenance staff see exactly the same thing.

    There is no notifications table any more, so nothing here is "read" or
    "unread" and there is nothing to mark off. SystemNotificationService works
    each line out from the records, so a line disappears when the work behind it
    is done — the bill is settled, the request is closed.

    Usage:  <partial name="_NotificationFeed" model="Model.Notifications" />
*@
@{
    var notes = (Model ?? Enumerable.Empty<YnclinoApartmentManagementSystem.Models.SystemNotification>()).ToList();

    // the records say "LostFound" and "Transfer"; people read something friendlier
    string NoteLabel(string module) => module switch
    {
        "LostFound" => "Lost & Found",
        "Transfer"  => "Unit Request",
        _           => module
    };
}

<div data-panel>
    <div data-panel-head>
        <span>Needs attention</span>
    </div>

    @if (notes.Count == 0)
    {
        <div data-panel-body data-empty>
            <p>Nothing is waiting on you right now.</p>
            <p>Unpaid bills, open requests and pending approvals will show up here on their own.</p>
        </div>
    }
    else
    {
        <div data-panel-body>
            @foreach (var n in notes)
            {
                <a data-note data-unread="true" href="@(n.Link ?? "#")">
                    <div>
                        <span data-module>@NoteLabel(n.Module)</span>
                        <span data-message>@n.Message</span>
                    </div>
                </a>
            }
        </div>
    }
</div>
