@model IEnumerable<YnclinoApartmentManagementSystem.Models.tblNotification>
@*
    The unread-notification feed, shared by all three dashboards so the admin,
    the tenant and the maintenance staff see exactly the same thing.

    Only UNREAD notifications are passed in. Opening one marks it read, so it
    disappears from here on the next page load.

    Usage:  <partial name="_NotificationFeed" model="Model.Unread" />
*@
@{
    var unread = (Model ?? new List<YnclinoApartmentManagementSystem.Models.tblNotification>()).ToList();


    // the database stores "LostFound"; people read "Lost & Found"
    string NoteLabel(string module) => module switch
    {
        "LostFound" => "Lost & Found",
        "Transfer"  => "Unit Request",
        _           => module
    };
}

<div data-panel>
    <div data-panel-head>
        <span>Notifications</span>
        <a asp-controller="Notifications" asp-action="index">
            <span>Show All</span>
        </a>
        @if (unread.Count > 0)
        {
            <form asp-controller="Notifications" asp-action="MarkAllRead" method="post">
                @Html.AntiForgeryToken()
                <button type="submit">Mark all as read</button>
            </form>
        }
    </div>

    @if (unread.Count == 0)
    {
        <div data-panel-body data-empty>
            <p>You're all caught up.</p>
            <p>New requests, payments and updates will show up here.</p>
        </div>
    }
    else
    {
        <div data-panel-body>
            @foreach (var n in unread)
            {
                @* the same row shape as the Notifications page, so a feed entry and
                   a list entry read identically wherever the reader meets them *@
                <a data-note data-unread="true" href="/Notifications/Open/@n.NotificationID">
                    <div>
                        <span data-module>@NoteLabel(n.Module)</span>
                        <span data-message>@n.Message</span>
                    </div>
                    <div data-meta>
                        <span>@n.CreatedAt.ToString("MMM dd, h:mm tt")</span>
                    </div>
                </a>
            }
        </div>
        <div>
            <a asp-controller="Notifications" asp-action="Index">See all notifications</a>
        </div>
    }
</div>
