@model IEnumerable<YnclinoApartmentManagementSystem.Models.tblNotification>
@if (Model != null && Model.Any())
{
    <div class="card border-danger mb-3">
        <div class="card-body py-2">
            <div class="fw-semibold small text-danger mb-1">
                Unread notification@(Model.Count() > 1 ? "s" : "") — click one to mark it read
            </div>
            <div class="list-group list-group-flush">
                @foreach (var n in Model)
                {
                    <a href="/Notifications/Open/@n.NotificationID"
                       class="list-group-item list-group-item-action list-group-item-light px-2 py-1 d-flex justify-content-between align-items-center">
                        <span class="fw-bold small">@n.Message</span>
                        <span class="text-muted small text-nowrap ms-3">@n.CreatedAt.ToString("MMM dd, h:mm tt")</span>
                    </a>
                }
            </div>
        </div>
    </div>
}
