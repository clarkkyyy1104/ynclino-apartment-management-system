@model IEnumerable<YnclinoApartmentManagementSystem.Models.tblNotification>
@if (Model != null && Model.Any())
{
    int unread = Model.Count(n => !n.IsRead);
    <div class="card mb-3 @(unread > 0 ? "border-danger" : "")">
        <div class="card-body py-2">
            <div class="fw-semibold small mb-1 @(unread > 0 ? "text-danger" : "text-muted")">
                Notifications@(unread > 0 ? $" — {unread} unread, click one to mark it read" : "")
            </div>
            <div class="list-group list-group-flush">
                @foreach (var n in Model)
                {
                    <a href="/Notifications/Open/@n.NotificationID"
                       class="list-group-item list-group-item-action px-2 py-1 d-flex justify-content-between align-items-center @(n.IsRead ? "" : "list-group-item-light")">
                        <span class="small @(n.IsRead ? "text-muted fw-normal" : "fw-bold text-dark")">@n.Message</span>
                        <span class="text-muted small text-nowrap ms-3">@n.CreatedAt.ToString("MMM dd, h:mm tt")</span>
                    </a>
                }
            </div>
        </div>
    </div>
}
