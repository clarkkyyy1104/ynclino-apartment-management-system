@model IEnumerable<YnclinoApartmentManagementSystem.Models.tblNotification>
@if (Model != null && Model.Any())
{
    <div data-panel data-module-alert>
        <div>
            <div data-panel-head>
                @Model.Count() unread notification@(Model.Count() > 1 ? "s" : "") — click to open and mark as read
            </div>
            <div data-panel-body data-list>
                @foreach (var n in Model)
                {
                    <a data-note data-unread="true" href="/Notifications/Open/@n.NotificationID">
                        <span data-message>@n.Message</span>
                        <div data-meta><span>@n.CreatedAt.ToString("MMM dd, h:mm tt")</span></div>
                    </a>
                }
            </div>
        </div>
    </div>
}
