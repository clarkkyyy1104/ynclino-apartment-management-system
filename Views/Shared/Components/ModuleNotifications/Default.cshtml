@model IEnumerable<YnclinoApartmentManagementSystem.Models.tblNotification>
@if (Model != null && Model.Any())
{
    <div>
        <div>
            <div>
                @Model.Count() unread notification@(Model.Count() > 1 ? "s" : "") — click to open and mark as read
            </div>
            <div>
                @foreach (var n in Model)
                {
                    <a href="/Notifications/Open/@n.NotificationID">
                        <span>@n.Message</span>
                        <span>@n.CreatedAt.ToString("MMM dd, h:mm tt")</span>
                    </a>
                }
            </div>
        </div>
    </div>
}
