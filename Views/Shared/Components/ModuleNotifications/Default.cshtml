@model IEnumerable<YnclinoApartmentManagementSystem.Models.SystemNotification>
@if (Model != null && Model.Any())
{
    <div data-panel data-module-alert>
        <div>
            <div data-panel-head>Needs your attention</div>
            <div data-panel-body data-list>
                @foreach (var n in Model)
                {
                    @* nothing to mark as read — the line goes away when the work is done *@
                    @if (string.IsNullOrEmpty(n.Link))
                    {
                        <div data-note data-unread="true">
                            <span data-message>@n.Message</span>
                        </div>
                    }
                    else
                    {
                        <a data-note data-unread="true" href="@n.Link">
                            <span data-message>@n.Message</span>
                        </a>
                    }
                }
            </div>
        </div>
    </div>
}
