@model YnclinoApartmentManagementSystem.Models.ViewModels.StaffDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div>
    <h4>Welcome, @Model.StaffName</h4>
    <p>These are the maintenance requests assigned to you.</p>
</div>

<div data-stats>
    <div>
        <div data-stat>
            <div>
                <div>Urgent</div>
                <div>@Model.UrgentCount</div>
            </div>
            <div></div>
        </div>
    </div>
    <div>
        <div data-stat>
            <div>
                <div>Pending</div>
                <div>@Model.PendingCount</div>
            </div>
            <div></div>
        </div>
    </div>
    <div>
        <div data-stat>
            <div>
                <div>In Progress</div>
                <div>@Model.InProgressCount</div>
            </div>
            <div></div>
        </div>
    </div>
    <div>
        <div data-stat>
            <div>
                <div>Resolved</div>
                <div>@Model.ResolvedCount</div>
            </div>
            <div></div>
        </div>
    </div>
</div>

@* the same unread feed the admin and tenant dashboards show *@
<div>
    <partial name="_NotificationFeed" model="(List<YnclinoApartmentManagementSystem.Models.tblNotification>)ViewBag.Unread" />
</div>