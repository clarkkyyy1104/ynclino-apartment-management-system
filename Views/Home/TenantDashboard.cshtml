@model YnclinoApartmentManagementSystem.Models.ViewModels.TenantDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div>
    <div>
        <h4>Welcome, @(Model.Tenant?.FullName ?? User.Identity?.Name)</h4>
        <p>
            @if (Model.TotalUnread > 0)
            {
                <text>You have <strong>@Model.TotalUnread</strong> unread notification@(Model.TotalUnread > 1 ? "s" : "").</text>
            }
            else
            {
                <text>Nothing needs your attention right now.</text>
            }
        </p>
    </div>
</div>

<div>

    @* ── Main column: the notification feed ── *@
    <div>
        <partial name="_NotificationFeed" model="Model.Unread" />
    </div>
</div>