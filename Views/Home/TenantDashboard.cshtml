@model YnclinoApartmentManagementSystem.Models.ViewModels.TenantDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";

    // one place to describe every module, so the strip below is a simple loop
    var modules = new[]
    {
        new { Name = "Billing",     Label = "Billing & Payment", Count = Model.BillingCount,     Controller = "Billing",     Colour = "primary" },
        new { Name = "Maintenance", Label = "Maintenance",       Count = Model.MaintenanceCount, Controller = "Maintenance", Colour = "warning" },
        new { Name = "LostFound",   Label = "Lost & Found",      Count = Model.LostFoundCount,   Controller = "LostFound",   Colour = "info"    },
        new { Name = "Transfer",    Label = "Unit Request",      Count = Model.TransferCount,    Controller = "Transfers",   Colour = "success" }
    };
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
    <div>
        <h4 class="fw-semibold mb-0">Welcome, @(Model.Tenant?.FullName ?? User.Identity?.Name)</h4>
        <p class="text-muted small mb-0">
            @if (Model.TotalUnread > 0)
            {
                <text>You have <strong class="text-danger">@Model.TotalUnread</strong> unread notification@(Model.TotalUnread > 1 ? "s" : "").</text>
            }
            else
            {
                <text>Nothing needs your attention right now.</text>
            }
        </p>
    </div>
</div>

@* ── Indicator strip: one small card per module, showing its unread count ── *@
<div class="row g-3 mb-4">
    @foreach (var m in modules)
    {
        <div class="col-6 col-lg-3">
            <a asp-controller="@m.Controller" asp-action="Index"
               class="card border-0 shadow-sm h-100 text-decoration-none text-reset hover-lift">
                <div class="card-body py-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small">@m.Label</div>
                        <div class="fs-4 fw-semibold @(m.Count > 0 ? "text-danger" : "text-secondary")">@m.Count</div>
                    </div>
                    @if (m.Count > 0)
                    {
                        <span class="badge rounded-pill bg-danger">new</span>
                    }
                </div>
                <div class="bg-@m.Colour" style="height:3px"></div>
            </a>
        </div>
    }
</div>

<div class="row g-3">

    @* ── Main column: the notification feed ── *@
    <div class="col-lg-8">
        <partial name="_NotificationFeed" model="Model.Unread" />
    </div>

    @* ── Side column: a compact tenancy summary so the page is never empty ── *@
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-2"><span class="fw-semibold small">My Tenancy</span></div>
            <div class="card-body">
                @if (Model.Tenant == null)
                {
                    <p class="small text-muted mb-0">
                        No tenant profile is linked to your account yet. Please contact the administrator.
                    </p>
                }
                else
                {
                    <dl class="row mb-0 info-list">
                        <dt class="col-6">Unit</dt>
                        <dd class="col-6 fw-semibold">@(Model.Tenant.Unit?.UnitNumber ?? "—")</dd>

                        <dt class="col-6">Monthly Rent</dt>
                        <dd class="col-6">&#x20B1;@((Model.Tenant.Unit?.RentPrice ?? 0m).ToString("N0"))</dd>

                        <dt class="col-6">Outstanding</dt>
                        <dd class="col-6 @(Model.Outstanding > 0 ? "text-danger fw-semibold" : "")">
                            &#x20B1;@Model.Outstanding.ToString("N0")
                        </dd>

                        <dt class="col-6">Advance Payment</dt>
                        <dd class="col-6">&#x20B1;@Model.AdvanceCredit.ToString("N0")</dd>

                        <dt class="col-6">Occupied Since</dt>
                        <dd class="col-6">@Model.Tenant.DateRecorded.ToString("MMM dd, yyyy")</dd>
                    </dl>
                }
            </div>
        </div>
    </div>

</div>