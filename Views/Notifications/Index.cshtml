@model IEnumerable<YnclinoApartmentManagementSystem.Models.tblNotification>
@{
    ViewData["Title"] = "Notifications";
    int unread = Model.Count(n => !n.IsRead);
}

<div data-page-head>
    <div><h3>Notifications @if (unread > 0) { <span>@unread</span> }</h3></div>
    <div data-actions>
        @if (unread > 0)
        {
            <form asp-action="MarkAllRead" method="post">
                @Html.AntiForgeryToken()
                <button data-primary type="submit">Mark all as read</button>
            </form>
        }
    </div>
</div>

@if (!Model.Any())
{
    <div><div>You have no notifications.</div></div>
}
else
{
    <div>
        @foreach (var n in Model)
        {
            <a asp-action="Open" asp-route-id="@n.NotificationID">
                <div>
                    <div>
                        <span>@n.Module</span>
                        @n.Message
                    </div>
                    <div>
                        @if (!n.IsRead) { <span>new</span> }
                        @n.CreatedAt.ToString("MMM dd, h:mm tt")
                    </div>
                </div>
            </a>
        }
    </div>
}
