@model YnclinoApartmentManagementSystem.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<dialog data-modal data-kind="form" id="mandatoryPasswordDialog" aria-labelledby="mandatoryPasswordTitle" open>
    <div data-modal-panel>
        <div data-modal-head>
            <span id="mandatoryPasswordTitle">For Your Own Security, Change Your Password</span>
        </div>
        <div data-modal-body>
            <div data-form-panel>
                <div data-form-body data-cols="1">
                <form asp-action="MandatoryPassChange" method="post" id="cpwForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly"></div>

                    <div>
                        <label asp-for="NewPassword"></label>
                        <div class="pw-wrap">
                            <input asp-for="NewPassword" id="pw" autocomplete="new-password" oninput="checkStrength(this.value)" />
                            @await Html.PartialAsync("_PasswordToggle", "pw")
                        </div>
                        <span asp-validation-for="NewPassword"></span>
                    </div>

                    <ul id="pwRules">
                        <li id="r-len"><span></span> At least 8 characters</li>
                        <li id="r-upper"><span></span> At least one uppercase letter</li>
                        <li id="r-lower"><span></span> At least one lowercase letter</li>
                        <li id="r-digit"><span></span> At least one number</li>
                        <li id="r-special"><span></span> At least one special character (!&#64;#$%^&amp;*)</li>
                    </ul>

                    <div>
                        <label asp-for="ConfirmPassword"></label>
                        <div class="pw-wrap">
                            <input asp-for="ConfirmPassword" id="cpw" autocomplete="new-password" />
                            @await Html.PartialAsync("_PasswordToggle", "cpw")
                        </div>
                        <span asp-validation-for="ConfirmPassword"></span>
                    </div>

                </form>

                @* Two separate forms end this page — changing the password and
                   giving up on it — so the buttons are gathered into one row
                   rather than stacking as two orange blocks. The first stays
                   tied to the password form by name. Signing out is the way
                   back, not the thing to do, so it is the quiet one. *@
                <div data-actions-row>
                    <button type="submit" form="cpwForm" data-primary>Update Password</button>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit">Sign out instead</button>
                    </form>
                </div>
                </div>
            </div>
        </div>
    </div>
</dialog>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/password.js" asp-append-version="true"></script>
    <script>
        var mandatoryDialog = document.getElementById('mandatoryPasswordDialog');
        mandatoryDialog.addEventListener('cancel', function (e) { e.preventDefault(); });
        mandatoryDialog.close();
        mandatoryDialog.showModal();

        var pwInput = document.getElementById('pw');
        pwInput.addEventListener('input', function () {
            var rules = document.getElementById('pwRules');
            rules.style.display = this.value.length > 0 ? '' : 'none';
        });

        document.getElementById('cpwForm').addEventListener('submit', function (e) {
            var pw = pwInput.value;
            if (pw.length > 0 && !meetsAllRules(pw)) {
                e.preventDefault();
                document.getElementById('pwRules').style.display = '';
                document.getElementById('pwRules').classList.add('shake');
                setTimeout(() => document.getElementById('pwRules').classList.remove('shake'), 600);
            }
        });
    </script>
}
