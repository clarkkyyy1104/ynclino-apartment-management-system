@model YnclinoApartmentManagementSystem.Models.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — Apartment Management System</title>
    <link rel="stylesheet" href="~/css/ynclino.css" asp-append-version="true" />
</head>
<body>
    <div>
        <div>
            <img src="~/images/logo.png" alt="Ynclino Apartment Management System" />
            <p>Please sign in to your account</p>
        </div>

        <div>
            <div>
                <form asp-action="Login" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div>
                            <div asp-validation-summary="All"></div>
                        </div>
                    }

                    <div>
                        <label asp-for="Username"></label>
                        <input asp-for="Username" placeholder="Username" autofocus autocomplete="username" />
                    </div>

                    <div>
                        <label asp-for="Password"></label>
                        <div class="pw-wrap">
                            <input asp-for="Password" id="loginPassword"
                                placeholder="Password" autocomplete="current-password" />
                            @await Html.PartialAsync("_PasswordToggle", "loginPassword")
                        </div>
                    </div>
                    <button type="submit">Login</button>

                </form>

            </div>
        </div>
    </div>

    <script src="~/js/password.js" asp-append-version="true"></script>
    <script src="~/js/ynclino.js" asp-append-version="true"></script>
</body>
</html>
