@model YnclinoApartmentManagementSystem.Models.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — Apartment Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
</head>
<body class="bg-body-tertiary">
    <div class="container" style="max-width:420px;">
        <div class="mt-5 mb-4 text-center">
            <h4 class="fw-semibold mb-0">Apartment Management System</h4>
            <p class="text-muted small mb-0">Choose a role to continue</p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="d-grid gap-2">
                    <form asp-action="QuickLogin" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="role" value="Admin" />
                        <button type="submit" class="btn btn-primary w-100 py-2">Login as Admin</button>
                    </form>
                    <form asp-action="QuickLogin" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="role" value="Tenant" />
                        <button type="submit" class="btn btn-outline-primary w-100 py-2">Login as Tenant</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
