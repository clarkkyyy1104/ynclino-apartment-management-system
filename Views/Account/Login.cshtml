@model YnclinoApartmentManagementSystem.Models.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — Ynclino Apartment Management System</title>
    <link rel="icon" type="image/svg+xml" href="~/images/ynclino-favicon.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <style>
        :root {
            --ynk-orange:    #ff8235;
            --ynk-orange-dk: #e5701f;
            --ynk-dark:      #3b3c3e;   /* login page charcoal (per Figma) */
            --ynk-cream:     #ecebe4;   /* logo off-white for text */
            --ynk-line:      rgba(255,255,255,.35);
        }
        body {
            background-color: var(--ynk-dark);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: var(--ynk-cream);
        }
        .login-wrap { width: 100%; max-width: 560px; padding: 24px; }

        .brand-logo {
            display: block;
            margin: 0 auto 6px;
            width: 100%;
            max-width: 430px;
            height: auto;
        }
        .brand-sub {
            text-align: center;
            font-family: Georgia, 'Times New Roman', serif;
            letter-spacing: 3px;
            color: var(--ynk-cream);
            font-size: 1.05rem;
            margin-bottom: 26px;
        }

        .login-card {
            border: 1px solid var(--ynk-line);
            border-radius: 12px;
            padding: 40px 44px 44px;
            background: transparent;
        }
        .login-title {
            text-align: center;
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 1.5rem;
            color: var(--ynk-cream);
            margin-bottom: 28px;
        }

        .login-card .form-control {
            background: transparent;
            border: 1px solid var(--ynk-line);
            color: var(--ynk-cream);
            padding: .8rem 1rem;
            border-radius: 8px;
            font-size: 1.02rem;
        }
        .login-card .form-control::placeholder { color: rgba(236,235,228,.7); }
        .login-card .form-control:focus {
            background: transparent;
            color: var(--ynk-cream);
            border-color: var(--ynk-orange);
            box-shadow: 0 0 0 .2rem rgba(255,130,53,.25);
        }

        .forgot-link { color: var(--ynk-orange); font-size: .9rem; text-decoration: none; }
        .forgot-link:hover { color: var(--ynk-orange-dk); text-decoration: underline; }

        .btn-signin {
            background: var(--ynk-orange);
            border: none;
            color: #2b2c2e;
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 1.25rem;
            padding: .7rem;
            border-radius: 8px;
            font-weight: 600;
        }
        .btn-signin:hover { background: var(--ynk-orange-dk); color: #2b2c2e; }

        .pw-wrapper { position: relative; }
        .pw-toggle {
            position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
            background: none; border: none; padding: 2px 4px; color: rgba(236,235,228,.75);
            cursor: pointer; line-height: 1;
        }
        .pw-toggle:hover { color: var(--ynk-cream); }
    </style>
</head>
<body>
    <div class="login-wrap">
        <img class="brand-logo" src="~/images/ynclino-logo-text-light.svg" alt="Ynclino" />
        <div class="brand-sub">APARTMENT MANAGEMENT SYSTEM</div>

        <div class="login-card">
            <div class="login-title">Please sign in to your account</div>
            <form asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 small mb-3">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <div class="mb-3">
                    <input asp-for="Username" class="form-control" placeholder="Username" autofocus autocomplete="username" />
                </div>

                <div class="mb-1">
                    <div class="pw-wrapper">
                        <input asp-for="Password" id="loginPassword" class="form-control pe-5" placeholder="Password" autocomplete="current-password" />
                        <button type="button" class="pw-toggle" onclick="togglePassword('loginPassword', this)" tabindex="-1" aria-label="Show/hide password">
                            <svg id="loginPassword-eye" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                                <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                            </svg>
                            <svg id="loginPassword-eye-slash" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" style="display:none">
                                <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7 7 0 0 0-2.79.588l.77.771A6 6 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755q-.247.248-.517.486z"/>
                                <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829z"/>
                                <path d="M3.35 5.47q-.27.24-.518.487A13 13 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7 7 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709z"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="text-end mb-4">
                    <a href="#" class="forgot-link">Forgot Password?</a>
                </div>

                <button type="submit" class="btn btn-signin w-100">Sign In</button>
            </form>
        </div>
    </div>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        function togglePassword(inputId, btn) {
            var input = document.getElementById(inputId);
            var eye = document.getElementById(inputId + '-eye');
            var slash = document.getElementById(inputId + '-eye-slash');
            if (input.type === 'password') {
                input.type = 'text'; eye.style.display = 'none'; slash.style.display = '';
            } else {
                input.type = 'password'; eye.style.display = ''; slash.style.display = 'none';
            }
        }
    </script>
</body>
</html>
