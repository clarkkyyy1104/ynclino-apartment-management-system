@model YnclinoApartmentManagementSystem.Models.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — Ynclino Apartment Management System</title>
    <link rel="icon" type="image/svg+xml" href="~/images/ynclino-logo-dark.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <style>
        :root { --ynk-blue:#1b4c9e; --ynk-dark:#37383a; --ynk-orange:#ff8235; --ynk-orange-dk:#e5701f; }
        body {
            background-color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .login-wrap { width: 100%; max-width: 470px; padding: 20px; }
        .brand-lockup {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-bottom: 4px;
        }
        .brand-lockup svg { width: 92px; height: 92px; }
        .brand-lockup img { width: 84px; height: 84px; }
        .brand-word {
            font-family: Georgia, 'Times New Roman', serif;
            font-weight: 700;
            font-size: 3.6rem;
            line-height: 1;
            color: var(--ynk-dark);
            letter-spacing: 1px;
        }
        .brand-sub {
            text-align: center;
            font-family: Georgia, 'Times New Roman', serif;
            letter-spacing: 2px;
            color: #1b1b1b;
            font-size: .96rem;
            margin-bottom: 18px;
        }
        .login-card {
            border: 1px solid #e3e7ee;
            border-top: 6px solid var(--ynk-orange);
            border-radius: 6px;
            box-shadow: 0 6px 24px rgba(16,32,60,.10);
            overflow: hidden;
            background: #fff;
        }
        .login-band {
            background: #e7eaf0;
            text-align: center;
            padding: 26px 20px;
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 1.15rem;
            color: #1b1b1b;
        }
        .login-body { padding: 30px 34px 34px; }
        .login-body .form-control { padding: .7rem .9rem; }
        .btn-signin {
            background: var(--ynk-orange);
            border-color: var(--ynk-orange);
            color: #fff;
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 1.15rem;
            padding: .6rem;
            border-radius: 6px;
        }
        .btn-signin:hover { background: var(--ynk-orange-dk); border-color: var(--ynk-orange-dk); color: #fff; }
        .forgot-link { color: var(--ynk-orange-dk); font-size: .85rem; text-decoration: none; }
        .forgot-link:hover { text-decoration: underline; }
        .pw-wrapper { position: relative; }
        .pw-toggle {
            position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
            background: none; border: none; padding: 2px 4px; color: #6c757d;
            cursor: pointer; line-height: 1;
        }
        .pw-toggle:hover { color: #343a40; }
    </style>
</head>
<body>
    <div class="login-wrap">
        <div class="brand-lockup">
            <img src="~/images/ynclino-logo-dark.svg" alt="Ynclino logo" />
            <span class="brand-word">NCLINO</span>
        </div>
        <div class="brand-sub">APARTMENT MANAGEMENT SYSTEM</div>

        <div class="login-card">
            <div class="login-band">Please sign in to your account</div>
            <div class="login-body">
                <form asp-action="Login" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2 small mb-3">
                            <div asp-validation-summary="All"></div>
                        </div>
                    }

                    <div class="mb-3">
                        <input asp-for="Username" class="form-control" placeholder="Username" autofocus autocomplete="username" />
                    </div>

                    <div class="mb-1">
                        <div class="pw-wrapper">
                            <input asp-for="Password" id="loginPassword" class="form-control pe-5" placeholder="Password" autocomplete="current-password" />
                            <button type="button" class="pw-toggle" onclick="togglePassword('loginPassword', this)" tabindex="-1" aria-label="Show/hide password">
                                <svg id="loginPassword-eye" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                                    <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                                </svg>
                                <svg id="loginPassword-eye-slash" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" style="display:none">
                                    <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7 7 0 0 0-2.79.588l.77.771A6 6 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755q-.247.248-.517.486z"/>
                                    <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829z"/>
                                    <path d="M3.35 5.47q-.27.24-.518.487A13 13 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7 7 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709z"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="text-end mb-4">
                        <a href="#" class="forgot-link">Forgot Password?</a>
                    </div>

                    <button type="submit" class="btn btn-signin w-100">Sign In</button>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        function togglePassword(inputId, btn) {
            var input = document.getElementById(inputId);
            var eye = document.getElementById(inputId + '-eye');
            var slash = document.getElementById(inputId + '-eye-slash');
            if (input.type === 'password') {
                input.type = 'text'; eye.style.display = 'none'; slash.style.display = '';
            } else {
                input.type = 'password'; eye.style.display = ''; slash.style.display = 'none';
            }
        }
    </script>
</body>
</html>
