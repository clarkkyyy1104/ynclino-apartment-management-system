@{
    Layout = null;
    ViewData["Title"] = "Forgot Password";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password — Apartment Management System</title>
    <link rel="stylesheet" href="~/css/ynclino.css" asp-append-version="true" />
</head>
<body>
    <div>
        <div>
            <img src="~/images/logo.png" alt="Ynclino Apartment Management System" />
            <p>Forgot your password?</p>
        </div>

        <div>
            <div>
                <p>
                    Passwords are reset by the administrator in person. There is no
                    automatic reset by email, because the system does not send email.
                </p>

                <h5>How to have your password reset</h5>
                <ol>
                    <li>Go to the apartment office during office hours, Monday to Saturday.</li>
                    <li>Bring a valid ID so the administrator can confirm who you are.</li>
                    <li>
                        The administrator issues you a temporary password. It is generated by
                        the system and shown once.
                    </li>
                    <li>
                        Sign in with it. You are taken straight to the change-password page and
                        cannot use anything else until you set a password of your own.
                    </li>
                </ol>

                <p>
                    Your username does not change. It is the code on your tenant record,
                    for example <strong>25-07AA</strong>.
                </p>

                <a asp-action="Login" data-back>Back to sign in</a>
            </div>
        </div>
    </div>
</body>
</html>
